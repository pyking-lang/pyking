## A new Array of the elements in the other order; `a` is as it was.
##
## # Parameters
## - `a`: an array.
##
## # Returns
## A new Array.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array([1, 2, 3])
## print(array.reversed(a), a)
## ```
## ```stdout
## array([3, 2, 1]) array([1, 2, 3])
## ```
public def reversed(a: Array(t)) -> Array(t):
    array(list.reverse(list(a)))


## Sorts in place, `before(x, y)` saying `x` goes before `y`; equal ones
## keep their order (one merge sort, the same on every target).
##
## # Parameters
## - `before`: whether its first argument goes first.
## - `a`: an array to sort.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["ccc", "a", "bb"])
## array.sort_by(lam (x, y). len(x) < len(y), a)
## print(a)
## ```
## ```stdout
## array(["a", "bb", "ccc"])
## ```
public def sort_by(before: (t, t) -> Bool, a: Array(t)) -> ():
    merge_sort(a, before)


## Sorts in place by each element's Int key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Int an element is sorted by.
## - `a`: an array to sort.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["ccc", "a", "bb"])
## array.sort_on(lam s. len(s), a)
## print(a)
## ```
## ```stdout
## array(["a", "bb", "ccc"])
## ```
public def int::sort_on(key: (t) -> Int, a: Array(t)) -> ():
    in_order = array(list.sort_on(key, list(a)))
    for i in range(len(in_order)):
        a[i] := in_order[i]


## Sorts in place by each element's Float key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Float an element is sorted by.
## - `a`: an array to sort.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array([1.0, 3.0])
## array.sort_on(lam x. 0.0 - x, a)
## print(a)
## ```
## ```stdout
## array([3.0, 1.0])
## ```
public def float::sort_on(key: (t) -> Float, a: Array(t)) -> ():
    in_order = array(list.sort_on(key, list(a)))
    for i in range(len(in_order)):
        a[i] := in_order[i]


## Sorts in place by each element's String key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the String an element is sorted by.
## - `a`: an array to sort.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array([(2, "b"), (1, "a")])
## array.sort_on(lam p. let (_, s) = p in s, a)
## print(a)
## ```
## ```stdout
## array([(1, "a"), (2, "b")])
## ```
public def string::sort_on(key: (t) -> String, a: Array(t)) -> ():
    in_order = array(list.sort_on(key, list(a)))
    for i in range(len(in_order)):
        a[i] := in_order[i]


## Sorts in place by each element's Char key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Char an element is sorted by.
## - `a`: an array to sort.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["b1", "a2"])
## array.sort_on(lam s. s[0], a)
## print(a)
## ```
## ```stdout
## array(["a2", "b1"])
## ```
public def char::sort_on(key: (t) -> Char, a: Array(t)) -> ():
    in_order = array(list.sort_on(key, list(a)))
    for i in range(len(in_order)):
        a[i] := in_order[i]


## Replaces each element `x` by `f(x)`, in place, in index order: `fmap`
## without a copy.
##
## # Parameters
## - `f`: makes the new element from the old.
## - `a`: an array.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array([1, 2, 3])
## array.map_in_place(lam x. x * x, a)
## print(a)
## ```
## ```stdout
## array([1, 4, 9])
## ```
public def map_in_place(f: (t) -> t, a: Array(t)) -> ():
    for i in range(len(a)):
        a[i] := f(a[i])


## The elements of two Arrays in pairs, as long as the shorter one.
##
## # Parameters
## - `a`: the first Array.
## - `other`: the second.
##
## # Returns
## A new Array of pairs.
##
## # Examples
## ```pyking
## use mutation
## import array
## print(array.zip(array([1, 2]), array(["a", "b", "c"])))
## ```
## ```stdout
## array([(1, "a"), (2, "b")])
## ```
public def zip(a: Array(t), other: Array(u)) -> Array((t, u)):
    array(list.zip(list(a), list(other)))


## Each element with its index.
##
## # Parameters
## - `a`: an array.
##
## # Returns
## A new Array of (index, element) pairs.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["a", "b"])
## print(array.enumerate(a))
## ```
## ```stdout
## array([(0, "a"), (1, "b")])
## ```
public def enumerate(a: Array(t)) -> Array((Int, t)):
    array(list.enumerate(list(a)))


## The lists `f` makes of each element, joined.
##
## # Parameters
## - `f`: makes a list of one element.
## - `a`: an array.
##
## # Returns
## A new Array.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array([1, 2])
## print(array.flat_map(lam x. [x, x], a))
## ```
## ```stdout
## array([1, 1, 2, 2])
## ```
public def flat_map(f: (t) -> [u], a: Array(t)) -> Array(u):
    array(list.flat_map(f, list(a)))


## Whether two Arrays are as long and alike element by element, by `alike`.
##
## # Parameters
## - `alike`: whether two elements count as the same.
## - `a`: one Array.
## - `other`: the other.
##
## # Returns
## `true` where they are.
##
## # Examples
## ```pyking
## use mutation
## import array
## print(array.equal_by(lam (x, y). x % 2 == y % 2, array([1, 2]), array([3, 4])))
## ```
## ```stdout
## true
## ```
public def equal_by(alike: (t, t) -> Bool, a: Array(t), other: Array(t)) -> Bool:
    equal_with(a, other, alike)
