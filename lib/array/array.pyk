## The greatest element, `before(x, y)` saying `x` is smaller; the first of
## several equal ones.
##
## # Parameters
## - `before`: whether its first argument is smaller.
## - `a`: an array.
##
## # Returns
## `Some` of it, or `None`.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["ab", "c"])
## print(array.maximum_by(lam (x, y). len(x) < len(y), a))
## ```
## ```stdout
## Some("ab")
## ```
public def maximum_by(before: (t, t) -> Bool, a: Array(t)) -> Option(t):
    list.maximum_by(before, list(a))


## The smallest element, `before(x, y)` saying `x` is smaller; the first of
## several equal ones.
##
## # Parameters
## - `before`: whether its first argument is smaller.
## - `a`: an array.
##
## # Returns
## `Some` of it, or `None`.
##
## # Examples
## ```pyking
## use mutation
## import array
## a = array(["ab", "c"])
## print(array.minimum_by(lam (x, y). len(x) < len(y), a))
## ```
## ```stdout
## Some("c")
## ```
public def minimum_by(before: (t, t) -> Bool, a: Array(t)) -> Option(t):
    list.minimum_by(before, list(a))


