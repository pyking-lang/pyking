## A new DynArray of the elements in the other order; `v` is as it was.
##
## # Parameters
## - `v`: a DynArray.
##
## # Returns
## A new DynArray.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## print(dynarray.reversed(v), v)
## ```
## ```stdout
## dynarray([3, 2, 1]) dynarray([1, 2, 3])
## ```
public def reversed(v: DynArray(t)) -> DynArray(t):
    dynarray(list.reverse(list(v)))


## Sorts in place, `before(x, y)` saying `x` goes before `y`; equal ones
## keep their order (one merge sort, the same on every target).
##
## # Parameters
## - `before`: whether its first argument goes first.
## - `v`: a DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(["ccc", "a", "bb"])
## dynarray.sort_by(lam (x, y). len(x) < len(y), v)
## print(v)
## ```
## ```stdout
## dynarray(["a", "bb", "ccc"])
## ```
public def sort_by(before: (t, t) -> Bool, v: DynArray(t)) -> ():
    a = to_array(v)
    array.sort_by(before, a)
    write_back(v, a)


## Sorts in place by each element's Int key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Int an element is sorted by.
## - `v`: a DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(["ccc", "a", "bb"])
## dynarray.sort_on(lam s. len(s), v)
## print(v)
## ```
## ```stdout
## dynarray(["a", "bb", "ccc"])
## ```
public def int::sort_on(key: (t) -> Int, v: DynArray(t)) -> ():
    in_order = array(list.sort_on(key, list(v)))
    for i in range(len(in_order)):
        v[i] := in_order[i]


## Sorts in place by each element's Float key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Float an element is sorted by.
## - `v`: a DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1.0, 3.0])
## dynarray.sort_on(lam x. 0.0 - x, v)
## print(v)
## ```
## ```stdout
## dynarray([3.0, 1.0])
## ```
public def float::sort_on(key: (t) -> Float, v: DynArray(t)) -> ():
    in_order = array(list.sort_on(key, list(v)))
    for i in range(len(in_order)):
        v[i] := in_order[i]


## Sorts in place by each element's String key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the String an element is sorted by.
## - `v`: a DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([(2, "b"), (1, "a")])
## dynarray.sort_on(lam p. let (_, s) = p in s, v)
## print(v)
## ```
## ```stdout
## dynarray([(1, "a"), (2, "b")])
## ```
public def string::sort_on(key: (t) -> String, v: DynArray(t)) -> ():
    in_order = array(list.sort_on(key, list(v)))
    for i in range(len(in_order)):
        v[i] := in_order[i]


## Sorts in place by each element's Char key, `key` called once per element;
## equal keys keep their order.
##
## # Parameters
## - `key`: the Char an element is sorted by.
## - `v`: a DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(["b1", "a2"])
## dynarray.sort_on(lam s. s[0], v)
## print(v)
## ```
## ```stdout
## dynarray(["a2", "b1"])
## ```
public def char::sort_on(key: (t) -> Char, v: DynArray(t)) -> ():
    in_order = array(list.sort_on(key, list(v)))
    for i in range(len(in_order)):
        v[i] := in_order[i]


## Replaces each element `x` by `f(x)`, in place, in index order: `fmap`
## without a copy.
##
## # Parameters
## - `f`: makes the new element from the old.
## - `v`: a DynArray.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## dynarray.map_in_place(lam x. x * x, v)
## print(v)
## ```
## ```stdout
## dynarray([1, 4, 9])
## ```
public def map_in_place(f: (t) -> t, v: DynArray(t)) -> ():
    for i in range(len(v)):
        v[i] := f(v[i])


## The elements of two DynArrays in pairs, as long as the shorter one.
##
## # Parameters
## - `v`: the first DynArray.
## - `other`: the second.
##
## # Returns
## A new DynArray of pairs.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.zip(dynarray([1, 2]), dynarray(["a", "b", "c"])))
## ```
## ```stdout
## dynarray([(1, "a"), (2, "b")])
## ```
public def zip(v: DynArray(t), other: DynArray(u)) -> DynArray((t, u)):
    dynarray(list.zip(list(v), list(other)))


## Each element with its index.
##
## # Parameters
## - `v`: a DynArray.
##
## # Returns
## A new DynArray of (index, element) pairs.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(["a", "b"])
## print(dynarray.enumerate(v))
## ```
## ```stdout
## dynarray([(0, "a"), (1, "b")])
## ```
public def enumerate(v: DynArray(t)) -> DynArray((Int, t)):
    dynarray(list.enumerate(list(v)))


## The lists `f` makes of each element, joined.
##
## # Parameters
## - `f`: makes a list of one element.
## - `v`: a DynArray.
##
## # Returns
## A new DynArray.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2])
## print(dynarray.flat_map(lam x. [x, x], v))
## ```
## ```stdout
## dynarray([1, 1, 2, 2])
## ```
public def flat_map(f: (t) -> [u], v: DynArray(t)) -> DynArray(u):
    dynarray(list.flat_map(f, list(v)))


## Whether two DynArrays are as long and alike element by element, by `alike`.
##
## # Parameters
## - `alike`: whether two elements count as the same.
## - `v`: one DynArray.
## - `other`: the other.
##
## # Returns
## `true` where they are.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal_by(lam (x, y). x % 2 == y % 2, dynarray([1, 2]), dynarray([3, 4])))
## ```
## ```stdout
## true
## ```
public def equal_by(alike: (t, t) -> Bool, v: DynArray(t), other: DynArray(t)) -> Bool:
    equal_with(v, other, alike)


## Takes elements off the end until at most `n` are left (Rust's
## `truncate`).
##
## # Parameters
## - `v`: the DynArray.
## - `n`: how many to keep.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## dynarray.truncate(v, 1)
## print(v)
## ```
## ```stdout
## dynarray([1])
## ```
public def truncate(v: DynArray(t), n: Int) -> ():
    if n < 0:
        panic("dynarray.truncate needs a length of 0 or more, and this one is " + string(n))
    while len(v) > n:
        pop(v)


## Keeps only the elements `p` is true of, in place and in order: `filter`
## without a copy (Rust's `retain`).
##
## # Parameters
## - `p`: the test.
## - `v`: the DynArray.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3, 4])
## dynarray.retain(lam x. x % 2 == 0, v)
## print(v)
## ```
## ```stdout
## dynarray([2, 4])
## ```
public def retain(p: (t) -> Bool, v: DynArray(t)) -> ():
    kept = [x for x in v if p(x)]
    clear(v)
    for x in kept:
        push(v, x)


## Pushes every element of `w` onto `v`, in order; `w` is as it was, and
## `append(v, v)` doubles `v`.
##
## # Parameters
## - `v`: the DynArray that grows.
## - `w`: what is pushed.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2])
## dynarray.append(v, v)
## print(v)
## ```
## ```stdout
## dynarray([1, 2, 1, 2])
## ```
public def append(v: DynArray(t), w: DynArray(t)) -> ():
    for x in list(w):
        push(v, x)
