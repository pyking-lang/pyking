## DynArrays: copying, joining, comparing, reversing and sorting them.
##
## A DynArray is made by the builtin `dynarray()` or `dynarray(xs)`, read with `v[i]`
## and written with `v[i] := x`, and grown and shrunk by the builtins
## `push`, `pop`, `insert`, `remove` and `clear`; `len(v)` and
## `same(v, w)` are builtins too (PYKING.md, "DynArrays"). This module is the
## rest. `copy`, `to_list` and `to_array` make a **new** value and copy
## **shallowly**; `extend`, `reverse` and `sort` change the DynArray they are
## given, which everyone holding it sees. `push` and `pop` take constant
## time on average, `insert` and `remove` time in proportion to the
## elements they move, and sorting `n log n`.
#
# Written in Pyking alone, over the builtins and lib/array, so every
# target runs the same code: `sort` is lib/array's merge sort, on a copy
# written back.

use mutation
import array
import list


## A new DynArray holding the same elements as `v`, in the same order.
##
## # Parameters
## - `v`: the DynArray to copy.
##
## # Returns
## A new DynArray of `len(v)` elements; changing one does not change the other.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2])
## w = dynarray.copy(v)
## push(w, 3)
## print(v, w)
## ```
## ```stdout
## dynarray([1, 2]) dynarray([1, 2, 3])
## ```
public def copy(v: DynArray(t)) -> DynArray(t):
    out = dynarray()
    for x in v:
        push(out, x)
    out


## The elements of `v` as they are now, as a list.
##
## # Parameters
## - `v`: the DynArray.
##
## # Returns
## A list of `len(v)` elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([3, 4])
## push(v, 5)
## print(dynarray.to_list(v))
## ```
## ```stdout
## [3, 4, 5]
## ```
public def to_list(v: DynArray(t)) -> [t]:
    [x for x in v]


## The elements of `v` as they are now, as a new array.
##
## # Parameters
## - `v`: the DynArray.
##
## # Returns
## A new array of `len(v)` elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.to_array(dynarray(["a", "b"])))
## ```
## ```stdout
## array(["a", "b"])
## ```
public def to_array(v: DynArray(t)) -> Array(t):
    array_init(len(v), lam i. v[i])


## A new DynArray holding the elements of an array.
##
## # Parameters
## - `a`: the array.
##
## # Returns
## A new DynArray of `len(a)` elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray.from_array(array([1, 2]))
## push(v, 3)
## print(v)
## ```
## ```stdout
## dynarray([1, 2, 3])
## ```
public def from_array(a: Array(t)) -> DynArray(t):
    out = dynarray()
    for x in a:
        push(out, x)
    out


## Adds every element of a list to the end of `v`, in order.
##
## # Parameters
## - `v`: the DynArray to grow.
## - `xs`: what to add.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1])
## dynarray.extend(v, [2, 3])
## print(v)
## ```
## ```stdout
## dynarray([1, 2, 3])
## ```
public def extend(v: DynArray(t), xs: [t]) -> ():
    for x in xs:
        push(v, x)


## Puts the elements of `v` in the opposite order, in place.
##
## # Parameters
## - `v`: the DynArray to reverse.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## dynarray.reverse(v)
## print(v)
## ```
## ```stdout
## dynarray([3, 2, 1])
## ```
public def reverse(v: DynArray(t)) -> ():
    var i = 0
    var j = len(v) - 1
    while i < j:
        held = v[i]
        v[i] := v[j]
        v[j] := held
        i += 1
        j -= 1


# Writes the elements of `a` over those of `v`, which has as many.
def write_back(v: DynArray(t), a: Array(t)) -> ():
    for i in range(len(a)):
        v[i] := a[i]


# Whether two DynArrays have the same length and, position by position,
# elements `alike` says are the same.
def equal_with(v: DynArray(t), w: DynArray(t), alike: (t, t) -> Bool) -> Bool:
    var same_so_far = len(v) == len(w)
    var k = 0
    while same_so_far and k < len(v):
        same_so_far := alike(v[k], w[k])
        k += 1
    same_so_far


## Whether two DynArrays of Ints hold the same elements in the same order.
## `same(v, w)` asks instead whether they are one DynArray.
##
## # Parameters
## - `v`: one DynArray.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal(dynarray([1, 2]), dynarray([1, 2])), dynarray.equal(dynarray([1]), dynarray([2])))
## ```
## ```stdout
## true false
## ```
public def int::equal(v: DynArray(Int), w: DynArray(Int)) -> Bool:
    equal_with(v, w, lam (x, y). x == y)


## Whether two DynArrays of Floats hold the same elements in the same order,
## compared with `==` -- so a DynArray holding NaN equals no DynArray.
##
## # Parameters
## - `v`: one DynArray.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal(dynarray([0.5]), dynarray([0.5])))
## ```
## ```stdout
## true
## ```
public def float::equal(v: DynArray(Float), w: DynArray(Float)) -> Bool:
    equal_with(v, w, lam (x, y). x == y)


## Whether two DynArrays of Strings hold the same elements in the same order.
##
## # Parameters
## - `v`: one DynArray.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal(dynarray(["a"]), dynarray(["a"])))
## ```
## ```stdout
## true
## ```
public def string::equal(v: DynArray(String), w: DynArray(String)) -> Bool:
    equal_with(v, w, lam (x, y). x == y)


## Whether two DynArrays of Chars hold the same elements in the same order.
##
## # Parameters
## - `v`: one DynArray.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal(dynarray(['a']), dynarray(['b'])))
## ```
## ```stdout
## false
## ```
public def char::equal(v: DynArray(Char), w: DynArray(Char)) -> Bool:
    equal_with(v, w, lam (x, y). x == y)


## Whether two DynArrays of Bools hold the same elements in the same order.
##
## # Parameters
## - `v`: one DynArray.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## print(dynarray.equal(dynarray([true]), dynarray([true])))
## ```
## ```stdout
## true
## ```
public def bool::equal(v: DynArray(Bool), w: DynArray(Bool)) -> Bool:
    equal_with(v, w, lam (x, y). x == y)


## Sorts a DynArray of Ints from smallest to largest, in place, stably.
##
## # Parameters
## - `v`: the DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([3, 1, 2])
## dynarray.sort(v)
## print(v)
## ```
## ```stdout
## dynarray([1, 2, 3])
## ```
public def int::sort(v: DynArray(Int)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a DynArray of Floats in place, as `array.sort` orders them: `-inf`
## first, `-0.0` and `0.0` as equal, then `inf`, and every NaN last.
##
## # Parameters
## - `v`: the DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([2.5, -1.0])
## dynarray.sort(v)
## print(v)
## ```
## ```stdout
## dynarray([-1.0, 2.5])
## ```
public def float::sort(v: DynArray(Float)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a DynArray of Strings in place, by code point.
##
## # Parameters
## - `v`: the DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(["pear", "Fig", "apple"])
## dynarray.sort(v)
## print(v)
## ```
## ```stdout
## dynarray(["Fig", "apple", "pear"])
## ```
public def string::sort(v: DynArray(String)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a DynArray of Chars by code point, in place.
##
## # Parameters
## - `v`: the DynArray to sort.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray(['c', 'a', 'b'])
## dynarray.sort(v)
## print(v)
## ```
## ```stdout
## dynarray(['a', 'b', 'c'])
## ```
public def char::sort(v: DynArray(Char)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


# --- what lib/list has too ---


## The first element of a DynArray, where there is one.
##
## # Parameters
## - `v`: a DynArray.
##
## # Returns
## `Some` of it, or `None` where there are no elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([4, 5])
## print(dynarray.first(v))
## ```
## ```stdout
## Some(4)
## ```
public def first(v: DynArray(t)) -> Option(t):
    list.first(list(v))


## The last element of a DynArray, where there is one.
##
## # Parameters
## - `v`: a DynArray.
##
## # Returns
## `Some` of it, or `None` where there are no elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([4, 5])
## print(dynarray.last(v))
## ```
## ```stdout
## Some(5)
## ```
public def last(v: DynArray(t)) -> Option(t):
    list.last(list(v))


## Element `i`, where there is one: `v[i]` that does not fail.
##
## # Parameters
## - `v`: a DynArray.
## - `i`: the index.
##
## # Returns
## `Some` of it, or `None` where `i` is outside.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([4, 5])
## print(dynarray.nth(v, 1), dynarray.nth(v, 2))
## ```
## ```stdout
## Some(5) None
## ```
public def nth(v: DynArray(t), i: Int) -> Option(t):
    if i < 0 or i >= len(v) then None else Some(v[i])


## Whether a DynArray has no elements.
##
## # Parameters
## - `v`: a DynArray.
##
## # Returns
## `true` where it has none.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([0])
## print(dynarray.is_empty(v))
## ```
## ```stdout
## false
## ```
public def is_empty(v: DynArray(t)) -> Bool:
    len(v) == 0


## The first element `p` is true of.
##
## # Parameters
## - `p`: the test.
## - `v`: a DynArray.
##
## # Returns
## `Some` of it, or `None`.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## print(dynarray.find(lam x. x > 1, v))
## ```
## ```stdout
## Some(2)
## ```
public def find(p: (t) -> Bool, v: DynArray(t)) -> Option(t):
    list.find(p, list(v))


## The index of the first element `p` is true of.
##
## # Parameters
## - `p`: the test.
## - `v`: a DynArray.
##
## # Returns
## `Some` of the index, or `None`.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3])
## print(dynarray.find_index(lam x. x > 1, v))
## ```
## ```stdout
## Some(1)
## ```
public def find_index(p: (t) -> Bool, v: DynArray(t)) -> Option(Int):
    list.find_index(p, list(v))


## How many elements `p` is true of.
##
## # Parameters
## - `p`: the test.
## - `v`: a DynArray.
##
## # Returns
## The count.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([1, 2, 3, 4])
## print(dynarray.count(lam x. x % 2 == 0, v))
## ```
## ```stdout
## 2
## ```
public def count(p: (t) -> Bool, v: DynArray(t)) -> Int:
    list.count(p, list(v))


## The elements gathered by `f` from the first, with no starting value.
##
## # Parameters
## - `f`: combines what is gathered with the next element.
## - `v`: a DynArray.
##
## # Returns
## `Some` of the result, or `None` where there are no elements.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([2, 3, 4])
## print(dynarray.reduce(lam (x, y). x * y, v))
## ```
## ```stdout
## Some(24)
## ```
public def reduce(f: (t, t) -> t, v: DynArray(t)) -> Option(t):
    list.reduce(f, list(v))


## Whether some element is alike to `x`, by `alike`.
##
## # Parameters
## - `alike`: whether two elements count as the same.
## - `x`: what to look for.
## - `v`: a DynArray.
##
## # Returns
## `true` where one is.
##
## # Examples
## ```pyking
## use mutation
## import dynarray
## v = dynarray([10, 21])
## print(dynarray.contains_by(lam (p, q). p % 10 == q % 10, 1, v))
## ```
## ```stdout
## true
## ```
public def contains_by(alike: (t, t) -> Bool, x: t, v: DynArray(t)) -> Bool:
    list.contains_by(alike, x, list(v))


## Whether `x` is an element of a DynArray of Ints.
