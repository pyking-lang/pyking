# Standard input and standard output, as the host provides them.
#
# This is the external half of the module `io`; `io.pyk` beside it is
# the other half, written in Pyking against what is declared here. The
# two files are one module (docs/modules.md, "A module in two halves").
#
# Every type here is a String, a Bool or unit, so the boundary carries
# all of it on every target. `print` writes to the same standard output
# `write` and `write_line` do, so the two interleave in the order they
# ran.
#
# A line is read without its line ending. At the end of the input a
# line is the empty string, which is also what an empty line reads as;
# `is_eof` is what tells the two apart. Every read writes out whatever
# has been written so far first, so a prompt is on screen before the
# program waits for an answer.

## Writes `text` to standard output exactly as it is, with no newline
## after it. Use it to build a line from several pieces, and `write_line`
## or `print` to end it.
##
## # Parameters
## - `text`: the characters to write.
##
## # Examples
## ```pyking
## import io
## io.write("one, ")
## io.write("two")
## io.write_line(".")
## ```
## ```stdout
## one, two.
## ```
public def write(text: String) -> ()

## Writes `text` to standard output, then a newline. Unlike `print`, it
## takes exactly one string and writes it as it is.
##
## # Parameters
## - `text`: the line to write, without its newline.
##
## # Examples
## ```pyking
## import io
## io.write_line("first line")
## io.write_line("second line")
## ```
## ```stdout
## first line
## second line
## ```
public def write_line(text: String) -> ()

## Reads everything left on standard input, from where the last read
## stopped to the end, line endings included.
##
## # Returns
## The rest of the input, or `""` when nothing is left.
##
## # Examples
## ```pyking stdin = "one\ntwo\n"
## import io
## rest = io.read()
## print(rest == "one\ntwo\n")
## ```
## ```stdout
## true
## ```
public def read() -> String

## Tells whether standard input has been read to the end. `read_line`
## answers `""` both for an empty line and at the end of the input, and
## this is how a program tells the two apart.
##
## # Returns
## `true` when nothing is left to read, `false` otherwise.
##
## # Examples
## ```pyking stdin = "only line\n"
## import io
## print(io.is_eof())
## print(io.read_line())
## print(io.is_eof())
## ```
## ```stdout
## false
## only line
## true
## ```
public def is_eof() -> Bool

# The host's half of `read_line`: write the prompt, then read one line.
# Private, because `read_line` in io.pyk is what a program calls -- its
# prompt has a default, which a declaration cannot carry.
def prompt_line(prompt: String) -> String
