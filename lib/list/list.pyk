## Whether two lists are as long and alike element by element, by `alike`.
##
## # Parameters
## - `alike`: whether two elements count as the same.
## - `xs`: the first list.
## - `ys`: the second.
##
## # Returns
## `true` where they are.
##
## # Examples
## ```pyking
## import list
## print(list.equal_by(lam (a, b). a % 2 == b % 2, [1, 2], [3, 4]))
## ```
## ```stdout
## true
## ```
public def equal_by(alike: (a, a) -> Bool, xs: [a], ys: [a]) -> Bool:
    if len(xs) != len(ys) then false else all(lam p. let (x, y) = p in alike(x, y), zip(xs, ys))


# How many elements from the start `p` is true of: where `take_while`
# stops.
def prefix_length(p: (a) -> Bool, xs: [a]) -> Int:
    var n = 0
    for x in xs:
        if not p(x):
            return n
        n += 1
    n


# Sorts a[low..high) in place, stably, with `before(x, y)` saying x goes
# strictly before y: lib/array's merge sort, so a list sorts as an array
# does, with the same comparisons on every target.
def sort_range(a: Array(t), buffer: Array(t), low: Int, high: Int, before: (t, t) -> Bool) -> ():
    if high - low > 1:
        middle = (low + high) / 2
        sort_range(a, buffer, low, middle, before)
        sort_range(a, buffer, middle, high, before)
        var i = low
        var j = middle
        var k = low
        while k < high:
            # Equal elements keep their order: the left one goes first.
            if j >= high or (i < middle and not before(a[j], a[i])):
                buffer[k] := a[i]
                i += 1
            else:
                buffer[k] := a[j]
                j += 1
            k += 1
        k := low
        while k < high:
            a[k] := buffer[k]
            k += 1


def merge_sort(a: Array(t), before: (t, t) -> Bool) -> ():
    if len(a) > 1:
        sort_range(a, array(a), 0, len(a), before)


# Floats in a total order: -inf first, -0.0 and 0.0 equal, inf, and every
# NaN last, equal to each other.
def float_before(x: Float, y: Float) -> Bool:
    if x != x:
        false
    else if y != y:
        true
    else:
        x < y


# Strings by code point, a String before every longer one it starts.
def string_before(x: String, y: String) -> Bool:
    var answer = len(x) < len(y)
    var decided = false
    var k = 0
    while not decided and k < len(x) and k < len(y):
        if x[k] != y[k]:
            answer := x[k] < y[k]
            decided := true
        k += 1
    answer
