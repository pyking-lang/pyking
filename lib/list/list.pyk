## The list cut into runs of elements next to each other that are alike, by
## `alike` (Haskell's `groupBy`).
##
## # Parameters
## - `alike`: whether two neighbours belong to one run.
## - `xs`: the list.
##
## # Returns
## A list of the runs, in order.
##
## # Examples
## ```pyking
## import list
## print(list.group_by(lam (a, b). a < b, [1, 2, 3, 2, 5]))
## ```
## ```stdout
## [[1, 2, 3], [2, 5]]
## ```
public def group_by(alike: (a, a) -> Bool, xs: [a]) -> [[a]]:
    out = dynarray()
    run = dynarray()
    for x in xs:
        if len(run) > 0 and not alike(run[len(run) - 1], x):
            push(out, list(run))
            clear(run)
        push(run, x)
    if len(run) > 0:
        push(out, list(run))
    list(out)


