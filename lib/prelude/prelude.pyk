## xs = [1, 2, 3]
## print(all(lam x. x > 0, xs), all(lam x. x > 1, xs))
## ```
## ```stdout
## true false
## ```
public def list::all(p: (a) -> Bool, xs: [a]) -> Bool:
    for x in xs:
        if not p(x):
            return false
    true


