## ```
## ```stdout
## 123
## ```
public def slice::foldl(f: (b, a) -> b, init: b, xs: Slice(a)) -> b:
    var acc = init
    for x in xs:
        acc := f(acc, x)
    acc


## `foldl(f, init, m)` on a Map: `f(...f(f(init, x1), x2)..., xn)`, the
## values from the first.
##
## # Parameters
## - `f`: takes what is gathered so far and the next element.
## - `init`: what is gathered before any element.
## - `m`: a Map.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## m = map([("a", 1), ("b", 2), ("c", 3)])
## print(foldl(lam (acc, x). acc * 10 + x, 0, m))
## ```
## ```stdout
## 123
## ```
public def map::foldl(f: (b, a) -> b, init: b, m: Map(k, a)) -> b:
    var acc = init
    for x in values(m):
        acc := f(acc, x)
    acc


## `foldl(f, init, m)` on a MutMap: `f(...f(f(init, x1), x2)..., xn)`, the
## values from the first.
##
## # Parameters
## - `f`: takes what is gathered so far and the next element.
## - `init`: what is gathered before any element.
## - `m`: a MutMap.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## use mutation
## m = mutmap([("a", 1), ("b", 2), ("c", 3)])
## print(foldl(lam (acc, x). acc * 10 + x, 0, m))
## ```
## ```stdout
## 123
## ```
public def mutmap::foldl(f: (b, a) -> b, init: b, m: MutMap(k, a)) -> b:
    var acc = init
    for x in values(m):
        acc := f(acc, x)
    acc


## `foldl(f, init, o)` on an Option: `f(...f(f(init, x1), x2)..., xn)`, the
## value it holds, if any from the first.
##
## # Parameters
## - `f`: takes what is gathered so far and the next element.
## - `init`: what is gathered before any element.
## - `o`: an Option.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## o = Some(3)
## none: Option(Int) = None
## print(foldl(lam (acc, x). acc * 10 + x, 0, o), foldl(lam (acc, x). acc * 10 + x, 0, none))
## ```
## ```stdout
## 3 0
## ```
public def option::foldl(f: (b, a) -> b, init: b, o: Option(a)) -> b:
    match o:
        case Some(v):
            f(init, v)
        case None:
            init


## `foldl(f, init, r)` on a Result: `f(...f(f(init, x1), x2)..., xn)`, the
## value it holds, if any from the first.
##
## # Parameters
## - `f`: takes what is gathered so far and the next element.
## - `init`: what is gathered before any element.
## - `r`: a Result.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## r: Result(Int, String) = Ok(3)
## bad: Result(Int, String) = Error("no")
## print(foldl(lam (acc, x). acc * 10 + x, 0, r), foldl(lam (acc, x). acc * 10 + x, 0, bad))
## ```
## ```stdout
## 3 0
## ```
public def result::foldl(f: (b, a) -> b, init: b, r: Result(a, e)) -> b:
    match r:
        case Ok(v):
            f(init, v)
        case Error(_):
            init


## `foldr(f, init, xs)` on a list: `f(x1, f(x2, ...f(xn, init)))`, the
## elements from the last.
##
## # Parameters
## - `f`: takes the next element, from the end, and what is gathered so far.
## - `init`: what is gathered before any element.
## - `xs`: a list.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## xs = [1, 2, 3]
## print(foldr(lam (x, acc). acc * 10 + x, 0, xs))
## ```
## ```stdout
## 321
## ```
public def list::foldr(f: (a, b) -> b, init: b, xs: [a]) -> b:
    fold_back(f, init, array(xs))


## `foldr(f, init, xs)` on an array: `f(x1, f(x2, ...f(xn, init)))`, the
## elements from the last.
##
## # Parameters
## - `f`: takes the next element, from the end, and what is gathered so far.
## - `init`: what is gathered before any element.
## - `xs`: an array.
##
## # Returns
## What `f` gathered, or `init` where there are no elements.
##
## # Examples
## ```pyking
## use mutation
## xs = array([1, 2, 3])
## print(foldr(lam (x, acc). acc * 10 + x, 0, xs))
## ```
## ```stdout
## 321
## ```
public def array::foldr(f: (a, b) -> b, init: b, xs: Array(a)) -> b:
    fold_back(f, init, xs)


