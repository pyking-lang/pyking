## `list(n, v)`: `n` copies of `v` (Haskell's `replicate`). A negative `n` is
## a runtime error.
##
## # Parameters
## - `n`: how many.
## - `v`: the value, worked out once.
##
## # Returns
## A list of `n` elements.
##
## # Examples
## ```pyking
## print(list(3, 'a'), list(0, 1))
## ```
## ```stdout
## ['a', 'a', 'a'] []
## ```
public def fill::list(n: Int, v: a) -> [a]:
    if n < 0:
        panic("a list's size is never negative, and this one is " + string(n))
    [v for _ in range(n)]


## `list_init(n, f)`: element `i` is `f(i)`, called in index order (OCaml's
## `List.init`). A negative `n` is a runtime error.
##
## # Parameters
## - `n`: how many.
## - `f`: makes element `i`.
##
## # Returns
## A list of `n` elements.
##
## # Examples
## ```pyking
## print(list_init(5, lam i. i * i))
## ```
## ```stdout
## [0, 1, 4, 9, 16]
## ```
public def init::list_init(n: Int, f: (Int) -> a) -> [a]:
    if n < 0:
        panic("a list's size is never negative, and this one is " + string(n))
    [f(i) for i in range(n)]


## `list_init(n, seed, f)`: `n` elements unfolded from `seed`, `f` answering
## each element and the next seed. A negative `n` is a runtime error.
##
## # Parameters
## - `n`: how many.
## - `seed`: what the first element is made from.
## - `f`: answers an element and the next seed.
##
## # Returns
## A list of `n` elements.
##
## # Examples
## ```pyking
## print(list_init(8, (0, 1), lam p. let (a, b) = p in (a, (b, a + b))))
## ```
## ```stdout
## [0, 1, 1, 2, 3, 5, 8, 13]
## ```
public def unfold::list_init(n: Int, seed: s, f: (s) -> (a, s)) -> [a]:
    if n < 0:
        panic("a list's size is never negative, and this one is " + string(n))
    out = dynarray()
    var state = seed
    for _ in range(n):
        (x, following) = f(state)
        push(out, x)
        state := following
    list(out)


## `dynarray(n, v)`: a DynArray of `n` copies of `v`. Needs `use mutation`.
## A negative `n` is a runtime error.
##
## # Parameters
## - `n`: how many.
## - `v`: the value, worked out once.
##
## # Returns
## A new DynArray of `n` elements.
##
## # Examples
## ```pyking
## use mutation
## v = dynarray(2, 0)
## push(v, 7)
## print(v)
## ```
## ```stdout
## dynarray([0, 0, 7])
## ```
public def fill::dynarray(n: Int, v: a) -> DynArray(a):
    if n < 0:
        panic("a DynArray's size is never negative, and this one is " + string(n))
    dynarray([v for _ in range(n)])


## `dynarray_init(n, f)`: element `i` is `f(i)`, as `array_init`. Needs `use
## mutation`. A negative `n` is a runtime error.
##
## # Parameters
## - `n`: how many.
## - `f`: makes element `i`.
##
## # Returns
## A new DynArray of `n` elements.
##
## # Examples
## ```pyking
## use mutation
## print(dynarray_init(4, lam i. i * 2))
## ```
## ```stdout
## dynarray([0, 2, 4, 6])
## ```
public def init::dynarray_init(n: Int, f: (Int) -> a) -> DynArray(a):
    if n < 0:
        panic("a DynArray's size is never negative, and this one is " + string(n))
    dynarray([f(i) for i in range(n)])


## `dynarray_init(n, seed, f)`: `n` elements unfolded from `seed`, as
## `array_init`'s unfolding form. Needs `use mutation`.
##
## # Parameters
## - `n`: how many.
## - `seed`: what the first element is made from.
## - `f`: answers an element and the next seed.
##
## # Returns
## A new DynArray of `n` elements.
##
## # Examples
## ```pyking
## use mutation
## print(dynarray_init(4, 1, lam x. (x, x * 3)))
## ```
## ```stdout
## dynarray([1, 3, 9, 27])
## ```
public def unfold::dynarray_init(n: Int, seed: s, f: (s) -> (a, s)) -> DynArray(a):
    dynarray(list_init(n, seed, f))


## `map_init(keys, f)`: each key `k` maps to `f(k)`, in the order of `keys`;
## a key written twice keeps its first place (Haskell's `Map.fromSet`).
##
## # Parameters
## - `keys`: the keys.
## - `f`: makes a key's value.
##
## # Returns
## A new Map.
##
## # Examples
## ```pyking
## print(map_init(["ann", "bo"], lam name. len(name)))
## ```
## ```stdout
## map([("ann", 3), ("bo", 2)])
## ```
public def keys::map_init(keys: [k], f: (k) -> v) -> Map(k, v):
    map([(key, f(key)) for key in keys])


## `map_init(n, seed, f)`: `n` (key, value) entries unfolded from `seed`, a
## later one with a key already there replacing its value.
##
## # Parameters
## - `n`: how many entries to unfold.
## - `seed`: what the first is made from.
## - `f`: answers an entry and the next seed.
##
## # Returns
## A new Map.
##
## # Examples
## ```pyking
## print(map_init(3, 1, lam x. ((x, x * x), x + 1)))
## ```
## ```stdout
## map([(1, 1), (2, 4), (3, 9)])
## ```
public def unfold::map_init(n: Int, seed: s, f: (s) -> ((k, v), s)) -> Map(k, v):
    map(list_init(n, seed, f))


## `mutmap_init(keys, f)`: as `map_init`, a MutMap. Needs `use mutation`.
##
## # Parameters
## - `keys`: the keys.
## - `f`: makes a key's value.
##
## # Returns
## A new MutMap.
##
## # Examples
## ```pyking
## use mutation
## counts = mutmap_init(["a", "b"], lam _. 0)
## counts["a"] += 1
## print(counts)
## ```
## ```stdout
## mutmap([("a", 1), ("b", 0)])
## ```
public def keys::mutmap_init(keys: [k], f: (k) -> v) -> MutMap(k, v):
    mutmap([(key, f(key)) for key in keys])


## `mutmap_init(n, seed, f)`: as `map_init`'s unfolding form, a MutMap. Needs
## `use mutation`.
##
## # Parameters
## - `n`: how many entries to unfold.
## - `seed`: what the first is made from.
## - `f`: answers an entry and the next seed.
##
## # Returns
## A new MutMap.
##
## # Examples
## ```pyking
## use mutation
## print(mutmap_init(2, 0, lam x. ((x, string(x)), x + 1)))
## ```
## ```stdout
## mutmap([(0, "0"), (1, "1")])
## ```
public def unfold::mutmap_init(n: Int, seed: s, f: (s) -> ((k, v), s)) -> MutMap(k, v):
    mutmap(list_init(n, seed, f))


# The elements of `xs` from the last, gathered by `f`: the one walk every
# `foldr` makes, over an array of the elements.
def fold_back(f: (a, b) -> b, init: b, xs: Array(a)) -> b:
    var acc = init
    var i = len(xs) - 1
    while i >= 0:
        acc := f(xs[i], acc)
        i -= 1
    acc
