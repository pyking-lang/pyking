## Dates and times: reading the clock, and rendering an instant.
##
## An instant is a whole number of seconds since 1970-01-01 00:00:00,
## and every date and time is in UTC on every host.
#
# The Pyking half of `time`. What the host provides is declared in
# time_external.pyk beside this file and is in scope here unqualified --
# the two files are one module -- so `year_of` below is the host's, and
# it is private to this library.
#
# The rendering is written here rather than per target, so every host
# that compiles this library prints a date the same way. That is the
# whole reason the module has two halves: the external one reaches the
# host's clock and calendar, and everything a reader sees is decided
# here.
#
# All of it is UTC (see time_external.pyk).
#
# `format` recognises the six field tokens below and a fixed set of
# separators. It cannot pass an arbitrary character through, because
# Pyking has no way to read one character out of a string -- a text
# pattern matches a known prefix, not an unknown one -- so a character
# `format` does not know ends the output there. See docs/libraries.md.


## The ISO 8601 format, e.g. `2026-10-04T12:30:00Z`.
public ISO8601: String = "yyyy-MM-ddTHH:mm:ssZ"

## A date alone, e.g. `2026-10-04`.
public DATE: String = "yyyy-MM-dd"

## A time of day alone, e.g. `12:30:00`.
public TIME: String = "HH:mm:ss"

## A date and a time separated by a space, e.g. `2026-10-04 12:30:00`.
public DATETIME: String = "yyyy-MM-dd HH:mm:ss"

## A date and a time with no separators, e.g. `20261004123000`.
public COMPACT: String = "yyyyMMddHHmmss"


# One digit as text. `string` would do it, but the JavaScript backends have
# no `string` yet, and a library that cannot be compiled everywhere its
# types allow is worth less than ten lines of match.
def digit(n:Int) -> String:
    match n:
        case 0:
            return "0"
        case 1:
            return "1"
        case 2:
            return "2"
        case 3:
            return "3"
        case 4:
            return "4"
        case 5:
            return "5"
        case 6:
            return "6"
        case 7:
            return "7"
        case 8:
            return "8"
        case 9:
            return "9"
        case _:
            return "?"


# Two digits, zero-padded: 0..99.
def pad2(n:Int) -> String:
    return digit(n / 10) ++ digit(n - n / 10 * 10)


# Four digits, zero-padded: 0..9999.
def pad4(n:Int) -> String:
    return pad2(n / 100) ++ pad2(n - n / 100 * 100)


## One instant as (year, month, day, hour, minute, second), in UTC.
## Month is 1..12 and day is 1..31, as a reader writes them.
public def of_instant(t:Int) -> (Int, Int, Int, Int, Int, Int):
    return (year_of(t), month_of(t), day_of(t), hour_of(t), minute_of(t), second_of(t))


## One time rendered by a format: `yyyy` `MM` `dd` `HH` `mm` `ss`, with
## anything else in the format taken literally, from the separators
## listed here.
public def format(t:(Int, Int, Int, Int, Int, Int), fmt:String) -> String:
    (year, month, day, hour, minute, second) = t
    (_, rendered) = loop rest, out = fmt, "":
        match rest:
            case "yyyy" ++ tail:
                (tail, out ++ pad4(year))
            case "MM" ++ tail:
                (tail, out ++ pad2(month))
            case "dd" ++ tail:
                (tail, out ++ pad2(day))
            case "HH" ++ tail:
                (tail, out ++ pad2(hour))
            case "mm" ++ tail:
                (tail, out ++ pad2(minute))
            case "ss" ++ tail:
                (tail, out ++ pad2(second))
            case "-" ++ tail:
                (tail, out ++ "-")
            case ":" ++ tail:
                (tail, out ++ ":")
            case "/" ++ tail:
                (tail, out ++ "/")
            case "." ++ tail:
                (tail, out ++ ".")
            case "," ++ tail:
                (tail, out ++ ",")
            case " " ++ tail:
                (tail, out ++ " ")
            case "T" ++ tail:
                (tail, out ++ "T")
            case "Z" ++ tail:
                (tail, out ++ "Z")
            case _:
                break
    return rendered
