## Graphics, widgets and sound on a web page, kept in time with each
## other.
##
## A program builds its page by calling the functions below: each
## canvas, button, label and slider goes below the ones before it. A
## canvas is drawn on with `clear`, `circle`, `rect`, `line` and `text`,
## in pixels from its top left corner; a shape takes a `fill` and a
## `stroke` colour from the submodule `tinyweb.color`, or a `Style`
## holding both.
##
## What the first programs need is here, in `tinyweb` itself; what comes
## later is a submodule of it, named for its subject:
##
## | Submodule | What it holds |
## |---|---|
## | `tinyweb.color` | colours, and the paints and gradients shapes are filled with |
## | `tinyweb.sound` | voices that can be stopped and faded, tones, the beat, channels and listening |
## | `tinyweb.bitmap` | pictures built pixel by pixel |
## | `tinyweb.layout` | rows, columns and a box of text |
## | `tinyweb.net` | saving and loading files |
## | `tinyweb.game` | the mouse's cursor |
## | `tinyweb.smooth` | the shapes, with positions between pixels |
##
## A program that handed the page a function -- `on_click`, `on_frame`
## and the rest -- keeps running after its last line: the page calls the
## function each time the event happens. Sound and pictures are kept in
## step by one clock, `time`: a frame is drawn for a time, and `play`
## can start a sound at one.
##
## tinyweb needs a page to show. A program starts with
## `web_init(port)`, which serves one and prints its address wherever
## the program runs -- `pyk program.pyk`, the REPL, or any compiled
## target -- and does nothing in a browser, where the page is there
## already: on a web page, and beside the program in the notebook and
## the playground.
#
# The Pyking half of `tinyweb`. The host's half is declared in
# tinyweb_external.pyk beside this file and is in scope here
# unqualified; what is written here is what needs a default, a struct,
# or no host function of its own. Most of it is written over the
# generic host functions (`command`, `watch`, `report_number`, ...).
#
# Comments read by tools/help/libdoc.py: a `##` block followed by
# `# submodule NAME` describes a submodule, and `# topic: NAME` starts
# the topic the exports after it are listed under.

use mutation

import math
import text as strings


def nothing():
    ()


def ignore(value: Int):
    ()


def ignore_bool(value: Bool):
    ()


def ignore_text(value: String):
    ()


def ignore_float(value: Float):
    ()


# --- writing numbers for the page ---

# A shape's numbers, as the words the page reads.
def numbers2(a: Int, b: Int) -> String:
    string(a) + " " + string(b)


def numbers3(a: Int, b: Int, c: Int) -> String:
    numbers2(a, b) + " " + string(c)


def numbers4(a: Int, b: Int, c: Int, d: Int) -> String:
    numbers2(a, b) + " " + numbers2(c, d)


# Words joined by `between`. A chunk of words is joined before it is
# added to the whole, so no one `+` copies much: the time it takes grows
# with the number of words, not with its square.
def joined_by(words: [String], between: String) -> String:
    var whole = ""
    var chunk = ""
    var count = 0
    var chunks = 0
    for word in words:
        chunk := if count == 0 then word else chunk + between + word
        count := count + 1
        if count == 128:
            whole := if chunks == 0 then chunk else whole + between + chunk
            chunks := chunks + 1
            chunk := ""
            count := 0
    if count == 0 then whole else if chunks == 0 then chunk else whole + between + chunk


def joined(words: [String]) -> String:
    joined_by(words, " ")


# Points as the words `x y x y ...`.
def points_text(points: [Point]) -> String:
    joined([numbers2(p.x, p.y) for p in points])


# Segments as the words `x1 y1 x2 y2 ...`.
def segments_text(segments: [(Point, Point)]) -> String:
    joined([numbers4(a.x, a.y, b.x, b.y) for (a, b) in segments])


# The same for numbers with a fraction, which `tinyweb.smooth` draws with.
def floats2(a: Float, b: Float) -> String:
    string(a) + " " + string(b)


def floats3(a: Float, b: Float, c: Float) -> String:
    floats2(a, b) + " " + string(c)


def floats4(a: Float, b: Float, c: Float, d: Float) -> String:
    floats2(a, b) + " " + floats2(c, d)


def float_points_text(points: [smooth.Point]) -> String:
    joined([floats2(p.x, p.y) for p in points])


def bit(on: Bool) -> String:
    if on then "1" else "0"


# --- tinyweb.color ---

## Colours, and the paints a shape can be filled with.
##
## A colour is a `Color`: how much red, green and blue, each from 0 to
## 255, and how opaque it is, from 0.0 (not at all) to 1.0. Make one with
## `rgb`, `rgba`, `hsl` or `hex`, take one of the named ones (`black`,
## `white`, `red`, ...), or write `Color(255, 136, 0)`. `none` is fully
## transparent: a shape with `stroke = color.none` has no outline.
##
## A `Paint` is what fills a shape: a plain colour, or a linear, radial
## or conic gradient between two colours, with more stops added by `stop`.
##
## ```pyking
## import tinyweb as tw
## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 100)
## tw.clear(c, color.navy)
## tw.circle(c, 50, 50, 30, color.rgb(255, 136, 0), stroke = color.white)
## sky = color.Linear(0.0, 0.0, 0.0, 100.0, color.blue, color.white)
## tw.rect(c, 110, 10, 80, 80, paint = sky)
## ```
# submodule color

# topic: Colours

## A colour: its red, green and blue parts, each from 0 to 255, and how
## opaque it is, from 0.0 (not at all) to 1.0.
##
## # Parameters
## - `r`, `g`, `b`: how much red, green and blue.
## - `a`: how opaque; 1.0 by default.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## faded = color.Color(255, 0, 0, a = 0.5)
## print(faded.r, faded.g, faded.b, faded.a)
## ```
## ```stdout
## 255 0 0 0.5
## ```
public struct color.Color(r: Int, g: Int, b: Int, a = 1.0)

## Black.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.black.r, color.black.g, color.black.b)
## ```
## ```stdout
## 0 0 0
## ```
public color.black: color.Color = color.Color(0, 0, 0)

## White.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.white.r, color.white.g, color.white.b)
## ```
## ```stdout
## 255 255 255
## ```
public color.white: color.Color = color.Color(255, 255, 255)

## Grey, halfway between black and white.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.gray.r, color.gray.g, color.gray.b)
## ```
## ```stdout
## 128 128 128
## ```
public color.gray: color.Color = color.Color(128, 128, 128)

## Red.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.red.r, color.red.g, color.red.b)
## ```
## ```stdout
## 255 0 0
## ```
public color.red: color.Color = color.Color(255, 0, 0)

## Green.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.green.r, color.green.g, color.green.b)
## ```
## ```stdout
## 0 128 0
## ```
public color.green: color.Color = color.Color(0, 128, 0)

## Blue.
##
## # Examples
## ```pyking
## import tinyweb.color as color
## print(color.blue.r, color.blue.g, color.blue.b)
## ```
## ```stdout
## 0 0 255
## ```
public color.blue: color.Color = color.Color(0, 0, 255)

## Yellow.
##
## # Examples
## ```pyking
