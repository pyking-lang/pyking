## ```
public def smooth.bezier(c: String, x1: Float, y1: Float, ax: Float, ay: Float, bx: Float, by: Float, x2: Float, y2: Float, stroke: color.Color = color.black, width: Float = 1.0, alpha: Float = 1.0, style: Style = Style()) -> ():
