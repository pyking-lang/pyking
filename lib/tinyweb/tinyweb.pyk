## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 100)
## smooth.arc(c, 100.0, 50.0, 40.5, 0.0, 3.0, color.none, stroke = color.red, width = 2.5)
## ```
## ```stdout
## ```
public def smooth.arc(c: String, x: Float, y: Float, radius: Float, start: Float, end: Float, fill: color.Color = color.black, stroke: color.Color = color.none, width: Float = 1.0, alpha: Float = 1.0, paint: color.Paint = color.Plain(color.none), style: Style = Style()) -> ():
    smooth.shape(c, "arc", floats3(x, y, radius) + " " + floats2(start, end), fill, stroke, width, alpha, paint, style)


