## Graphics, widgets and sound on a web page, kept in time with each
## other.
##
## A program builds its page by calling the functions below: each
## canvas, button, label and slider goes below the ones before it. A
## canvas is drawn on with `clear`, `circle`, `rect`, `line` and `text`,
## in pixels from its top left corner, and a color is a CSS color such
## as "#ff0000" or "red".
##
## A program that handed the page a function -- `on_click`, `on_frame`
## and the rest -- keeps running after its last line: the page calls the
## function each time the event happens. Sound and pictures are kept in
## step by one clock, `time`: a frame is drawn for a time, and `play`
## can start a sound at one.
##
## tinyweb needs a page to show. A program starts with
## `web_init(port)`, which serves one and prints its address wherever
## the program runs -- `pyk program.pyk`, the REPL, or any compiled
## target -- and does nothing in a browser, where the page is there
## already: on a web page, and beside the program in the notebook and
## the playground.
#
# The Pyking half of `tinyweb`. The host's half is declared in
# tinyweb_external.pyk beside this file and is in scope here
# unqualified; what is written here is what needs a default.


def nothing():
    ()


def ignore(value: Int):
    ()


## Fills the whole canvas `c` with one color, wiping out what was drawn.
##
## # Parameters
## - `c`: the canvas, as `canvas` answered.
## - `color`: a CSS color, such as `"#ff0000"` or `"red"`; white by
##   default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 60)
## tw.clear(c, "navy")
## ```
## ```stdout
## ```
public def clear(c: Int, color: String = "#ffffff") -> ():
    fill_canvas(c, color)


## Draws a filled circle on the canvas `c`.
##
## # Parameters
## - `c`: the canvas, as `canvas` answered.
## - `x`, `y`: the centre, in pixels from the canvas's top left corner.
## - `radius`: the radius in pixels.
## - `color`: a CSS color; black by default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 100)
## tw.circle(c, 100, 50, 40, "gold")
## tw.circle(c, 100, 50, 20)
## ```
## ```stdout
## ```
public def circle(c: Int, x: Int, y: Int, radius: Int, color: String = "#000000") -> ():
    draw_circle(c, x, y, radius, color)


## Draws a filled rectangle on the canvas `c`.
##
## # Parameters
## - `c`: the canvas, as `canvas` answered.
## - `x`, `y`: the top left corner, in pixels from the canvas's top left
##   corner.
## - `width`, `height`: the size in pixels.
## - `color`: a CSS color; black by default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 100)
## tw.rect(c, 20, 20, 160, 60, "#4caf50")
## ```
## ```stdout
## ```
public def rect(c: Int, x: Int, y: Int, width: Int, height: Int, color: String = "#000000") -> ():
    draw_rect(c, x, y, width, height, color)


## Draws a straight line on the canvas `c`.
##
## # Parameters
## - `c`: the canvas, as `canvas` answered.
## - `x1`, `y1`: where the line starts, in pixels.
## - `x2`, `y2`: where it ends, in pixels.
## - `color`: a CSS color; black by default.
## - `width`: how thick it is, in pixels; 1 by default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 100)
## tw.line(c, 0, 0, 200, 100)
## tw.line(c, 0, 100, 200, 0, "red", 4)
## ```
## ```stdout
## ```
public def line(c: Int, x1: Int, y1: Int, x2: Int, y2: Int, color: String = "#000000", width: Int = 1) -> ():
    draw_line(c, x1, y1, x2, y2, color, width)


## Writes text on the canvas `c`.
##
## # Parameters
## - `c`: the canvas, as `canvas` answered.
## - `x`, `y`: the top left corner of the text, in pixels.
## - `words`: the text to write.
## - `color`: a CSS color; black by default.
## - `size`: the height of the letters in pixels; 16 by default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 60)
## tw.text(c, 10, 10, "Score: 42", "purple", 24)
## ```
## ```stdout
## ```
public def text(c: Int, x: Int, y: Int, words: String, color: String = "#000000", size: Int = 16) -> ():
    draw_text(c, x, y, words, color, size)


## Adds a button below everything already on the page.
##
## # Parameters
## - `title`: the text on the button.
## - `on_click`: the function to call each time it is pressed; by default
##   nothing happens.
##
## # Returns
## The button's number.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## var count = 0
## def pressed():
##     count := count + 1
##     print("pressed", count, "times")
## tw.button("Count", on_click = pressed)
## ```
## ```stdout
## ```
public def button(title: String, on_click: () -> () = nothing) -> Int:
    make_button(title, on_click)


## Adds a slider below everything already on the page.
##
## # Parameters
## - `low`, `high`: the smallest and largest values it can be set to.
## - `value`: where it starts.
## - `on_change`: the function to call with each new value it is moved
##   to; by default nothing happens.
##
## # Returns
## The slider's number.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## shown = tw.label("50")
## def moved(value: Int):
##     tw.set_label(shown, string(value))
## tw.slider(0, 100, 50, on_change = moved)
## ```
## ```stdout
## ```
public def slider(low: Int, high: Int, value: Int, on_change: (Int) -> () = ignore) -> Int:
    make_slider(low, high, value, on_change)


## Plays a sample that `load_sample` loaded.
##
## # Parameters
## - `sample`: the sample's number, as `load_sample` answered.
## - `at`: when to start, in seconds on the page's clock (see `time`);
##   a time already past, such as the default 0.0, means now.
## - `volume`: how loud, as a multiple of the sample's own volume; 1.0 by
##   default.
## - `rate`: how fast, as a multiple of normal speed; 2.0 plays it twice
##   as fast and an octave higher. 1.0 by default.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## piano = tw.load_sample("piano_c1.wav")
## def chord():
##     start = tw.time()
##     tw.play(piano, at = start)
##     tw.play(piano, at = start + 0.25, rate = 1.25)
##     tw.play(piano, at = start + 0.5, volume = 0.7, rate = 1.5)
## tw.button("Play", on_click = chord)
## ```
## ```stdout
## ```
public def play(sample: Int, at: Float = 0.0, volume: Float = 1.0, rate: Float = 1.0) -> ():
    play_sample(sample, at, volume, rate)


## Plays a sound file now, loading it first if nothing has loaded it yet.
## For a sound played often, `load_sample` once and then `play` is
## quicker.
##
## # Parameters
## - `name`: the file's name, such as `"snare1.wav"`; see `load_sample`
##   for where it is looked for.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## def hit():
##     tw.play_file("snare1.wav")
## tw.button("Snare", on_click = hit)
## ```
## ```stdout
## ```
public def play_file(name: String) -> ():
    play(load_sample(name))
