# The external half of `tinyweb`: what the host provides. tinyweb.pyk
# beside it is the Pyking half, and the two files are one module
# (docs/modules.md, "A module in two halves").
#
# The private declarations are what tinyweb.pyk wraps to give an
# argument a default, which a declaration cannot carry. Every function
# here but `web_start` sends one command to the page; see docs/libraries.md, "tinyweb",
# for the commands and how they reach the page.

# Serves the page on `port`: what `web_init` in tinyweb.pyk calls.
def web_start(port: Int) -> ()

# topic: Canvas
## Adds a canvas to draw on, below everything already on the page. It
## starts white.
##
## # Parameters
## - `width`: its width in pixels.
## - `height`: its height in pixels.
##
## # Returns
## The canvas's identifier, which the drawing functions take as `c`:
## `"canvas"`, with a number added where something on the page has
## that name already.
##
## # Examples
## ```pyking
## import tinyweb as tw
## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 60)
## tw.rect(c, 10, 10, 180, 40, color.teal)
## ```
## ```stdout
## ```
public def canvas(width: Int, height: Int) -> String

def fill_canvas(c: String, color: String) -> ()

# One shape: `kind` is rect, circle, ellipse, arc, line, lines, curve,
# bezier, polygon, path or erase, and `numbers` its numbers as words,
# which tinyweb.pyk writes.
def draw_shape(c: String, kind: String, numbers: String, color: String, outline: String, width: Float, alpha: Float) -> ()

# Many points, circles or lines in one go, their numbers in a list rather
# than as words: `kind` is polygon or path for (x, y) points, circles for
# (x, y, radius), lines for (x1, y1, x2, y2).
def draw_pairs(c: String, kind: String, items: [(Float, Float)], color: String, outline: String, width: Float, alpha: Float) -> ()

def draw_triples(c: String, kind: String, items: [(Float, Float, Float)], color: String, outline: String, width: Float, alpha: Float) -> ()

def draw_quads(c: String, kind: String, items: [(Float, Float, Float, Float)], color: String, outline: String, width: Float, alpha: Float) -> ()

def draw_text(c: String, x: Float, y: Float, words: String, color: String, size: Int, font: String, align: String, baseline: String, bold: Bool, outline: String, outline_width: Float, alpha: Float) -> ()

# What the next drawing on a canvas is drawn with: `kind` is translate,
# rotate, scale, push, pop, reset, shadow, blend, line_style or clip.
def set_state(c: String, kind: String, value: String, numbers: String) -> ()

# Asks the page how wide `words` is in that font; `answer` is called with
# the width once the page has said.
def measure(words: String, size: Int, font: String, bold: Bool, answer: (Float) -> ()) -> ()

# Calls `f` with where the pointer is on the canvas `c` when it is
# pressed, released, moved or dragged there, as `kind` says.
def watch_pointer(c: String, kind: String, f: (Int, Int) -> ()) -> ()

# Where the pointer was last seen on the canvas `c`: `which` is x, y or
# down (1 while the button is held, else 0).
def pointer(c: String, which: String) -> Int

def draw_image(c: String, picture: String, x: Int, y: Int, width: Int, height: Int, alpha: Float) -> ()

def make_bitmap(width: Int, height: Int, background: Int) -> String

def set_pixel(b: String, x: Int, y: Int, color: Int) -> ()

def get_pixel(b: String, x: Int, y: Int) -> Int

def fill_bitmap(b: String, color: Int) -> ()

def draw_bitmap(c: String, b: String, x: Int, y: Int, scale: Float) -> ()

# topic: Images
## Starts loading a picture, so that `image` can draw it. The file is
## looked for beside the page first, then among the pictures tinyweb
## ships: `ball.png`, `star.png` and `tile.png`. A picture drawn before
## it has loaded is not drawn; the next frame draws it.
##
## # Parameters
## - `name`: the file's name, such as `"ball.png"`.
##
## # Returns
## The picture's identifier, which `image` takes: the file's name, with a
## number added where something on the page has that name already.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## c = tw.canvas(200, 100)
## ball = tw.load_image("ball.png")
## def draw(t: Float):
##     tw.clear(c)
##     tw.image(c, ball, 80, 30, 40, 40)
## tw.on_frame(draw)
## ```
## ```stdout
## ```
public def load_image(name: String) -> String

def make_button(title: String, on_click: () -> ()) -> String

# topic: Widgets
## Adds a line of text below everything already on the page.
##
## # Parameters
## - `text`: what the label says.
##
## # Returns
## The label's identifier, which `set_text` takes to change the text:
## the text it starts with, with a number added where something on the
## page has that name already.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## tw.label("Hello from tinyweb")
## ```
## ```stdout
## ```
public def label(text: String) -> String

def row() -> String

def column() -> String

def inside(id: String) -> ()

def outside() -> ()

def set_label(id: String, text: String) -> ()

def make_slider(low: Int, high: Int, value: Int, on_change: (Int) -> ()) -> String

def make_checkbox(title: String, checked: Bool, on_change: (Bool) -> ()) -> String

def make_radio(group: String, title: String, chosen: Bool, on_pick: (String) -> ()) -> String

# `options` is the choices, one per line, which tinyweb.pyk joins.
def make_choice(options: String, chosen: Int, on_change: (Int) -> ()) -> String

def make_text_input(placeholder: String, on_enter: (String) -> ()) -> String

def make_number_input(low: Int, high: Int, value: Int, on_change: (Int) -> ()) -> String

# topic: Widgets
## Ticks or clears a checkbox, or chooses a radio button. Nothing the
## program handed over is called: only the reader changes call it.
##
## # Parameters
## - `id`: the checkbox or radio button, as `checkbox` or `radio`
##   answered.
## - `checked`: `true` to tick it (or choose it), `false` to clear it.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## trails = tw.checkbox("Trails")
## tw.set_checked(trails, true)
## ```
## ```stdout
## ```
public def set_checked(id: String, checked: Bool) -> ()

# topic: Widgets
## Moves a slider or a number field to a value, or picks the dropdown
## choice at that position (0 is the first). Nothing the program handed
## over is called.
##
## # Parameters
## - `id`: the slider, number field or dropdown.
## - `value`: the new value, or the choice's position.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## speed = tw.slider(0, 10, 5)
## tw.set_value(speed, 8)
## ```
## ```stdout
## ```
public def set_value(id: String, value: Int) -> ()

def apply_style(id: String, kind: String, property: String, value: String) -> ()

# topic: Sound
## Starts loading a sound file, so that `play` can play it without a
## delay. The file is looked for beside the page first, then among the
## samples tinyweb ships: `kick1.wav`, `snare1.wav`, `hihat1.wav` and
## `piano_c1.wav`.
##
## # Parameters
## - `name`: the file's name, such as `"kick1.wav"`.
##
## # Returns
## The sample's identifier, which `play` takes: the file's name, with a
## number added where something on the page has that name already.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## kick = tw.load_sample("kick1.wav")
## def hit():
##     tw.play(kick)
## tw.button("Kick", on_click = hit)
## ```
## ```stdout
## ```
public def load_sample(name: String) -> String

# The generic part of the host, which most of tinyweb is written over:
# `command` sends the page one command, `kind` naming what it does and
# `numbers` its numbers as words, which tinyweb.pyk writes; `mode` says
# what a page connecting later is sent again (0 kept, 1 replacing the
# last of its kind and id, 2 like a sound, 3 not at all). `fresh_id`
# answers a new element's identifier, `watch` hands over a function
# called when the page reports `kind` for `id`, and `report_number`,
# `report_text` and `report_count` read what the page last reported by
# name. `watch_text`, `watch_step` and `watch_pair` hand over a function
# called with what was reported: the text under `name`, or the first two
# numbers under `kind`. See docs/libraries.md, "tinyweb".
def fresh_id(name: String) -> String
def command(kind: String, id: String, text: String, numbers: String, mode: Int) -> ()
def watch(id: String, kind: String, f: () -> ()) -> ()
def report_number(name: String, k: Int) -> Float
def report_text(name: String) -> String
def report_count(name: String) -> Int
def watch_text(id: String, kind: String, name: String, f: (String) -> ()) -> ()
def watch_step(id: String, kind: String, f: (Int, Float) -> ()) -> ()
def watch_pair(id: String, kind: String, f: (Float, Float) -> ()) -> ()

# topic: Splash screen
## Shows the splash screen: the page is dimmed and a message asks the
## reader to click, since a browser plays no sound before the reader has
## clicked or pressed a key. The page waits there -- what the program
## draws next, its frames and its clock -- until the reader does. It is
## shown at most once, and not at all where the reader has already
## clicked, as in the playground and a notebook. A program that plays a
## sound calls it at the end of its top level without writing it, and
## the first `play` before a click shows it too.
##
## # Examples
## ```pyking
## import tinyweb as tw
## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 100)
## tw.circle(c, 100, 50, 40, color.orange)
## tw.splash()
## ```
## ```stdout
## ```
public def splash() -> ()

# topic: Splash screen
## Sets the message the splash screen shows, `Click to Start` until it is
## set. An empty message turns the splash screen off, and sound then
## starts at the reader's first click on the page.
##
## # Parameters
## - `message`: what the splash screen says, or `""` for none.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## tw.set_splash("Click to hear the drums")
## kick = tw.load_sample("kick1.wav")
## tw.play(kick)
## ```
## ```stdout
## ```
public def set_splash(message: String) -> ()

# topic: Time
## Reads the page's clock. Once sound has started this is the audio clock,
## so a time read here can be given to `play` to start a sound exactly
## then.
##
## # Returns
## The time in seconds.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## print(tw.time() >= 0.0)
## ```
## ```stdout
## true
## ```
public def time() -> Float

# topic: Time
## Calls `draw` before each frame the page shows, about 60 times a second,
## with the time the frame is for. This is how a program animates.
##
## # Parameters
## - `draw`: the function to call; it is given the frame's time in seconds,
##   as `time` reads it.
##
## # Examples
## ```pyking
## import tinyweb as tw
## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 60)
## def draw(t: Float):
##     tw.clear(c)
##     x = int(t * 50.0) - int(t * 50.0) / 200 * 200
##     tw.circle(c, x, 30, 10, color.orange)
## tw.on_frame(draw)
## ```
## ```stdout
## ```
public def on_frame(draw: (Float) -> ()) -> ()

def on_mouse(c: String, click: (Int, Int) -> ()) -> ()

# topic: Mouse and keyboard
## Calls `pressed` each time a key is pressed while the page has the
## focus.
##
## # Parameters
## - `pressed`: the function to call; it is given the key: a letter or
##   digit as itself, and otherwise the browser's name for it, such as
##   `"ArrowLeft"`, `"Enter"` or `" "`.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## shown = tw.label("press a key")
## def pressed(key: String):
##     tw.set_text(shown, "you pressed " ++ key)
## tw.on_key(pressed)
## ```
## ```stdout
## ```
public def on_key(pressed: (String) -> ()) -> ()

# topic: Mouse and keyboard
## Calls `released` each time a key is let go while the page has the
## focus. Leaving the page lets go of every key held.
##
## # Parameters
## - `released`: the function to call; it is given the key, named as
##   `on_key` names it.
##
## # Examples
## ```pyking
## import tinyweb as tw
## tw.web_init(0)
## shown = tw.label("hold a key")
## def released(key: String):
##     tw.set_text(shown, "you let go of " ++ key)
## tw.on_key_up(released)
## ```
## ```stdout
## ```
public def on_key_up(released: (String) -> ()) -> ()

# topic: Mouse and keyboard
## Says whether a key is held down now. A game moves its ship each frame
## while an arrow is held, rather than once per press.
##
## # Parameters
## - `key`: the key, named as `on_key` names it, such as `"ArrowLeft"` or
##   `"a"`.
##
## # Returns
## `true` while the key is held.
##
## # Examples
## ```pyking
## import tinyweb as tw
## import tinyweb.color as color
## tw.web_init(0)
## c = tw.canvas(200, 60)
## var x = 100
## def draw(t: Float):
##     if tw.key_down("ArrowLeft"):
##         x := x - 2
##     if tw.key_down("ArrowRight"):
##         x := x + 2
##     tw.clear(c)
##     tw.circle(c, x, 30, 10, color.teal)
## tw.on_frame(draw)
## ```
## ```stdout
## ```
public def key_down(key: String) -> Bool
