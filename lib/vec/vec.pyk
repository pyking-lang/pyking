## Vecs: copying, joining, comparing, reversing and sorting them.
##
## A Vec is made by the builtin `vec()` or `vec(xs)`, read with `v[i]`
## and written with `v[i] := x`, and grown and shrunk by the builtins
## `push`, `pop`, `insert`, `remove` and `clear`; `len(v)` and
## `same(v, w)` are builtins too (PYKING.md, "Vecs"). This module is the
## rest. `copy`, `to_list` and `to_array` make a **new** value and copy
## **shallowly**; `extend`, `reverse` and `sort` change the Vec they are
## given, which everyone holding it sees. `push` and `pop` take constant
## time on average, `insert` and `remove` time in proportion to the
## elements they move, and sorting `n log n`.
#
# Written in Pyking alone, over the builtins and lib/array, so every
# target runs the same code: `sort` is lib/array's merge sort, on a copy
# written back.

use mutation
import array


## A new Vec holding the same elements as `v`, in the same order.
##
## # Parameters
## - `v`: the Vec to copy.
##
## # Returns
## A new Vec of `len(v)` elements; changing one does not change the other.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([1, 2])
## w = vec.copy(v)
## push(w, 3)
## print(v, w)
## ```
## ```stdout
## vec([1, 2]) vec([1, 2, 3])
## ```
public def copy(v: Vec(t)) -> Vec(t):
    out = vec()
    for x in v:
        push(out, x)
    out


## The elements of `v` as they are now, as a list.
##
## # Parameters
## - `v`: the Vec.
##
## # Returns
## A list of `len(v)` elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([3, 4])
## push(v, 5)
## print(vec.to_list(v))
## ```
## ```stdout
## [3, 4, 5]
## ```
public def to_list(v: Vec(t)) -> [t]:
    [x for x in v]


## The elements of `v` as they are now, as a new array.
##
## # Parameters
## - `v`: the Vec.
##
## # Returns
## A new array of `len(v)` elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.to_array(vec(["a", "b"])))
## ```
## ```stdout
## array(["a", "b"])
## ```
public def to_array(v: Vec(t)) -> Array(t):
    array_init(len(v), lam i. v[i])


## A new Vec holding the elements of an array.
##
## # Parameters
## - `a`: the array.
##
## # Returns
## A new Vec of `len(a)` elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec.from_array(array([1, 2]))
## push(v, 3)
## print(v)
## ```
## ```stdout
## vec([1, 2, 3])
## ```
public def from_array(a: Array(t)) -> Vec(t):
    out = vec()
    for x in a:
        push(out, x)
    out


## Adds every element of a list to the end of `v`, in order.
##
## # Parameters
## - `v`: the Vec to grow.
## - `xs`: what to add.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([1])
## vec.extend(v, [2, 3])
## print(v)
## ```
## ```stdout
## vec([1, 2, 3])
## ```
public def extend(v: Vec(t), xs: [t]) -> ():
    for x in xs:
        push(v, x)


## Puts the elements of `v` in the opposite order, in place.
##
## # Parameters
## - `v`: the Vec to reverse.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([1, 2, 3])
## vec.reverse(v)
## print(v)
## ```
## ```stdout
## vec([3, 2, 1])
## ```
public def reverse(v: Vec(t)) -> ():
    var i = 0
    var j = len(v) - 1
    while i < j:
        held = v[i]
        v[i] := v[j]
        v[j] := held
        i += 1
        j -= 1


# Writes the elements of `a` over those of `v`, which has as many.
def write_back(v: Vec(t), a: Array(t)) -> ():
    for i in range(len(a)):
        v[i] := a[i]


# Whether two Vecs have the same length and, position by position,
# elements `alike` says are the same.
def equal_by(v: Vec(t), w: Vec(t), alike: (t, t) -> Bool) -> Bool:
    var same_so_far = len(v) == len(w)
    var k = 0
    while same_so_far and k < len(v):
        same_so_far := alike(v[k], w[k])
        k += 1
    same_so_far


## Whether two Vecs of Ints hold the same elements in the same order.
## `same(v, w)` asks instead whether they are one Vec.
##
## # Parameters
## - `v`: one Vec.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.equal(vec([1, 2]), vec([1, 2])), vec.equal(vec([1]), vec([2])))
## ```
## ```stdout
## true false
## ```
public def int::equal(v: Vec(Int), w: Vec(Int)) -> Bool:
    equal_by(v, w, lam (x, y). x == y)


## Whether two Vecs of Floats hold the same elements in the same order,
## compared with `==` -- so a Vec holding NaN equals no Vec.
##
## # Parameters
## - `v`: one Vec.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.equal(vec([0.5]), vec([0.5])))
## ```
## ```stdout
## true
## ```
public def float::equal(v: Vec(Float), w: Vec(Float)) -> Bool:
    equal_by(v, w, lam (x, y). x == y)


## Whether two Vecs of Strings hold the same elements in the same order.
##
## # Parameters
## - `v`: one Vec.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.equal(vec(["a"]), vec(["a"])))
## ```
## ```stdout
## true
## ```
public def string::equal(v: Vec(String), w: Vec(String)) -> Bool:
    equal_by(v, w, lam (x, y). x == y)


## Whether two Vecs of Chars hold the same elements in the same order.
##
## # Parameters
## - `v`: one Vec.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.equal(vec(['a']), vec(['b'])))
## ```
## ```stdout
## false
## ```
public def char::equal(v: Vec(Char), w: Vec(Char)) -> Bool:
    equal_by(v, w, lam (x, y). x == y)


## Whether two Vecs of Bools hold the same elements in the same order.
##
## # Parameters
## - `v`: one Vec.
## - `w`: the other.
##
## # Returns
## `true` when they have the same length and equal elements.
##
## # Examples
## ```pyking
## use mutation
## import vec
## print(vec.equal(vec([true]), vec([true])))
## ```
## ```stdout
## true
## ```
public def bool::equal(v: Vec(Bool), w: Vec(Bool)) -> Bool:
    equal_by(v, w, lam (x, y). x == y)


## Sorts a Vec of Ints from smallest to largest, in place, stably.
##
## # Parameters
## - `v`: the Vec to sort.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([3, 1, 2])
## vec.sort(v)
## print(v)
## ```
## ```stdout
## vec([1, 2, 3])
## ```
public def int::sort(v: Vec(Int)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a Vec of Floats in place, as `array.sort` orders them: `-inf`
## first, `-0.0` and `0.0` as equal, then `inf`, and every NaN last.
##
## # Parameters
## - `v`: the Vec to sort.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec([2.5, -1.0])
## vec.sort(v)
## print(v)
## ```
## ```stdout
## vec([-1.0, 2.5])
## ```
public def float::sort(v: Vec(Float)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a Vec of Strings in place, by code point.
##
## # Parameters
## - `v`: the Vec to sort.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec(["pear", "Fig", "apple"])
## vec.sort(v)
## print(v)
## ```
## ```stdout
## vec(["Fig", "apple", "pear"])
## ```
public def string::sort(v: Vec(String)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)


## Sorts a Vec of Chars by code point, in place.
##
## # Parameters
## - `v`: the Vec to sort.
##
## # Examples
## ```pyking
## use mutation
## import vec
## v = vec(['c', 'a', 'b'])
## vec.sort(v)
## print(v)
## ```
## ```stdout
## vec(['a', 'b', 'c'])
## ```
public def char::sort(v: Vec(Char)) -> ():
    a = to_array(v)
    array.sort(a)
    write_back(v, a)
