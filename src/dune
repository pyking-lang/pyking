; The Pyking compiler, built from the OCaml sources in this directory.
;
; Everything pure is one library: the front end, the analyses, the type
; checker, the optimizer, the interpreter and every backend. Nothing in
; it opens a file, starts a process or reads a terminal, which is what
; lets the same code be compiled to JavaScript for the playground (see
; docs/build.md). The library is unwrapped, so its modules are reached
; by their own names -- `Parser.parse`, not `Pyking.Parser.parse`.
;
; The executable adds the modules that do talk to the outside world --
; the driver, `--run`, the REPL with its editor, and the plugin host that
; loads an external module's OCaml implementation -- and they are the
; only ones that link `unix` and `dynlink`.
;
; Warnings are on but never fatal, so a build fails only on a real
; error.
(library
 (name pyking)
 (wrapped false)
 (modules targets lexer names syntax walk builtin analyses desugar_args parser splash submodules module
   exhaustive typesystem elaborate warnings release prune opt_tailcall interpreter completion repl_session json notebook_format highlight scopes lsp debug_session dap examples target_python target_js_core target_js_packaging target_ocaml target_c target_java type_experiment)
 (flags
  (:standard -warn-error -a)))

;; version.ml is generated from the VERSION file at the root, so the
;; number is written in one place and `pyk --version` cannot disagree
;; with the package built from the same tree.
(rule
 (targets version.ml)
 (deps ../VERSION)
 (action
  (with-stdout-to
   version.ml
   (echo "let version = \"%{read-lines:../VERSION}\"\n"))))

;; dynlink is for the interpreter's plugins (src/plugin_host.ml), and
;; -linkall puts every module of the standard library and of unix into
;; the executable, since a plugin may use one pyk itself never does.
(executable
 (name pyk)
 (modules pyk execution repl plugin_host web_server web_tools install version)
 (libraries pyking pyk_plugin unix dynlink)
 (link_flags (:standard -linkall))
 (flags
  (:standard -warn-error -a)))
