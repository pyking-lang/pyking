; The Pyking compiler, built from the OCaml sources in this directory.
;
; Everything pure is one library: the front end, the analyses, the type
; checker, the optimizer, the interpreter and every backend. Nothing in
; it opens a file, starts a process or reads a terminal, which is what
; lets the same code be compiled to JavaScript for the playground (see
; docs/build.md). The library is unwrapped, so its modules are reached
; by their own names -- `Parser.parse`, not `Pyking.Parser.parse`.
;
; The executable adds the three modules that do talk to the outside
; world -- the driver, `--run`, and the REPL with its editor -- and they
; are the only ones that link `unix`.
;
; Warnings are on but never fatal, so a build fails only on a real
; error.
;; `--profile static` is for the Linux packages only
;; (tools/packaging/linux/Dockerfile): it links pyk with no shared
;; library at all, which musl makes possible. Every other build is
;; unaffected.
(env
 (static
  (link_flags
   (:standard -ccopt -static))))

(library
 (name pyking)
 (wrapped false)
 (modules targets lexer names syntax walk builtin analyses desugar_args parser module
   typesystem elaborate opt_tailcall interpreter target_python target_js_core target_js_packaging target_ocaml target_c target_java type_experiment)
 (flags
  (:standard -warn-error -a)))

;; version.ml is generated from the VERSION file at the root, so the
;; number is written in one place and `pyk --version` cannot disagree
;; with the package built from the same tree.
(rule
 (targets version.ml)
 (deps ../VERSION)
 (action
  (with-stdout-to
   version.ml
   (echo "let version = \"%{read-lines:../VERSION}\"\n"))))

(executable
 (name pyk)
 (modules pyk execution repl stdlib_host web_tools install version)
 (libraries pyking unix)
 (flags
  (:standard -warn-error -a)))
