# Datatypes: constructors with and without fields, positional, named
# and defaulted fields, printing, and matching on the constructor.

datatype Color:
    Red
    Green
    Blue

datatype Shape:
    Circle(radius: Float)
    Rect(width: Float, height: Float)
    Square(Float)


def area(s: Shape) -> Float:
    match s:
        case Circle(r): 3.0 * r * r
        case Rect(w, h): w * h
        case Square(side): side * side


def name(c: Color) -> String:
    match c:
        case Red: "red"
        case Green: "green"
        case Blue: "blue"


shapes = [Circle(1.0), Rect(2.0, 3.0), Square(4.0), Rect(width = 0.5, height = 5.0)]
for s in shapes:
    print(s, area(s))

for c in [Red, Green, Blue]:
    print(c, name(c))

print(Red)
print([Red, Blue])
print((Circle(2.5), Green))

# A field with a default is left out, given by position, or given by name.
datatype Account:
    Account(owner: String, balance: Int = 0, currency = "SEK")

print(Account("ada"))
print(Account("grace", 10))
print(Account("don", currency = "EUR"))
print(Account(owner = "linus", balance = 3, currency = "USD"))

# A datatype's own name and its one constructor's are often the same.
datatype Pair:
    Pair(Int, String)

def swap(p: Pair) -> (String, Int):
    match p:
        case Pair(n, s): (s, n)

print(swap(Pair(1, "one")))
