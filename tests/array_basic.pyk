# Arrays: made by `array(...)` and `array_init(...)`, read with `a[i]`,
# written with `a[i] := v` and `a[i] op= v`, measured with `len`, walked
# by `for`, shared by every name that holds one, and printed as what
# makes one. Every target runs this and prints the same.

use mutation

# The two forms of `array`, and the two of `array_init`.
from_list = array([4, 1, 2])
filled = array(3, "x")
squares = array_init(5, lam i. i * i)
fibs = array_init(8, (0, 1), lam p. let (x, y) = p in (x, (y, x + y)))
print(from_list, filled, squares, fibs)
print(len(from_list), len(squares), from_list[0], squares[4])

# Written in place: a[i] := v, and the compound forms.
from_list[0] := from_list[1] + from_list[2]
squares[2] += 100
squares[3] *= 2
squares[4] -= 1
print(from_list, squares)

# Shared: a second name, or a parameter, is the same array.
alias = from_list
alias[1] := 50
print(from_list, same(alias, from_list), same(from_list, array([3, 50, 2])))


def zero_first(xs: Array(Int)) -> ():
    xs[0] := 0


zero_first(from_list)
print(from_list)

# The generator is called once per element, in index order.
def traced(i: Int) -> Int:
    print("making", i)
    i * 10


print(array_init(3, traced))
print(len(array_init(0, traced)))

# `for` reads each element as it is reached, so a write ahead is seen.
walked = array([1, 2, 3])
for x in walked:
    if x == 1:
        walked[2] := 30
    print("walked", x)

# A comprehension over an array makes a list.
doubled = [x * 2 for x in walked]
print(doubled, string(walked))

# Arrays of every element type, and nested ones.
print(array([1.5, 2.0]), array(['a', 'b']), array([true, false]), array([(1, "one")]))
grid = array_init(2, lam _. array(3, 0))
grid[1][2] := 7
print(grid, len(grid[1]))
print([array([1]), array([2])], (array([1]), 2))

# An empty array, its type written.
empty: Array(Int) = array([])
print(empty, len(empty))

# A loop may carry an array, and a `var` may hold one.
var current = array([1, 2])
current := array([5, 6, 7])
print(current)
total = loop acc = array(1, 0) for x in [1, 2, 3]:
    acc[0] += x
    acc
print(total)

# The order an element write runs in: the array and the index first,
# the index checked, then the value, then the write -- into the array
# first named, even when the value names another.
order = array([10])


def change() -> Int:
    order[0] := 100
    1


order[0] += change()
print(order)
var held = array([1, 2])
first = held


def replace_held() -> Int:
    held := array([9, 9])
    5


held[0] := replace_held()
print(held, first)

# The qualified forms say which is meant: three copies of a function.
def twice(n: Int) -> Int:
    n * 2


functions = fill::array(3, twice)
print(len(functions), functions[1](21))
print(list::array([7]), init::array_init(2, lam i. i + 1), unfold::array_init(3, 1, lam s. (s, s * 3)))
