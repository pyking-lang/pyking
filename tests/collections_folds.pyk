# `foldl` gathers from the first element, `foldr` from the last; both on
# every kind of collection, a Map's values, an Option's or a Result's
# value.

use mutation

xs = [1, 2, 3, 4]
print(foldl(lam (acc, x). acc - x, 0, xs), foldr(lam (x, acc). x - acc, 0, xs))
print(foldl(lam (acc, x). acc + string(x), "", xs), foldr(lam (x, acc). acc + string(x), "", xs))
print(foldl(lam (acc, x). [x] + acc, [], xs), foldr(lam (x, acc). [x] + acc, [], xs))
a = array(xs)
d = dynarray(xs)
w = view(a, 1, 3)
print(foldl(lam (acc, x). acc * 10 + x, 0, a), foldr(lam (x, acc). acc * 10 + x, 0, a))
print(foldl(lam (acc, x). acc * 10 + x, 0, d), foldr(lam (x, acc). acc * 10 + x, 0, d))
print(foldl(lam (acc, x). acc * 10 + x, 0, w), foldr(lam (x, acc). acc * 10 + x, 0, w))
m = map([("a", 1), ("b", 2), ("c", 3)])
print(foldl(lam (acc, v). acc * 10 + v, 0, m), foldr(lam (v, acc). acc * 10 + v, 0, mutmap(m)))
none: Option(Int) = None
print(foldl(lam (acc, x). acc + x, 10, Some(5)), foldl(lam (acc, x). acc + x, 10, none), foldr(lam (x, acc). x * acc, 3, Some(2)))
ok: Result(Int, String) = Ok(5)
bad: Result(Int, String) = Error("no")
print(foldl(lam (acc, x). acc + x, 1, ok), foldr(lam (x, acc). acc + x, 1, bad))
empty: [Int] = []
print(foldl(lam (acc, x). acc + x, 7, empty), foldr(lam (x, acc). acc + x, 7, empty))

# the order of the calls
def step(acc: String, x: Int) -> String:
    print("step", x)
    acc + string(x)
print(foldl(step, ">", [1, 2, 3]))
print(foldr(lam (x, acc). step(acc, x), "<", [1, 2, 3]))

# a long list: foldr does not recurse
long = list_init(100000, lam i. i % 7)
print(foldr(lam (x, acc). acc + x, 0, long), foldl(lam (acc, x). acc + x, 0, long))

# folding a list of structs into a Map
struct Sale(item: String, amount: Int)
sales = [Sale("tea", 2), Sale("jam", 1), Sale("tea", 5)]
totals = foldl(lam (acc, s). let before = get(acc, s.item, 0) in map(items(acc) + [(s.item, before + s.amount)]), map(), sales)
print(totals)
