# `++` concatenates; `+` adds. The two are separate operators so that
# neither has to be read as the other, and so that a backend never has
# to ask a type in order to know which one was meant.

def shout(word: String) -> String:
    word ++ "!"


def join(a: String, b: String) -> String:
    a ++ " " ++ b


# Strings, at the same precedence as `+` and associating to the left
# (typecheck_int_string.pyk pins that in a printed AST).
print("con" ++ "cat")
print("a" ++ "b" ++ "c" ++ "d")
print(shout(join("hello", "there")))

# The two never meet: `+` takes two Ints, `++` takes two Strings, and
# nothing is both.
print(2 + 3)
print("2" ++ "3")

# `*` still binds tighter than either of them.
print(1 + 2 * 3)
print("<" ++ shout("x") ++ ">")
