def window(start:Int, size:Int, step:Int) -> Int:
    return start + size * step
print(window(1, 2, 3))
def padded(text:String, left:Int, right:Int) -> String:
    if left + right <= 0:
        return text
    return '.' + padded(text, left - 1, right - 1)
print(padded('x', 1, 2))
print(padded('y', 3, 2))
print(window(window(1, 1, 1), 2, 2))
