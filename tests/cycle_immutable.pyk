# A cycle closed by an immutable value: a generic datatype holding a var
# struct that holds it again, and a datatype holding a MutMap that holds
# it again. Printing stops with `...` at whatever on the path repeats
# first -- here the immutable value -- and a value only shared prints
# in full each time.

use mutation

datatype Opt(a):
    No
    Just(v: a)

var struct Link(n: Int, next: Opt(Link))

first = Link(1, No)
around = Just(first)
first.next := around
print(around)
print(first)
print((around, first))

datatype Tree:
    Leaf
    Node(kids: MutMap(String, Tree))

kids: MutMap(String, Tree) = mutmap()
root = Node(kids)
kids["self"] := root
kids["leaf"] := Leaf
print(root)
print(kids)
shared = Just(Link(2, No))
print((shared, shared))
