# Putting a key in a Dict, or taking one out, while a `for` walks it is a
# runtime error, on every target but plain C: the walk would miss or
# repeat keys otherwise. Replacing a value is not a change of keys.

use mutation

d = dict([(1, "a"), (2, "b")])
for k in d:
    d[k] := "seen"
print(d)
for k in d:
    print(k)
    if k == 1:
        d[3] := "c"
print("not reached")
