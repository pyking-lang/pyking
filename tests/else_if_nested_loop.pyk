# The `else if` ladder driven from a `for` loop over a list, which the
# JavaScript subset does not cover yet.
def grade(score):
    if score >= 90:
        return "A"
    else if score >= 80:
        return "B"
    else if score >= 70:
        return "C"
    else:
        return "F"


for s in [95, 85, 75, 65]:
    print(s, grade(s))


