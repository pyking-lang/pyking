# An empty list among others in a list literal, a tuple and a
# constructor: its element type is the others'. Every target prints the
# same.

datatype Box:
    Box(items: [Int])

xss = [[1, 2], [], [3]]
print(xss, [[1, 2], [], [3]], len(xss[1]))
print([[], ["a"]], [[[]], [[1]]], ([], [1.5]))
print([Box([]), Box([4])], [x for xs in [[], [5, 6], []] for x in xs])


def lengths(groups: [[String]]) -> [Int]:
    [len(g) for g in groups]


print(lengths([[], ["p", "q"], []]))
