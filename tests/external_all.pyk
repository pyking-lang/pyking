# Reaching a module implemented in a target language.
#
# The declaration beside this file says what `external_all_mod1` offers;
# the implementation is whichever of its target files this program is
# compiled to. Nothing about the call is special -- a qualified name is
# an ordinary environment lookup, and the checker holds the call to the
# type the declaration wrote.
#
# Every function is called several times, with different arguments and
# with arguments the program computes rather than writes down, so that
# an implementation returning a constant fails here rather than passing
# by coincidence. Nothing here overflows: past the signed 32-bit range
# the answer is undefined, so the hosts are free to disagree and a test
# comparing them all against one file could not.

import external_all_mod1 as host

print(host.shout("hi"))
print(host.shout("again"))
print(host.shout(""))
print(host.shout(host.shout("twice over")))
print(host.shout(host.greeting))

print(host.twice(21))
print(host.twice(0))
print(host.twice(-13))
print(host.twice(host.twice(5)))

print(host.flip(true))
print(host.flip(false))
print(host.flip(host.flip(true)))

print(host.origin)
print(host.greeting)
print(host.shout(host.greeting) + "/" + host.greeting)
