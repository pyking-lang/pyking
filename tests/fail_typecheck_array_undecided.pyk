# `array(n, v)` where nothing has decided `v`'s type could fill or
# generate, and nothing says which, so it is refused rather than guessed:
# a lambda's parameter is open while its body is checked. Annotating
# `v`, or writing `fill::array` or `init::array`, says which.
#
# This program is expected to FAIL. Its `.ast.out` holds the error
# message, not a program's output.

use mutation

make = lam v. array(3, v)
print(len(make(1)))
