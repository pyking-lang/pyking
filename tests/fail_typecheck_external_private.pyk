# Reaching a private declaration from another module.
#
# `hidden` is declared without `public` in the module's external half,
# so it is the module's own and no import can name it -- exactly as a
# `def` written without `public` in a Pyking file is. `shown` beside it
# is public and would be fine.
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

import fail_typecheck_external_private_mod1 as m

print(m.hidden(1))
