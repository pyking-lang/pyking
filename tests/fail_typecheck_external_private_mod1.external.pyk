# A declaration file with a signature that is not public.
#
# A private declaration is legal: it is in scope in the module's own
# Pyking half and nowhere else, which is how a library keeps a host
# function it needs but does not offer. What is refused is *reaching*
# one from another module -- see fail_typecheck_external_private.pyk.

public def shown : (Int) -> Int

def hidden : (Int) -> Int
