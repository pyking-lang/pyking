# A `return` that does not give the declared return type.
#
# `size` says `-> Int`, and one of its two branches returns a String.
# The annotation is what the rest of the program will believe, so it is
# the returned expression that is wrong rather than the annotation --
# and the error points at that expression, in the branch it is in,
# rather than at the function as a whole.
#
# This program is expected to FAIL type checking. Its `.out` holds the
# error message, not a program's output.

def size(n:Int) -> Int:
    if n > 10:
        return "big"
    else:
        return n
