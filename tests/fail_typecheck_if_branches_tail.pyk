# An `if` whose value is used must still have branches of one type.
#
# A statement after an `if` throws its value away, and then its branches
# may disagree (tests/if_branches_discarded.pyk). But a function body's
# last statement is the function's value, and so is the last statement
# of each of its branches: here one way out gives an Int and the other
# unit, and the function has to have one result type.
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

def twice(n: Int) -> Int:
    n * 2


def pick(n: Int):
    if n > 0:
        twice(n)
    else:
        print("not positive")


pick(1)
