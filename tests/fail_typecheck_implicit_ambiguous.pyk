# Two implicits of one name fit the same parameter.
#
# There is no specificity ordering: two candidates that both fit is a
# mistake for the programmer to settle, by writing the argument out
# (docs/implicits.md).
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

implicit def a::bar(z: Int) -> String: string(z)
implicit def b::bar(z: Int) -> String: string(z) ++ "!"

def foo(x: Int, implicit bar: (Int) -> String) -> String:
    bar(x)

print(foo(1))
