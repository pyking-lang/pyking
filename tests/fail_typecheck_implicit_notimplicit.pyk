# A binding of the right name that is not `implicit`.
#
# The `implicit` keyword at the *definition* is what makes a value
# findable; without it nothing is captured by accident, which is the
# whole point of writing it (PYKING.md, "Implicits").
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

def foo(x: Int, implicit bar: (Int) -> String) -> String:
    bar(x)

def my3() -> ():
    def bar(z: Int) -> String: string(z)
    print(foo(1))

my3()
