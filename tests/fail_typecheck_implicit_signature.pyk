# An implicit parameter written on a signature line.
#
# A signature says a type and binds nothing, so an implicit parameter
# there would name something the body cannot use. It is written on the
# `def` itself (docs/implicits.md).
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

implicit def fmt(n: Int) -> String: string(n)

def show : (Int, implicit fmt: (Int) -> String) -> String
def show(n, implicit fmt: (Int) -> String): fmt(n)

print(show(3))
