# A parameter written by index may be an array, a DynArray or a view,
# but not a list: a list is never changed.
#
# `zero` writes `xs[0]`, so the kinds its first call may choose are the
# three that are written by index, and a list is refused with the kinds
# the body allows.
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

use mutation

def zero(xs):
    xs[0] := 0

zero([1, 2])
