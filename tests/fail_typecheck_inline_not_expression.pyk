# A block on its header's own line holds one line's worth: an
# expression, a `return`, `break` or `continue`, or an update with
# `:=`. A header that opens a block of its own -- a loop here -- is not
# one, and goes under its header instead, where it is plain.
#
# This program is expected to be REFUSED. Its `.ast.out` holds the error
# message, not a program's output.

def total(xs: [Int], on: Bool) -> ():
    if on: for x in xs: print(x)
    print("done")


total([1, 2], true)
