# A `break` with a value in a loop that carries nothing.
#
# `loop:` with no accumulator has nowhere to put a value: it is worth
# unit whichever way it ends, so `break` there takes no operand. The
# loop to write instead is `loop x = ...:`, which has something to
# break with.
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

loop:
    break 5
