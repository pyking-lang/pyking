# A comprehension written where a [Shape] is wanted may give only
# objects that are Shapes on every turn: Box implements nothing.
use objects

interface Shape:
    def name(self) -> String

class Dot(r: Int) implements Shape:
    override def name(self) -> String:
        "dot"

class Box(w: Int):
    def size(self) -> Int:
        self.w

shapes: [Shape] = [Box(k) for k in range(3)]
