# No definition of an overloaded name takes these arguments.
#
# The message names what is in scope and at what type, since the mistake
# is usually a missing definition rather than a wrong call
# (docs/overloading.md).
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

def int::twice(x: Int) -> Int: x * 2
def string::twice(x: String) -> String: x ++ x

print(twice(true))
