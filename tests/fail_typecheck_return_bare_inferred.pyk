# A function whose result is inferred has one return type, and a
# `return` with nothing after it gives (). The error names that
# `return`'s line, since the () is nowhere written.
#
# This program is expected to be REFUSED. Its `.ast.out` holds the error
# message, not a program's output.

def half(n):
    if n < 0: return
    return n / 2


print(half(8))
