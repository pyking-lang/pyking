# A `def` with no body gives every parameter a type: it declares a
# function, and an untyped parameter would leave its type unsaid.
#
# This program is expected to be REFUSED. Its `.ast.out` holds the error
# message, not a program's output.

def scale(n: Int, factor) -> Int
def scale(n, factor): n * factor

print(scale(6, 7))
