# `+` between a String and an Int: the mistake a joining `+` invites.
#
# `+` joins two Strings and adds two numbers, but it converts nothing,
# so a number written beside a String is refused rather than turned
# into text. The message says so and names the conversion to write,
# because `"n = " + n` is what anyone arriving from JavaScript writes
# first.
#
# This program is expected to FAIL type checking. Its `.ast.out` holds
# the error message, not a program's output.

count = 5
label = "count = " + count
