# A plain struct never changes, so its field is not written: the message
# says how to build a new one, or to declare the struct `var struct`.
#
# This program is expected to FAIL. Its `.ast.out` holds the error
# message, not a program's output.

use mutation

struct Point(x: Int, y: Int)

p = Point(1, 2)
p.x += 3
