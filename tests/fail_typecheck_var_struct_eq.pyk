# `==` does not compare structs: a mutable struct is compared with
# `same`, or field by field by a function the program writes.
#
# This program is expected to FAIL. Its `.ast.out` holds the error
# message, not a program's output.

use mutation

mutable struct Point(x: Int, y: Int)

print(Point(1, 2) == Point(1, 2))
