# A struct whose fields are written in place is declared `mutable
# struct`; the old spelling, `var struct`, is refused with a hint.
#
# This program is expected to FAIL. Its `.ast.out` holds the error
# message, not a program's output.

use mutation

var struct Point(x: Int, y: Int)

p = Point(1, 2)
p.x := 3
print(p)
