# Comparing Floats, which is IEEE's comparison and not Pyking's own.
#
# `<`, `<=`, `>`, `>=` and `==` all take two Floats. The surprise is
# NaN: it is equal to nothing, itself included, and every ordering
# against it is false. That is IEEE 754 and every host agrees about it
# (PYKING.md, "Numbers").

a: Float = 1.5
b: Float = 2.5

print(a < b)
print(b < a)
print(a <= a)
print(a > b)
print(b >= b)
print(a == a)
print(a == b)

# A NaN, made the way IEEE makes one.
zero: Float = 0.0
one: Float = 1.0
nan: Float = zero / zero
print(nan == nan)
print(nan < one)
print(nan > one)
print(nan <= one)
print(nan >= one)

# The infinities order the way the numbers they stand for do.
inf: Float = one / zero
print(inf > b)
print(-inf < b)
print(inf == inf)

# The two zeros are one number as far as comparison is concerned.
print(zero == -zero)
print(zero < -zero)
