# `str` on a Float, which writes exactly what `print` writes.
#
# Kept apart from the other Float cases because the JavaScript, C and
# Java backends refuse `str` altogether, so a program using it reaches
# fewer targets than the Float support itself does.

print(str(1.0))
print(str(0.1))
print(str(1e300))
print("value: " ++ str(-2.5))

zero: Float = 0.0
one: Float = 1.0
print(str(one / zero))
print(str(zero / zero))
print(str([1.0, 0.5]))
print(str((1.0, 2)))
