# Hexadecimal and binary integer literals: either case for the x or b
# and for the digits, and `_` between two digits for readability. Each
# is an ordinary Int, as a decimal literal is.

orange = 0xff8800
print(orange, 0XFF8800, 0xFf_88_00, orange == 16746496)
print(0b101, 0B101, 0b0001_0101, 0b0001_0101 == 21)
print(0x0, 0b0, 0x7fff_ffff, -0x7fff_ffff)
red = orange / 0x10000
green = (orange / 0x100) - red * 0x100
print(red, green, 0x10 + 0b10 + 10)
