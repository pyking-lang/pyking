# The math library's functions where the answer is not exact: each host
# may differ from another in the last bit, so each is printed to six
# decimals, which is what every host agrees on.

import math

def six(x: Float) -> Float:
    return float(math.round(x * 1000000.0)) / 1000000.0

print(six(math.sin(1.0)), six(math.cos(1.0)), six(math.tan(1.0)))
print(six(math.sin(45.0)), six(math.cos(45.0)), six(math.sin(-123.0)), six(math.cos(1000.0)))
print(six(math.sin_rad(1.0)), six(math.cos_rad(1.0)), six(math.tan_rad(1.0)))
print(six(math.asin_rad(0.5)), six(math.acos_rad(0.5)), six(math.atan_rad(1.0)), six(math.atan2_rad(-1.0, -1.0)))
print(six(math.asin(0.3)), six(math.acos(0.3)), six(math.atan(2.0)), six(math.atan2(2.0, -3.0)))
print(six(math.sinh(1.0)), six(math.cosh(1.0)), six(math.tanh(0.5)))
print(six(math.exp(2.5)), six(math.log(10.0)), six(math.log2(10.0)), six(math.log10(2.0)))
print(six(math.cbrt(10.0)), six(math.pow(2.0, 0.5)), six(math.hypot(1.0, 1.0)))
print(six(math.lerp(0.0, 1.0, 1.0 / 3.0)), six(math.map_range(1.0, 0.0, 3.0, 0.0, 1.0)))

# A circle of eight points, the way a drawing walks one.
var angle = 0.0
while angle < 360.0:
    print(angle, six(100.0 * math.cos(angle)), six(100.0 * math.sin(angle)))
    angle := angle + 45.0
