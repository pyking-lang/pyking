# The math library's exact answers: the constants, the trigonometric
# functions where they are exact, rounding, and the Int and Float
# overloads. Everything printed here is the same double on every host.

import math

print(math.pi, math.tau, math.e)
print(math.inf, -math.inf, math.nan)
print(math.is_nan(math.nan), math.is_nan(1.0))
print(math.is_finite(1.0), math.is_finite(math.inf), math.is_finite(math.nan))

print(math.sin(0.0), math.sin(-0.0), math.sin(math.pi / 2.0), math.sin(-math.pi / 2.0))
print(math.cos(0.0), math.cos(math.pi), math.tan(0.0), math.tan(-0.0))
print(math.asin(0.0), math.asin(1.0) == math.pi / 2.0, math.asin(-1.0) == -math.pi / 2.0)
print(math.acos(1.0), math.acos(-1.0) == math.pi, math.acos(0.0) == math.pi / 2.0)
print(math.atan(0.0), math.atan(1.0) == math.pi / 4.0, math.atan(math.inf) == math.pi / 2.0)
print(math.atan2(0.0, 1.0), math.atan2(0.0, -1.0) == math.pi, math.atan2(-1.0, 0.0) == -math.pi / 2.0)
print(math.is_nan(math.asin(2.0)), math.is_nan(math.acos(-2.0)))
print(math.to_radians(180.0), math.to_radians(-90.0) == -math.pi / 2.0, math.to_radians(0.0))
print(math.to_degrees(math.pi), math.to_degrees(math.pi / 2.0), math.to_degrees(0.0))

print(math.sqrt(16.0), math.sqrt(2.0), math.is_nan(math.sqrt(-1.0)))
print(math.sqrt(-1.0), math.log(-1.0), math.sin(-0.0), math.trunc(-0.5))
print(math.cbrt(27.0), math.cbrt(-8.0), math.hypot(3.0, 4.0), math.distance(1.0, 1.0, 4.0, 5.0))
print(math.pow(2.0, 10.0), math.pow(9.0, 0.5), math.pow(2.0, -1.0), math.pow(5.0, 0.0))
print(math.exp(0.0), math.log(1.0), math.log(0.0), math.is_nan(math.log(-1.0)))
print(math.log2(8.0), math.log2(0.5), math.log10(1000.0), math.log10(0.01))
print(math.sinh(0.0), math.cosh(0.0), math.tanh(0.0), math.tanh(math.inf))

print(math.floor(2.7), math.floor(-2.2), math.ceil(2.2), math.ceil(-2.7))
print(math.trunc(2.7), math.trunc(-2.7), math.round(2.5), math.round(-2.5))
print(math.round(2.4), math.round(-2.6), math.round(0.49999999999999994))
print(math.floor(math.nan), math.round(math.inf), math.trunc(1.0e100))

print(math.abs(-3), math.abs(3), math.abs(-2.5), math.abs(-0.0))
print(math.min(3, 7), math.max(3, 7), math.min(1.5, 0.5), math.max(1.5, 0.5))
print(math.is_nan(math.min(math.nan, 1.0)), math.is_nan(math.max(1.0, math.nan)))
print(math.clamp(15, 0, 10), math.clamp(-5, 0, 10), math.clamp(5, 0, 10))
print(math.clamp(1.5, 0.0, 1.0), math.clamp(0.25, 0.0, 1.0))
print(math.sign(-5), math.sign(0), math.sign(5), math.sign(-2.5), math.sign(0.0), math.sign(3.0))

print(math.mod(7, 3), math.mod(-7, 3), math.mod(7, -3), math.mod(-7, -3), math.mod(6, 3))
print(math.mod(-90.0, 360.0), math.mod(7.5, 2.0), math.mod(-0.5, -2.0))
print(math.gcd(12, 18), math.gcd(-4, 6), math.gcd(7, 0), math.gcd(0, 0))
print(math.lcm(4, 6), math.lcm(-3, 5), math.lcm(0, 5))
print(math.lerp(10.0, 20.0, 0.25), math.lerp(10.0, 20.0, 1.0))
print(math.map_range(5.0, 0.0, 10.0, 100.0, 200.0), math.map_range(0.25, 0.0, 1.0, 255.0, 0.0))
