# The sys library: the program's own arguments, and its name.
#
# None is compared as a value. `args` is empty because nothing passes
# any, which is the same answer on every host; `prog_name` is the file
# the host was asked to run and `prog_path` the directory it sits in,
# and both differ on every target -- so only that each says *something*
# is portable.
#
# Emptiness is tested with `==` rather than `len`, which the JavaScript
# backends have no translation for yet: a test should not narrow the
# targets a library reaches.

import sys

print(sys.args())
print(sys.prog_name() == "")
print(sys.prog_path() == "")
