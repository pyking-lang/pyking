# The text library without a list, so every target runs it, C included:
# lengths and positions in code points, out-of-range positions, empty
# strings, ASCII and non-ASCII text.

import text

crown = "åäö 👑"

print(text.length("hello"), text.length(crown), text.length(""), text.length("👑👑"))

print("[" + text.slice(crown, 0, 3) + "]", "[" + text.slice(crown, 4, 5) + "]")
print("[" + text.slice(crown, -5, 2) + "]", "[" + text.slice(crown, 3, 99) + "]")
print("[" + text.slice(crown, 3, 3) + "]", "[" + text.slice(crown, 4, 1) + "]")
print("[" + text.slice("", 0, 1) + "]", "[" + text.slice("abc", 99, 100) + "]")

print(text.char_at(crown, 0), text.char_at(crown, 4), text.char_at("abc", 2))
print(text.char_at(crown, 5) == '\0', text.char_at(crown, -1) == '\0', text.char_at("", 0) == '\0')

print(text.code('A'), text.code(crown[0]), text.code(crown[3]), text.code(crown[4]))
print(text.code('\0'), text.code(text.char_at(crown, 9)))

print(text.from_code(65), text.from_code(229), text.from_code(128081), text.from_code(8364))
print(text.from_code(0) == '\0', text.from_code(-1) == '\0', text.from_code(55296) == '\0')
print(text.from_code(57343) == '\0', text.from_code(1114112) == '\0', text.code(text.from_code(1114111)))
print(text.code(text.from_code(128081)), text.code(text.from_code(57344)))

print(text.find("one two one", "one"), text.find("one two one", "one", 1))
print(text.find("one two one", "one", 9), text.find("one two one", "three"))
print(text.find(crown, "👑"), text.find(crown, "ö"), text.find(crown, " 👑", 2))
print(text.find("abc", ""), text.find("abc", "", 2), text.find("abc", "", 3), text.find("abc", "", 4))
print(text.find("abc", "a", -3), text.find("", "a"), text.find("", ""))
print(text.find("👑a👑a", "a", 2), text.find("👑a👑a", "a", start = 1))

print(text.contains("hello", "ell"), text.contains("hello", "Hell"), text.contains("", ""))
print(text.contains(crown, "ä"), text.contains("x", "xx"))

print(text.starts_with("hello", "he"), text.starts_with("he", "hello"), text.starts_with("", ""))
print(text.starts_with(crown, "åä"), text.starts_with(crown, "ä"))
print(text.ends_with("photo.png", ".png"), text.ends_with("photo.png", ".jpg"))
print(text.ends_with(crown, "👑"), text.ends_with("", "a"), text.ends_with("a", ""))

print(text.upper("Hello, World! 123"), text.lower("Hello, World! 123"))
print(text.upper(crown), text.lower("ÅÄÖ ABC"), text.upper("") == "")

print("[" + text.trim("  two words \n") + "]", "[" + text.trim("\t\r\n ") + "]")
print("[" + text.trim("") + "]", "[" + text.trim(" " + crown + "  ") + "]")
print("[" + text.trim("no-space") + "]", "[" + text.trim(" a b ") + "]")

print(text.replace("one two one", "one", "1"), text.replace("aaa", "aa", "b"))
print(text.replace("abc", "", "x"), text.replace("", "a", "b") == "", text.replace(crown, "ä", "ae"))
print(text.replace("a.b.c", ".", ""), text.replace("👑👑", "👑", "<crown>"))
print(text.replace("abc", "abc", "") == "", text.replace("xyz", "q", "r"))
print(text.replace(s = "one", old = "o", new = "0"))

print(text.repeat("ab", 3), text.repeat("-", 10), text.repeat("👑", 2))
print(text.repeat("ab", 0) == "", text.repeat("ab", -2) == "", text.repeat("", 5) == "")
print(text.length(text.repeat("xyz", 1000)), text.repeat("ab", 1))
