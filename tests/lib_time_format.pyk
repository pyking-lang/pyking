# The time library: every format constant, over two fixed instants.
#
# The instants are fixed rather than read from the clock, which is what
# makes the output comparable at all -- and what `of_instant` is for.
# Decomposition is UTC on every host, so these characters are the same
# whichever target produced them.

import time

epoch = time.of_instant(0)
print(time.format(epoch, time.ISO8601))
print(time.format(epoch, time.DATE))
print(time.format(epoch, time.TIME))
print(time.format(epoch, time.DATETIME))
print(time.format(epoch, time.COMPACT))
later = time.of_instant(1767225599)
print(time.format(later, time.ISO8601))
print(time.format(later, time.COMPACT))
