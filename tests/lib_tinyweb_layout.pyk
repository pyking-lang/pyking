# tinyweb's layout: a page centred, rows of elements side by side,
# columns inside a row, and back to the page below them; a heading made
# bold, and a canvas stretched to another size.
import tinyweb as tw

tw.web_init()
tw.page_style(align = "center")
title = tw.label("Layout")
tw.set_style(title, size = 28, weight = 700)
buttons = tw.row()
tw.inside(buttons)


def clicked():
    print("clicked")


tw.button("one", on_click = clicked)
tw.button("two")
tw.outside()
tw.canvas(100, 40)
controls = tw.row()
tw.inside(controls)
tw.label("speed")
tw.slider(0, 10, 5)
tw.inside(buttons)
tw.button("three")
tw.outside()
figures = tw.row()
tw.inside(figures)
left = tw.column()
tw.inside(left)
small = tw.canvas(50, 20)
tw.set_style(small, width = 100, height = 40)
tw.label("stretched")
tw.inside(figures)
right = tw.column()
tw.inside(right)
tw.canvas(100, 40)
tw.label("as it is")
tw.outside()
tw.label("the end")
