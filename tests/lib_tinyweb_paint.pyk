# tinyweb's paint: gradients, dashed lines and their ends, clipping, a
# cubic curve, erasing, outlined text at each baseline, a measured text,
# shapes at positions between pixels, and a style shared by shapes.
import math
import tinyweb as tw
import tinyweb.color as color
import tinyweb.smooth as smooth

tw.web_init(0)
c = tw.canvas(300, 200)
sky = color.Linear(0.0, 0.0, 0.0, 200.0, color.hex(0x1a237e), color.hex(0xffb74d))
tw.rect(c, 0, 0, 300, 200, paint = color.stop(sky, 0.6, color.hex(0xe91e63)))
ball = color.Radial(40.0, 40.0, 4.0, 50.0, 50.0, 30.0, color.white, color.hex(0xdc143c))
tw.circle(c, 50, 50, 30, paint = ball)
wheel = color.stop(color.stop(color.Conic(150.0, 50.0, math.pi / 2.0, color.red, color.red), 0.33, color.hex(0x00ff00)), 0.67, color.blue)
tw.circle(c, 150, 50, 30, paint = wheel, stroke = color.white, width = 2)
tw.push(c)
tw.line_style(c, cap = "butt", join = "bevel", dash = 8.0, gap = 4.0, offset = 2.0)
tw.rect(c, 200, 20, 80, 60, color.none, stroke = color.white, width = 3)
tw.line_style(c, dash = 3.0)
tw.line(c, 200, 90, 280, 90, color.yellow, 2)
tw.pop(c)
tw.push(c)
tw.clip_rect(c, 10, 100, 60, 40)
tw.circle(c, 40, 120, 35, color.orange)
tw.pop(c)
tw.push(c)
tw.clip_circle(c, 120, 130, 25)
tw.rect(c, 90, 100, 60, 60, color.teal)
tw.pop(c)
tw.bezier(c, 160, 160, 190, 100, 230, 200, 260, 120, color.black, 3)
tw.erase(c, 270, 150, 20, 20)
tw.text(c, 10, 190, "bottom", color.white, 14, baseline = "bottom", stroke = color.black, width = 3)
tw.text(c, 80, 185, "middle", color.white, 14, baseline = "middle")
tw.text(c, 150, 185, "alphabetic", color.none, 14, baseline = "alphabetic", stroke = color.white)
smooth.circle(c, 250.5, 130.25, 6.5, color.hex(0xffd700), stroke = color.black, width = 0.5)
smooth.rect(c, 200.5, 100.5, 30.0, 15.0, color.none, stroke = color.white, radius = 4.0)
smooth.ellipse(c, 100.0, 180.0, 12.5, 6.25, color.hex(0xdda0dd))
smooth.arc(c, 30.0, 170.0, 10.0, 0.0, 1.5 * math.pi, color.none, stroke = color.cyan, width = 2.5)
smooth.line(c, 0.0, 199.5, 300.0, 198.5, color.white, 0.8)
smooth.curve(c, 5.0, 5.0, 50.0, 0.5, 95.0, 5.0, color.white, 1.5)
smooth.bezier(c, 5.0, 95.0, 30.0, 70.0, 70.0, 120.0, 95.0, 95.0, color.white, 1.5, alpha = 0.5)
smooth.text(c, 150.5, 100.25, "smooth", color.white, 12, align = "center", baseline = "middle")
tw.push(c)
smooth.clip_circle(c, 50.5, 50.5, 20.0)
tw.rect(c, 30, 30, 20, 40, color.black, alpha = 0.3)
tw.pop(c)
outlined = tw.Style(fill = color.navy, stroke = color.yellow, width = 2, alpha = 0.8)
tw.circle(c, 20, 20, 8, style = outlined)
tw.rect(c, 40, 10, 20, 20, color.red, style = outlined)
tw.line(c, 0, 0, 30, 30, style = outlined)
tw.circle(c, 70, 20, 8, style = tw.Style(paint = ball))
smooth.circle(c, 90.0, 20.0, 8.0, style = outlined)


def underline(width: Float):
    tw.line(c, 10, 60, 10 + int(width), 60, color.white, 2)


tw.measure_text("Hello, canvas!", underline, size = 20, bold = true)
