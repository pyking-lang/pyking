# tinyweb's paint: gradients, dashed lines and their ends, clipping, a
# cubic curve, erasing, outlined text at each baseline, a measured text,
# and shapes at positions between pixels.
import tinyweb as tw
import tinyweb.colors as colors
import tinyweb.smooth as smooth

tw.web_init(0)
c = tw.canvas(300, 200)
sky = colors.linear_gradient(0.0, 0.0, 0.0, 200.0, "#1a237e", "#ffb74d")
sky2 = colors.stop(sky, 0.6, "#e91e63")
tw.clear(c, sky2)
ball = colors.radial_gradient(40.0, 40.0, 4.0, 50.0, 50.0, 30.0, "white", "crimson")
tw.circle(c, 50, 50, 30, ball)
wheel = colors.stop(colors.stop(colors.conic_gradient(150.0, 50.0, 90.0, "red", "red"), 0.33, "lime"), 0.67, "blue")
tw.circle(c, 150, 50, 30, wheel, outline = "white", outline_width = 2)
tw.push(c)
tw.line_style(c, cap = "butt", join = "bevel", dash = 8.0, gap = 4.0, offset = 2.0)
tw.rect(c, 200, 20, 80, 60, "", outline = "white", outline_width = 3)
tw.line_style(c, dash = 3.0)
tw.line(c, 200, 90, 280, 90, "yellow", 2)
tw.pop(c)
tw.push(c)
tw.clip_rect(c, 10, 100, 60, 40)
tw.circle(c, 40, 120, 35, "orange")
tw.pop(c)
tw.push(c)
tw.clip_circle(c, 120, 130, 25)
tw.rect(c, 90, 100, 60, 60, "teal")
tw.pop(c)
tw.bezier(c, 160, 160, 190, 100, 230, 200, 260, 120, "black", 3)
tw.erase(c, 270, 150, 20, 20)
tw.text(c, 10, 190, "bottom", "white", 14, baseline = "bottom", outline = "black", outline_width = 3)
tw.text(c, 80, 185, "middle", "white", 14, baseline = "middle")
tw.text(c, 150, 185, "alphabetic", "", 14, baseline = "alphabetic", outline = "white")
smooth.circle(c, 250.5, 130.25, 6.5, "gold", outline = "black", outline_width = 0.5)
smooth.rect(c, 200.5, 100.5, 30.0, 15.0, "", outline = "white", radius = 4.0)
smooth.ellipse(c, 100.0, 180.0, 12.5, 6.25, "plum")
smooth.arc(c, 30.0, 170.0, 10.0, 0.0, 270.0, "", outline = "cyan", outline_width = 2.5)
smooth.line(c, 0.0, 199.5, 300.0, 198.5, "white", 0.8)
smooth.curve(c, 5.0, 5.0, 50.0, 0.5, 95.0, 5.0, "white", 1.5)
smooth.bezier(c, 5.0, 95.0, 30.0, 70.0, 70.0, 120.0, 95.0, 95.0, "white", 1.5, alpha = 0.5)
smooth.text(c, 150.5, 100.25, "smooth", "white", 12, align = "center", baseline = "middle")
tw.push(c)
smooth.clip_circle(c, 50.5, 50.5, 20.0)
tw.rect(c, 30, 30, 20, 40, "black", alpha = 0.3)
tw.pop(c)


def underline(width: Float):
    tw.line(c, 10, 60, 10 + int(width), 60, "white", 2)


tw.measure_text("Hello, canvas!", underline, size = 20, bold = true)
