# Polygons, paths and palettes: the drawing that takes a list.

import tinyweb as tw
import tinyweb.color as color
from tinyweb.color import palette
from tinyweb import Point

tw.web_init(0)
c = tw.canvas(200, 200)
ocean = palette("ocean")
print(len(ocean))
tw.polygon(c, [Point(100, 10), Point(130, 90), Point(70, 90)], color.orange, stroke = color.black)
tw.path(c, [Point(10, 190), Point(60, 120), Point(110, 170), Point(190, 110)], color.teal, 3)
tw.polygon(c, [], color.red)
tw.lines(c, [(Point(0, 0), Point(20, 20)), (Point(20, 0), Point(0, 20))], color.navy)
print(len(palette("nothing")))
