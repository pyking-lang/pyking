# Polygons, paths and palettes: the drawing that takes a list.

import tinyweb as tw
from tinyweb.colors import palette

tw.web_init(0)
c = tw.canvas(200, 200)
ocean = palette("ocean")
print(len(ocean))
tw.polygon(c, [(100, 10), (130, 90), (70, 90)], "orange", outline = "black")
tw.path(c, [(10, 190), (60, 120), (110, 170), (190, 110)], "teal", 3)
tw.polygon(c, [], "red")
print(palette("nothing"))
