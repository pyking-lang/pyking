# Step 1's shapes and text, with outlines and transparency, and colours
# from the `color` submodule.

import math
import tinyweb as tw
import tinyweb.color as color

tw.web_init(0)
c = tw.canvas(300, 200)
tw.clear(c, color.rgb(17, 17, 17))
gold = color.hex(0xffd700)
tw.circle(c, 50, 50, 30, gold, stroke = color.white, width = 3)
tw.circle(c, 80, 50, 30, color.rgba(0, 128, 255, 0.5))
tw.rect(c, 120, 20, 60, 40, color.none, stroke = color.hsl(120.0, 100.0, 50.0), radius = 8)
tw.ellipse(c, 220, 40, 50, 20, color.hex(0xda70d6), alpha = 0.75)
tw.arc(c, 50, 140, 40, math.pi / 6.0, 11.0 * math.pi / 6.0, color.yellow)
tw.arc(c, 150, 140, 40, math.pi, 2.0 * math.pi, color.none, stroke = color.red, width = 4)
tw.line(c, 200, 100, 290, 190, color.cyan, 2)
tw.curve(c, 200, 190, 245, 60, 290, 190, color.white, 2, alpha = 0.5)
tw.text(c, 150, 180, "Step 1", color.white, 18, font = "serif", align = "center", bold = true)


def show(c: color.Color) -> String:
    string(c.r) ++ " " ++ string(c.g) ++ " " ++ string(c.b) ++ " " ++ string(c.a)


print(show(color.rgb(255, 136, 0)))
print(show(color.rgb(-5, 300, 16)))
print(show(color.hsl(200.0, 50.0, 25.0)))
print(color.to_hex(color.hex(0xff8800)), color.to_hex(color.rgb(1, 2, 3)))
print(color.same(color.hex(0x00ffff), color.cyan), color.same(color.red, color.blue))
print(show(color.mix(color.black, color.white, 0.5)))
print(show(color.with_alpha(color.red, 0.25)))
print(show(color.rgba(10, 20, 30, 0.5)), show(color.none))
