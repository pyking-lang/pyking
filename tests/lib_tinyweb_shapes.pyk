# Step 1's shapes and text, with outlines and transparency, and colors
# from the `colors` submodule.

import tinyweb as tw
import tinyweb.colors as colors

tw.web_init(0)
c = tw.canvas(300, 200)
tw.clear(c, colors.rgb(17, 17, 17))
tw.circle(c, 50, 50, 30, "gold", outline = "white", outline_width = 3)
tw.circle(c, 80, 50, 30, colors.rgba(0, 128, 255, 0.5))
tw.rect(c, 120, 20, 60, 40, "", outline = colors.hsl(120, 100, 50), radius = 8)
tw.ellipse(c, 220, 40, 50, 20, "orchid", alpha = 0.75)
tw.arc(c, 50, 140, 40, 30.0, 330.0, "yellow")
tw.arc(c, 150, 140, 40, 180.0, 360.0, "", outline = "red", outline_width = 4)
tw.line(c, 200, 100, 290, 190, "cyan", 2)
tw.curve(c, 200, 190, 245, 60, 290, 190, "white", 2, alpha = 0.5)
tw.text(c, 150, 180, "Step 1", "white", 18, font = "serif", align = "center", bold = true)
print(colors.rgb(255, 136, 0))
print(colors.rgb(-5, 300, 16))
print(colors.hsl(200, 50, 25))
