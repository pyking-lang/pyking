# tinyweb's shapes that take lists of points, at positions between
# pixels, and many lines drawn in one go.
import tinyweb as tw
import tinyweb.color as color
import tinyweb.smooth as smooth
from tinyweb import Point

tw.web_init(0)
c = tw.canvas(200, 120)
smooth.polygon(c, [smooth.Point(100.0, 10.5), smooth.Point(180.5, 90.5), smooth.Point(19.5, 90.5)], color.orange, stroke = color.black, width = 0.5)
smooth.path(c, [smooth.Point(10.0, 110.0), smooth.Point(60.5, 20.5), smooth.Point(110.25, 70.0), smooth.Point(190.0, 10.0)], color.teal, 2.5)
rays = [(smooth.Point(100.0, 60.0), smooth.Point(100.0 + 45.0 * float(i - i / 3 * 3), 5.0 * float(i))) for i in range(8)]
smooth.lines(c, rays, color.hex(0xdc143c), 0.8, alpha = 0.5)
tw.lines(c, [(Point(x, 0), Point(x, 120)) for x in range(0, 200, 40)], color.hex(0xcccccc))
smooth.circles(c, [(10.5, 10.5, 3.0), (20.0, 10.0, 2.5)], color.navy)
tw.push(c)
smooth.clip_polygon(c, [smooth.Point(100.0, 5.5), smooth.Point(190.5, 115.0), smooth.Point(9.5, 115.0)])
tw.rect(c, 0, 60, 200, 60, color.hex(0xffd700), alpha = 0.4)
tw.pop(c)
tw.push(c)
tw.clip_polygon(c, [Point(0, 0), Point(60, 0), Point(0, 60)])
tw.rect(c, 0, 0, 60, 60, color.navy)
tw.pop(c)
many = [(smooth.Point(float(i), 0.0), smooth.Point(float(i) + 0.5, 120.0)) for i in range(300)]
smooth.lines(c, many, color.black, 0.25, alpha = 0.1)
print("drew", len(many), "lines in one go")
