# A canvas, two circles, two samples and buttons that play them: the
# first tinyweb program.

use mutation

import tinyweb as tw
import tinyweb.color as color

tw.web_init(0)

kick = tw.load_sample("kick1.wav")
snare = tw.load_sample("snare1.wav")

canvas = tw.canvas(400, 200)

tw.circle(canvas, 100, 50, 30, color.red)   # canvas, x, y, radius, colour
tw.circle(canvas, 100, 50, 20)              # the colour defaults to black

var presses = 0

def play_kick():
    tw.play(kick)

def play_sound():
    presses := presses + 1
    print("snare, press " + string(presses))
    tw.play(snare, volume = 0.5)

tw.button("Play kick", on_click = play_kick)
tw.button("Play snare", on_click = play_sound)
tw.button("Does nothing")                 # on_click is optional

print("built the page")
