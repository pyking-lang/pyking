# Transformations, shadows and blending, on a frame: each frame starts
# from `clear`, which drops what the frame before left.

import tinyweb as tw

tw.web_init(0)
c = tw.canvas(200, 200)

def draw(t: Float):
    tw.clear(c, "black")
    tw.push(c)
    tw.translate(c, 100.0, 100.0)
    tw.rotate(c, t * 90.0)
    tw.rect(c, -20, -20, 40, 40, "crimson")
    tw.push(c)
    tw.scale(c, 0.5, 2.0)
    tw.circle(c, 60, 0, 10, "white")
    tw.pop(c)
    tw.pop(c)
    tw.shadow(c, "white", 12)
    tw.circle(c, 30, 30, 10, "gold")
    tw.shadow(c, "")
    tw.blend(c, "add")
    tw.circle(c, 160, 160, 20, "#800000")
    tw.circle(c, 175, 160, 20, "#000080")
    tw.blend(c, "normal")
    tw.blend(c, "multiply")
    tw.reset(c)

tw.on_frame(draw)
