# Checkboxes, radio buttons, a text field and a number field, what the
# reader does with them, and the page changed while it shows: a label's
# text, an element hidden, shown, disabled and removed.

import tinyweb as tw

tw.web_init(0)
shown = tw.label("nothing yet")

def trails(on: Bool):
    tw.set_text(shown, if on then "trails on" else "trails off")

def mode(title: String):
    tw.set_text(shown, "mode: " ++ title)

def entered(name: String):
    tw.set_text(shown, "hello, " ++ name)

def balls(n: Int):
    tw.set_text(shown, string(n) ++ " balls")

box = tw.checkbox("Trails", on_change = trails)
tw.checkbox("Slow frames", checked = true)
tw.radio("mode", "time-based", on_pick = mode)
frame_based = tw.radio("mode", "frame-based", on_pick = mode)
tw.radio("speed", "slow")
tw.radio("speed", "fast", chosen = true)
tw.text_input("your name", on_enter = entered)
tw.text_input()
count = tw.number_input(1, 20, 3, on_change = balls)
speed = tw.slider(0, 10, 5)
tw.set_checked(box, true)
tw.set_checked(frame_based, true)
tw.set_value(count, 5)
tw.set_value(speed, 8)
gone = tw.label("going")
tw.hide(gone)
tw.show(gone)
tw.disable(speed)
tw.enable(speed)
tw.disable(box)
tw.remove(gone)
blank = tw.label("")
tw.set_text(blank, "filled in")
print(frame_based, blank)
