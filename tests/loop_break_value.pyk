# `break x` and `continue x`: a jump that carries a value.
#
# `break x` ends the loop, which is then worth x; `continue x` starts
# the next turn with x as its accumulator. Either way x has the
# accumulator's type. A bare `break`/`continue` still works as before,
# and a loop can mix both kinds. Written without lists or strings so
# that it runs on every target, C included.

# `break x` in the middle of a body: the first square above a limit.
def first_square_over(limit:Int) -> Int:
    return loop n = 1:
        if n * n > limit:
            break n * n
        n + 1

print(first_square_over(50))        # 64


# `break x` beside a bare `break`: either way out of the same loop.
def search(target:Int, give_up:Int) -> Int:
    return loop n = 0:
        if n == target:
            break n * 100
        else if n == give_up:
            break
        n + 1

print(search(3, 10))                # 300
print(search(30, 10))               # 10


# `continue x` replaces what the body would have ended in: a sum that
# saturates at 20 instead of going over.
def saturating_sum(count:Int) -> (Int, Int):
    return loop acc, i = 0, 1 while i <= count:
        if acc + i > 20:
            continue 20, i + 1
        acc + i, i + 1

print(saturating_sum(4))            # (10, 5)
print(saturating_sum(10))           # (20, 11)


# A tuple accumulator is given back without parentheses, as in the
# header, or with them.
pair = loop n, acc = 10, 1:
    if n == 0:
        break n, acc * 2
    n - 1, acc + n

print(pair)                         # (0, 112)

wrapped = loop n, acc = 3, 0:
    if n == 0:
        break (acc, n)
    (n - 1, acc + n)

print(wrapped)                      # (6, 0)


# Every element of the value is worked out before any of the
# accumulator changes: a swap.
swapped = loop a, b, k = 1, 2, 0 while k < 3:
    continue b, a, k + 1

print(swapped)                      # (2, 1, 3)


# The value may read the accumulator it replaces.
doubled = loop x = 1:
    if x > 100:
        break x - 1
    continue x * 2

print(doubled)                      # 127


# `continue x` in a `while` whose test then fails: the loop is worth x.
ran_out = loop i = 0 while i < 5:
    continue i + 2

print(ran_out)                      # 6


# A `break x` belongs to the innermost loop: the inner one stops with
# its own value, and the outer one goes on.
nested = loop total, i = 0, 1 while i <= 3:
    inner = loop j = 0:
        if j >= i:
            break j * 10
        j + 1
    total + inner, i + 1

print(nested)                       # (60, 4)


# An outer `continue x` written after an inner loop has finished.
skipping = loop total, i = 0, 0 while i < 6:
    if i % 2 == 0:
        continue total, i + 1
    found = loop j = i:
        if j > 3:
            break 0
        else:
            break j
    total + found, i + 1

print(skipping)                     # (4, 6)


# Booleans and floats are accumulators like any other.
seen_seven = loop found, n = false, 0 while n < 10:
    if n == 7:
        break true, n
    found, n + 1

print(seen_seven)                   # (true, 7)

halved = loop f = 100.0:
    if f < 1.0:
        break f * 1000.0
    f / 2.0

print(halved)                       # 781.25


# The value of a loop bound with `=` and returned with `return`, from a
# `break` in a branch of an `if` that ends the body.
def collatz_steps(start:Int) -> Int:
    steps, n = loop steps, n = 0, start:
        if n == 1:
            break steps, n
        else if n % 2 == 0:
            steps + 1, n / 2
        else:
            continue steps + 1, 3 * n + 1
    return steps

print(collatz_steps(6))             # 8
print(collatz_steps(27))            # 111


# A bare `break` still stops with the accumulator this turn started
# with, beside a `continue` that replaces it.
mixed = loop acc, i = 0, 0 while i < 6:
    if i == 1:
        continue acc + 1000, i + 1
    else if i == 4:
        break
    acc + i, i + 1

print(mixed)                        # (1005, 4)


# A jump in each arm of a `match` that ends the body, and a value that
# starts with a minus sign.
stepped = loop x = 0:
    match x:
        case 0:
            continue 5
        case 5:
            break -50
        case _:
            x + 1

print(stepped)                      # -50


# Two jumps one after another in a body, each guarding the rest.
def bounce(n:Int) -> Int:
    return loop k = n:
        if k <= 0:
            break k
        if k % 2 == 0:
            continue k - 3
        k - 1

print(bounce(10), bounce(9))        # -1 0
