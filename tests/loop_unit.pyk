# A loop that carries nothing: `loop:` with no accumulator.
#
# `loop:` on its own is a loop over unit. It runs its body for what the
# body does, throws that value away, and goes round again -- so the
# only way out is `break`. Every `break` below is a bare one, which
# leaves the accumulator, so each of these loops is worth unit; a
# `break` may carry a value instead, which is a separate question and
# `typecheck_loop_unit_value.pyk` covers it. `loop:` with no `break` at
# all is a perfectly good program, and never finishes; every loop below
# has one.
#
# Whatever such a loop needs to carry has to be a `var`, which is the
# comparison worth having: the accumulator loops elsewhere in this
# directory need no mutable state at all.

var countdown = 3
loop:
    if countdown == 0:
        break
    print(countdown)
    countdown := countdown - 1

print("lift off")


# `continue` with no operand in a loop with no accumulator: the next
# turn simply starts.
var seen = 0
var index = 0
loop:
    index := index + 1
    if index > 6:
        break
    if index == 3:
        continue
    seen := seen + index

print(seen)


# The loop yields unit, and unit is what a bare `loop:` is worth
# wherever a value is asked for.
nothing = loop:
    break

print(nothing)
