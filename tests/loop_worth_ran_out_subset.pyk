# The loop_worth_ran_out.pyk question -- what a loop is worth when it
# ends without breaking -- in the shared subset, so the C, Java and
# OCaml backends answer it too. Only the `while` form and scalar values
# are used here; the `for`, the tuple accumulator and the unit-worth
# loop are in the other file.

def counted(n: Int, ceiling: Int) -> Int:
    var i = 0
    return loop acc = 0 while i < n:
        i := i + 1
        if acc > ceiling:
            break acc
        else:
            continue acc + i


# Runs out on the first two, breaks on the third.
print(counted(0, 100), counted(4, 100), counted(30, 100))


def stringy(n: Int) -> String:
    var i = 0
    return loop acc = "" while i < n:
        i := i + 1
        if i > 3:
            break acc ++ "!"
        else:
            continue acc ++ "x"


print(stringy(0), stringy(2), stringy(9))
