# Implicits across a module boundary.
#
# A `public implicit` is found by an unqualified call in the file that
# imports the module, automatically; a `public` that is not implicit is
# reached through the module name as usual. A local implicit joins the
# set, and `less_index` -- which is not implicit -- is called through
# `mod.` and has its own implicit resolved at each call site
# (PYKING.md, "Modules").

import module_implicit_mod as mod

print(mod.int::leq(7, 8), mod.float::leq(7.8, 99.3))
print(leq(88, 100), leq(79.12, 18.2), leq([171, 10], [188]))
print(mod.less_index(10, [7, 4, 12, 2]))
print(mod.less_index(30.3, [1.4, 10.12, 23.1, 55.1]))

implicit def intpair::leq(x: (Int, Int), y: (Int, Int)) -> Bool:
    x1, x2 = x
    y1, y2 = y
    if leq(x1, y1):
        leq(x2, y2)
    else:
        false

e = (4, 8)
l = [(2, 2), (5, 7), (1, 3)]
print(mod.less_index(e, l))
