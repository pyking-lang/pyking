# A module whose exports write no annotations. A `def` like that is
# worked out from a call, so this module has to make one -- otherwise it
# has no type to offer whoever imports it, and exporting it is refused
# (see PYKING.md, "What a module may export").
#
# The call is a trigger, not a definition: what each of these exports is
# its *principal* type, read off its own body, so `identity` leaves here
# polymorphic even though the only call below is at Int.

public def bump(n): n + 1

public def identity(x): x

public def swap(a, b): (b, a)

public start = 10


# An export worked out from a private definition, and two exports that
# are worked out together because they name each other.
def double(n): n * 2


public def quadruple(n): double(double(n))


public def even(n): if n == 0 then true else odd(n - 1)


public def odd(n): if n == 0 then false else even(n - 1)


# What makes each of them a definition this module has a type for.
#print(bump(identity(start)), swap(quadruple(1), even(0)), odd(1))
