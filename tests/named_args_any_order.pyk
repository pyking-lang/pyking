# Named arguments may be written in any order. Those written are
# evaluated in the order written, before the defaults of the parameters
# left out; `note` prints as each one is evaluated.

use mutation

def note(label: String, n: Int) -> Int:
    print("  " + label)
    n


def box(width: Int, height: Int = note("height default", 1), depth: Int = 2) -> String:
    string(width) + "x" + string(height) + "x" + string(depth)


print("written out of order:")
print(box(depth = note("depth", 6), width = note("width", 4)))
print("nothing to evaluate:")
print(box(height = 3, width = 5))
print("a positional one first:")
print(box(note("width", 1), depth = note("depth", 7), height = note("height", 8)))


# A function answering nothing.
def show(count: Int, label: String) -> ():
    print(label + " " + string(count))


show(label = "shown", count = note("count", 2))


# A polymorphic one.
def pair(first: a, second: b) -> (a, b):
    (first, second)


print(pair(second = note("second", 2), first = note("first", 1)))


# One call inside another's argument.
def box_depth(a: Int, b: Int) -> Int:
    a * 10 + b


print(box(depth = note("outer depth", box_depth(b = note("inner b", 2), a = note("inner a", 3))), width = 9))


# A var read beside them, in a loop.
var total = 0
for i in range(3):
    total := total + box_depth(b = note("b" + string(i), i), a = note("a", total))
print(total)



# The same inside a function, where the var is a local.
def summed(n: Int) -> Int:
    var acc = 0
    for i in range(n):
        acc := acc + box_depth(b = note("b" + string(i), i), a = note("acc", acc))
    acc


print(summed(2))

# A constructor's fields, the same way.
datatype Size:
    Size(w: Int, h: Int)

print(Size(h = note("h", 2), w = note("w", 3)))
