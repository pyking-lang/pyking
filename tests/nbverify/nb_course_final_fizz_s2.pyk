import io
def divides(b: Int, a: Int) -> Bool:
    a / b * b == a
def word(k: Int) -> String:
    three = if divides(3, k) then "Fizz" else ""
    five = if divides(5, k) then "Buzz" else ""
    if three ++ five == "" then string(k) else three ++ five
n = int(io.read_line())
for k in range(n):
    print(word(k + 1))
