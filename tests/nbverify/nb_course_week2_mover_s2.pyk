import tinyweb as tw
import tinyweb.color as color
tw.web_init(0)
c = tw.canvas(100, 100)
var x = 50

def move(by: Int) -> ():
    x := x + by
    tw.clear(c, color.white)
    tw.circle(c, x, 50, 5, fill = color.black)
    print(x)

def left():
    move(-10)

def right():
    move(10)

tw.circle(c, 50, 50, 5)
tw.button("Left", on_click = left)
tw.button("Right", on_click = right)
