# Only the first name is greeted.
import tinyweb as tw

shown = tw.label("Who are you?")
var greeted = false

def greet(name: String):
    if greeted == false:
        tw.set_text(shown, "Hello, " ++ name ++ "!")
        print("Hello, " ++ name ++ "!")
        greeted := true

tw.text_input("your name", on_enter = greet)
