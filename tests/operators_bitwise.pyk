# The bitwise operators on Ints: `&`, `|`, `xor`, `~`, `<<` and `>>`,
# and the words `and`, `or` and `not`, which are bitwise on two Ints
# (design/steps.md, step 2).

flags = 0b0101
print(flags & 0b0100, flags | 0b0010, flags xor 0b1111, ~flags)
print(12 and 10, 12 or 10, not 0, not -1)
print(12 & 10, 12 | 10, 12 xor 10, ~0)

# Shifts; `>>` keeps the sign on every target.
print(1 << 4, 256 >> 2, -8 >> 1, -1 >> 3, 5 << 0)

# Python's precedence: tighter than a comparison, `|` loosest, then
# `xor`, then `&`, then the shifts, all looser than `+`.
print(flags & 4 == 4, flags & 2 == 0)
print(1 | 2 xor 3 & 6)
print(1 << 2 + 1, (1 << 2) + 1)
# The words keep their own, looser, level on Ints too.
print((flags and 4) == 4, (flags or 2) == 7)

# A mask built up and taken apart again.
def bit(n: Int) -> Int: 1 << n


mask = bit(0) | bit(3) | bit(5)
print(mask, [n for n in range(8) if mask & bit(n) != 0])
print(mask xor mask, mask & ~bit(3))
