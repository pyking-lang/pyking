# `as` patterns: the whole value a pattern matched, bound beside what
# the pattern takes apart.

datatype Shape:
    Dot
    Line(length: Int)
    Box(Int, Int)


def describe(s: Shape) -> String:
    match s:
        case Dot as d: "a dot: " ++ string(d)
        case Line(n) as l if n > 10: "a long " ++ string(l)
        case (Line(_) | Box(_, _)) as other: "a shape: " ++ string(other)


print(describe(Dot))
print(describe(Line(20)))
print(describe(Line(2)))
print(describe(Box(1, 2)))


def dedupe(xs: [Int]) -> [Int]:
    match xs:
        case [a, b, ..rest] if a == b: dedupe([b] ++ rest)
        case [a, ..rest] as whole if len(whole) > 0: [a] ++ dedupe(rest)
        case _: []


print(dedupe([1, 1, 2, 3, 3, 3, 1]))


def pairs(xs: [(Int, Int)]) -> [String]:
    match xs:
        case [((a, b) as p), ..rest]:
            [string(p) ++ "=" ++ string(a + b)] ++ pairs(rest)
        case []: []


print(pairs([(1, 2), (3, 4)]))
match (1, (2, 3)):
    case (x, (y, z) as inner) as whole:
        print(x, y, z, inner, whole)
