# Guards: `case pattern if condition`, asked after the pattern has
# matched, with what the pattern bound in scope. A false guard goes on
# to the next case.

def sign(n: Int) -> String:
    match n:
        case 0: "zero"
        case n if n > 0: "positive"
        case _: "negative"


print(sign(5), sign(0), sign(-5))


def classify(p: (Int, Int)) -> String:
    match p:
        case (x, y) if x == y: "diagonal"
        case (x, y) if x > y: "below"
        case _: "above"


print(classify((2, 2)), classify((3, 1)), classify((1, 3)))


def fizz(n: Int) -> String:
    match (n / 3 * 3 == n, n / 5 * 5 == n):
        case (true, true): "FizzBuzz"
        case (true, _): "Fizz"
        case (_, true): "Buzz"
        case _: string(n)


print([fizz(n) for n in range(1, 16)])

# A guard that calls a function -- which prints, so the order the guards
# are asked in shows.
def big(n: Int) -> Bool:
    print("asking about", n)
    return n > 10


def size(n: Int) -> String:
    match n:
        case 0: "none"
        case n if big(n): "big"
        case n if big(n * 2): "medium"
        case _: "small"


print(size(20))
print(size(7))
print(size(1))

# A guard sees what a string split bound.
def command(line: String) -> String:
    match line:
        case "say " + rest if len(rest) > 3: "long: " + rest
        case "say " + rest: "short: " + rest
        case _: "?"


print(command("say hello"), command("say hi"), command("bye"))

# The value of a guarded match, bound and returned.
def bucket(xs: [Int]) -> String:
    label = match xs:
        case []: "empty"
        case [x, ..] if x < 0: "starts negative"
        case [_, ..rest] if len(rest) > 2: "long"
        case _: "short"
    return label


print(bucket([]), bucket([-1, 2]), bucket([1, 2, 3, 4]), bucket([1]))
