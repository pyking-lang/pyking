# printing_quotes.pyk's question asked through `string`, which follows
# print's own formatting rules (builtin.ml). Split out because it takes
# `string` of a list and a tuple, which the C and Java backends refuse.

print(string(["it's"]))
print(string("it's"))
print(string(("a\nb", 2)))
print(string([["a'b"]]))
print(string([1, 2]))
print(string(()))

# A string built at run time rather than written as a literal, so
# nothing can decide its spelling from the source form alone.
def apostrophe(word: String) -> String:
    return word + "'s"


print([apostrophe("cat")])
print(string([apostrophe("dog")]))
