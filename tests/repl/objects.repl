use objects, mutation
class Counter(var count: Int = 0):
    def tick(self):
        self.count += 1
    def show(self) -> String:
        "counted " + string(self.count)

c = Counter()
c.tick()
c.tick()
c.count
c
print(c)
class Counter(var count: Int = 10):
    def tick(self):
        self.count += 2

d = Counter()
d.tick()
d.count
