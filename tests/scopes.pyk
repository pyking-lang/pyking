# Accumulating across iterations is a *mutation*: the name has to outlive
# the loop body, so it is declared with `var` and updated with `:=`. An
# `=` binding inside the body would instead bind a fresh name local to
# that body, leaving the outer one untouched.

use mutation

var x = 0
var y = 0
z = 0

for i in range(10):
    k = 5
    x := x + k

    for j in range(3):
        y := x + 1 + y

# `z` is immutable, so this is not an update but a new binding that
# shadows the one above -- allowed, and the only name visible from here on.
z = 7

print(x, y, z)
