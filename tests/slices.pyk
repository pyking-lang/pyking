# Slices and views. `s[i:j]` copies elements i up to j of a list, a
# String (by character), an array, a DynArray or a view into a new value of
# its own kind -- a view's into an array -- with either bound left out
# for the start or the end. `view(a, i, j)` shares elements i up to j of
# an array: reading and writing it reads and writes the array.
# `copy_into(dst, src)` copies as memmove does, right where the two
# overlap. Every target prints the same.

use mutation

xs = [1, 2, 3, 4, 5]
s = "héllo"
print(xs[1:3], xs[:2], xs[3:], xs[:], xs[5:], xs[2:2])
print(s[1:4], s[:1], s[4:], len(s[1:]))

a = array([10, 20, 30, 40, 50])
v = dynarray(["a", "b", "c"])
copied = a[1:3]
copied[0] := 99
print(copied, a, v[1:], v[:0])

# A view shares the array's elements.
w = view(a, 1, 4)
w[0] := 21
w[2] += 1
print(w, len(w), w[1], a)
inner = view(w, 1, 3)
inner[1] := 0
print(inner, w, a, w[1:])
for x in w:
    print("walk", x)
print([x * 2 for x in w], same(w, w), same(w, view(a, 1, 4)))

# copy_into: the first len(src) elements of dst are src's, even where
# the two overlap.
b = array([1, 2, 3, 4, 5, 6])
copy_into(view(b, 2, 6), view(b, 0, 4))
print(b)
c = array([1, 2, 3, 4, 5, 6])
copy_into(c, view(c, 2, 6))
print(c)
copy_into(view(c, 4, 6), array([7, 8]))
print(c)

# A view of a view of nothing.
empty = view(a, 5, 5)
print(empty, len(empty), a[5:])
