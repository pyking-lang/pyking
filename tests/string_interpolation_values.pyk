# Interpolating lists, tuples, Options and datatypes: each is shown the
# way `print` shows it. `${a, b}` is the tuple `(a, b)`.

datatype Shape:
    Circle(r: Float)
    Square(side: Float)

xs = [1, 2, 3]
pair = (1, "one")
print("xs = $xs, pair = $pair")
print("tuple ${1, 'c', "s"} and ${(2, 3)}")
print("nested ${[[1], []]} and ${[(1, true)]}")
print("shape ${Circle(1.5)} and ${Some(3)}")
print("strings in a list are quoted: ${["a", "b"]}")
print("${len(xs)} items, the first ${xs[0]}")
