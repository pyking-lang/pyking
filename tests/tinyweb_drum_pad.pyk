# A drum pad: three pads on a canvas, played by clicking them or by the
# keys k, s and h. A pad lights up while its drum sounds.

import tinyweb as tw
import tinyweb.color as color

tw.web_init(0)
kick = tw.load_sample("kick1.wav")
snare = tw.load_sample("snare1.wav")
hihat = tw.load_sample("hihat1.wav")

c = tw.canvas(330, 120)
tw.label("Click a pad, or press k, s or h.")
shown = tw.label("")

def pad_color(k: Int) -> color.Color:
    match k:
        case 0: color.hex(0xe63946)
        case 1: color.hex(0x457b9d)
        case _: color.hex(0x2a9d8f)

def pad_name(k: Int) -> String:
    match k:
        case 0: "kick"
        case 1: "snare"
        case _: "hihat"

def draw(lit: Int):
    tw.clear(c, color.hex(0x1d3557))
    for k in range(3):
        fill = if k == lit then color.white else pad_color(k)
        tw.rect(c, 10 + k * 110, 10, 90, 100, fill, radius = 12)
        tw.text(c, 55 + k * 110, 60, pad_name(k), color.hex(0x1d3557), 18,
                align = "center", baseline = "middle", bold = true)

def hit(k: Int):
    match k:
        case 0: tw.play(kick)
        case 1: tw.play(snare, volume = 0.8)
        case _: tw.play(hihat, volume = 0.5)
    tw.set_text(shown, pad_name(k))
    tw.after(0.15, unlit)
    draw(k)

def unlit():
    draw(-1)

# The pad at x, or -1 between pads.
def pad_at(x: Int) -> Int:
    k = (x - 10) / 110
    on_pad = x - 10 - k * 110 < 90
    inside = if x < 10 then false else if k > 2 then false else on_pad
    if inside then k else -1

def clicked(x: Int, y: Int):
    k = pad_at(x)
    if k >= 0:
        hit(k)

def pressed(key: String):
    if key == "k":
        hit(0)
    else if key == "s":
        hit(1)
    else if key == "h":
        hit(2)

draw(-1)
tw.on_click(c, clicked)
tw.on_key(pressed)
