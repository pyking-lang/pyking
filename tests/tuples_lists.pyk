pairs = [(1, 2), (3, 4), (5, 6)]

var total = 0
for p in pairs:
    (a, b) = p
    total := total + a + b
print(total)


def first_elements(ps) -> [Int]:
    return loop out = [] for p in ps:
        (first, _) = p
        out ++ [first]


print(first_elements(pairs))

named = [("x", 1), ("y", 2)]
for entry in named:
    (name, value) = entry
    print(name, value)
