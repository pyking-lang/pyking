digits: String = string(42)
label: String = "n = " + string(7)
size: Int = len("hello")
numbers: [Int] = range(4)
counted: Int = len(range(4))
total: Int = size + counted
same: Bool = string(1) == "1"
long_enough: Bool = len("abc") > 2
print(string(size), len("xyz"), range(2))
def describe(n:Int) -> String:
    "value " + string(n)
print(describe(total), describe(counted))
def nothing(n:Int) -> ():
    ignored: Int = n
print(nothing(1))
