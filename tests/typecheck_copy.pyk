# copy and deepcopy are checked as (T) -> T, and the pyking target
# writes them back as they were written.
use mutation

mutable struct Box(items: Array(Int))

def twin(b: Box) -> (Box, Box):
    (copy(b), deepcopy(b))

b = Box(array([1, 2]))
(shallow, deep) = twin(b)
shallow.items[0] := 10
deep.items[1] := 20
print(b, shallow, deep)
n: Int = copy(3)
xs: [Int] = deepcopy([n])
print(xs, copy(deepcopy("both")))
