base: Int = 2
def slice___default__lst() -> [Int]:
    [1, 4, 70 + 10]
def slice___default__size() -> Int:
    base * 3
def slice_(lst:[Int], size:Int) -> Int:
    total: Int = loop acc: Int = 0 for value in lst:
        acc + value
    return total + size
print(slice_(slice___default__lst(), slice___default__size()))
print(slice_([5], slice___default__size()))
print(slice_(slice___default__lst(), 7))
print(slice_([2, 3], 1))
def pair__default__both() -> (Int, String):
    (1, 'a')
def pair(both:(Int, String)) -> String:
    match both:
        case (n, text):
            if n > 5:
                return text + '!'
            return text
print(pair(pair__default__both()))
print(pair((9, 'z')))
def countdown__default__sofar() -> [Int]:
    []
def countdown(n:Int, sofar:[Int]) -> [Int]:
    loop (n, sofar): (Int, [Int]) = (n, sofar):
        if n <= 0:
            return sofar
        (n - 1, sofar + [n])
print(countdown(4, countdown__default__sofar()))
print(countdown(2, [99]))
sum_: Int = loop acc: Int = 0 for i in range(4):
    def add__default__n() -> Int:
        i
    def add(n:Int) -> Int:
        return n * 10
    acc + add(add__default__n())
print(sum_)
def bumped(value:Int, by:Int) -> Int:
    return value + by
print([bumped(v, 2) for v in [1, 2, 3]])
print([bumped(v, 10) for v in [1, 2, 3]])
