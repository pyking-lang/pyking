base = 2
def slice_(lst:[Int] = [1, 4, 70 + 10], size:Int = base * 3) -> Int:
    total = loop acc = 0 for value in lst:
        acc + value
    return total + size
print(slice_())
print(slice_([5]))
print(slice_(size = 7))
print(slice_([2, 3], 1))
def pair(both:(Int, String) = (1, 'a')) -> String:
    match both:
        case (n, text):
            if n > 5:
                return text + '!'
            return text
print(pair())
print(pair((9, 'z')))
def countdown(n:Int, sofar:[Int] = []) -> [Int]:
    if n <= 0:
        return sofar
    return countdown(n - 1, sofar + [n])
print(countdown(4))
print(countdown(2, [99]))
sum_ = loop acc = 0 for i in range(4):
    def add(n:Int = i) -> Int:
        return n * 10
    acc + add()
print(sum_)
def bumped(value:Int, by:Int = 2) -> Int:
    return value + by
print([bumped(v) for v in [1, 2, 3]])
print([bumped(v, by = 10) for v in [1, 2, 3]])
