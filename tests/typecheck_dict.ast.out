use mutation
datatype Pos:
    Pos(row: Int, col: Int)
board: Dict(Pos, Char) = empty::dict()
board[Pos(row = 0, col = 0)] := 'x'
scores: Dict(String, Int) = list::dict([("ada", 3), ("bo", 1)])
scores["cy"] := scores["ada"] + get(scores, "dee", 0)
def winners(s:Dict(String, Int)) -> [String]:
    [name for name in s if s[name] > 1]
pairs: [(String, Int)] = items(scores)
print(winners(scores), keys(board), has(board, Pos(row = 1, col = 1)), pairs == [("ada", 3), ("bo", 1), ("cy", 3)])
print(remove(scores, "bo"), values(scores), Pos(row = 0, col = 0) == Pos(row = 0, col = 0), (1, [2.5]) != (1, [2.5]))
