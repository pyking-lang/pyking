# `/` is integer division, truncating toward zero.
#
# Pyking has no floating-point type, so `/` answers an Int like `+`,
# `-` and `*` do. Truncation is toward *zero*, not downward: `-7 / 2`
# is -3, where a language that floors would say -4. C, Java and OCaml
# divide this way natively; Python's `//` floors, so that backend
# corrects the sign, and JavaScript's `/` is float division, so that one
# truncates the quotient.

def half(n:Int) -> Int:
    return n / 2


def average(a:Int, b:Int) -> Int:
    return (a + b) / 2


# Both operands positive.
print(7 / 2, 6 / 3, 1 / 2, 0 / 5)

# One operand negative, either way round: the quotient is negative and
# truncates toward zero, so it is never more negative than the exact
# answer.
print((0 - 7) / 2, 7 / (0 - 2))
print((0 - 6) / 3, 6 / (0 - 3))

# Both negative: the quotient is positive again.
print((0 - 7) / (0 - 2))

# `/` binds as tightly as `*`, and both bind tighter than `+`.
print(1 + 6 / 2, (1 + 6) / 2, 2 * 6 / 4, 6 / 2 * 3)

print(half(9), half(0 - 9))
print(average(3, 4), average(0 - 3, 0 - 4))
