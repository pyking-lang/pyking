use mutation
names: DynArray(String) = empty::dynarray()
push(names, "ada")
insert(names, 0, "bo")
counts: DynArray(Int) = list::dynarray([1, 2, 3])
element__array: DynArray(Int) = counts
element__index: Int = 0
element__array[element__index] += len(names)
def total(xs:DynArray(Int)) -> Int:
    var sum = 0
    for x in xs:
        sum += x
    sum
last: Int = pop(counts)
first: String = remove(names, 0)
clear(names)
print(total(counts), last, first, names, same(counts, counts), len(list::dynarray(["x"])))
