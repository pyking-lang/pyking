# DynArrays under the type checker. `DynArray(T)` is a type of its own: `dynarray()`
# takes its element type from its use, `dynarray(xs)` from the list, `push`
# and `insert` take an element and `pop` and `remove` give one, and an
# element is read and written by index. The `.ast.out` pins the types
# worked out, and every call names the form it resolved to.

use mutation

names: DynArray(String) = dynarray()
push(names, "ada")
insert(names, 0, "bo")
counts = dynarray([1, 2, 3])
counts[0] += len(names)


def total(xs: DynArray(Int)) -> Int:
    var sum = 0
    for x in xs:
        sum += x
    sum


last = pop(counts)
first = remove(names, 0)
clear(names)
print(total(counts), last, first, names, same(counts, counts), len(list::dynarray(["x"])))
