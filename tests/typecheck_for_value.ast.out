def first_big(xs:[Int]) -> Int:
    return loop found: Int = 0 - 1 for x in xs:
        if found > 0:
            break
        else if x > 10:
            x
        else:
            found
def any_of(xs:[Int]) -> Bool:
    return loop seen: Bool = false for x in xs:
        if x == 3:
            true
        else:
            seen
def label(words:[String]) -> String:
    return loop first: String = "none" for w in words:
        if first == "none":
            w
        else:
            break
def shout(xs:[Int]) -> String:
    nothing: () = for x in xs:
        if x < 0:
            break
        "whatever this is"
    return "done"
for x in [1, 2, 3]:
    print(x)
print(first_big([1, 20, 3]), first_big([1, 2]))
print(any_of([1, 3]), any_of([1, 2]))
print(label(["a", "b"]), label([]))
print(shout([1, 0 - 1]))
