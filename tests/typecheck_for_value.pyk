# `for` as a loop that is worth something.
#
# A `for` is a loop with no accumulator written, so it takes the same
# `break`, `continue` and `result` every loop does. What it is worth
# follows the one rule: the `result` expression if there is one, else
# the accumulator if there is one, else unit -- and a `for` with no
# accumulator has none, which is why one that breaks with a value needs
# a `result` (see fail_typecheck_for_no_value.pyk).

def first_big(xs:[Int]) -> Int:
    return for x in xs result 0 - 1:
        if x > 10:
            break x


def any_of(xs:[Int]) -> Bool:
    return for x in xs result false:
        if x == 3:
            break true


def label(words:[String]) -> String:
    return for w in words result "none":
        break w


# Without a `result` a `for` is worth unit, so a bare `break` fits and
# the body is free to end in anything at all.
def shout(xs:[Int]) -> String:
    nothing = for x in xs:
        if x < 0:
            break
        "whatever this is"
    return "done"


# The statement form takes no value at all, and needs none of this.
for x in [1, 2, 3]:
    print(x)

print(first_big([1, 20, 3]), first_big([1, 2]))
print(any_of([1, 3]), any_of([1, 2]))
print(label(["a", "b"]), label([]))
print(shout([1, 0 - 1]))
