# `for` as a loop that is worth something.
#
# A `for` is a loop with no accumulator written, so it takes the same
# `break` and `continue` every loop does and is worth unit. Write an
# accumulator on it -- `loop found = 0 for x in xs:` -- and it is worth
# that instead: what the body ends in on the turn it stops on.

def first_big(xs:[Int]) -> Int:
    # The answer is carried, so the loop keeps the first one it found
    # and stops on the turn after it.
    return loop found = 0 - 1 for x in xs:
        if found > 0:
            break
        else if x > 10:
            x
        else:
            found


def any_of(xs:[Int]) -> Bool:
    return loop seen = false for x in xs:
        if x == 3:
            true
        else:
            seen


def label(words:[String]) -> String:
    return loop first = "none" for w in words:
        if first == "none":
            w
        else:
            break


# With no accumulator a `for` is worth unit, so its body is free to end
# in anything at all.
def shout(xs:[Int]) -> String:
    nothing = for x in xs:
        if x < 0:
            break
        "whatever this is"
    return "done"


# The statement form takes no value at all, and needs none of this.
for x in [1, 2, 3]:
    print(x)

print(first_big([1, 20, 3]), first_big([1, 2]))
print(any_of([1, 3]), any_of([1, 2]))
print(label(["a", "b"]), label([]))
print(shout([1, 0 - 1]))
