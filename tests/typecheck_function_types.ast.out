def inc(n:Int) -> Int:
    return n + 1
def is_small(n:Int) -> Bool:
    return n < 10
def apply(f:(Int) -> Int, x:Int) -> Int:
    return f(x)
def apply_twice(f:(Int) -> Int, x:Int) -> Int:
    return f(f(x))
def combine(f:(Int, Bool) -> Int, n:Int, keep:Bool) -> Int:
    return f(n, keep)
def choose(a:Int, keep:Bool) -> Int:
    if keep:
        return a
    else:
        return 0
def pick(keep:Bool) -> (Int) -> Int:
    return inc
def nested(pair:((Int) -> Int, Int), fs:[(Int) -> Int]) -> Int:
    return 1
def higher(f:((Int) -> Int) -> Int) -> Int:
    return 1
def pair_taker(p:((Int, Bool)) -> Int) -> Int:
    return 2
stepper: (Int) -> Int = inc
one: Int = apply(inc, 1)
two: Int = apply(stepper, 1)
three: Int = apply_twice(inc, 1)
four: Int = combine(choose, 7, true)
five: Int = apply(pick(true), 1)
def guard(f:(Int) -> Bool, x:Int) -> Bool:
    return f(x)
small: Bool = guard(is_small, 3)
print(one, two, three, four, five, small)
