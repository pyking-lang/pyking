def identity(x:a) -> a:
    x
def use_it : ((all a. (a) -> a)) -> ()
def use_it(f):
    print(f(1), f(true))
def describe : ((all a. (a) -> a)) -> ()
def describe(f):
    print(f("x"), f(2))
def extract : (((all a. (a) -> a)) -> b) -> b
def extract(packed):
    packed(identity)
def pack_int : ((all a. (a) -> a)) -> Int
def pack_int(k):
    k(41)
def pack_string : ((all a. (a) -> a)) -> String
def pack_string(k):
    k("hello")
use_it(identity)
describe(identity)
print(extract(pack_int), extract(pack_string))
same: (a) -> a = identity
