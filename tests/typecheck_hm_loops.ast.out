def collect(lst:[a]) -> [a]:
    loop kept: [a] = [] for x in lst:
        kept + [x]
def total(lst:[Int]) -> Int:
    loop sum: Int = 0 for n in lst:
        sum + n
def any_of(lst:[a], ok:(a) -> Bool) -> Bool:
    loop found: Bool = false for x in lst:
        if ok(x):
            true
        else:
            found
def big(n:Int) -> Bool:
    n > 1
def long_word(w:String) -> Bool:
    len(w) > 2
print(collect([1, 2, 3]))
print(collect(['a', 'b']))
print(total([1, 2, 3]))
print(any_of([1, 2], big), any_of(['ab'], long_word))
collecting: ([a]) -> [a] = collect
anything: ([a], (a) -> Bool) -> Bool = any_of
