# Loops, whose accumulator is worked out the same way everything else is.
#
# A `loop`'s accumulator and what its body ends in are one type, which
# unification settles -- including where the accumulator starts as `[]`
# and the body is what says what it holds. Nothing here is
# special-cased: it is the same rule two branches of an `if` obey.
#
# `collect` is the one that needed a second pass over the body before:
# its accumulator starts empty, and only the body says what goes into
# it. Now the empty list's element is simply a type nothing has
# decided, and the body decides it.

def collect(lst):
    loop kept = [] for x in lst:
        kept + [x]

def total(lst):
    loop sum = 0 for n in lst:
        sum + n

def any_of(lst, ok):
    loop found = false for x in lst:
        if ok(x):
            true
        else:
            found

def big(n): n > 1

def long_word(w): len(w) > 2

print(collect([1, 2, 3]))
print(collect(["a", "b"]))
print(total([1, 2, 3]))
print(any_of([1, 2], big), any_of(["ab"], long_word))

collecting = collect
anything = any_of
