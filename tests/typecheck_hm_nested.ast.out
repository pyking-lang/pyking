def outer(n:a) -> (a, Bool, a, a):
    def pick(x:a, y:b) -> a:
        x
    def later(lst:[?]):
        match lst:
            case [x, ..]:
                x
            case []:
                n
    (pick(n, 'ignored'), pick(true, 1), later([]), later([n]))
def plain(n:a) -> ((a, a), (a, a)):
    def twice_over(x:a) -> (a, a):
        (x, x)
    twice_over(twice_over(n))
print(outer(3))
print(outer('three'))
print(plain(1))
print(plain('one'))
