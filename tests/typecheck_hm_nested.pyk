# Definitions inside definitions, each generalised in its own scope.
#
# `outer`'s `pick` names nothing from around it, so it is generalised
# exactly as a top-level `def` would be and serves both of its uses.
# `later` does the same one level further in.
#
# What none of them may do is generalise over `outer`'s own parameter --
# that belongs to whoever called `outer`. `hold` below reads it, so its
# type is not a scheme, which is why the printed AST gives it no
# annotation: there is no way to write "the type my enclosing function
# was called at", and printing a variable there would claim more than
# is true.

def outer(n):
    def pick(x, y): x
    def later(lst):
        match lst:
            case [x] ++ _: x
            case []: n
    (pick(n, 'ignored'), pick(true, 1), later([]), later([n]))

def plain(n):
    def twice_over(x): (x, x)
    twice_over(twice_over(n))

print(outer(3))
print(outer('three'))
print(plain(1))
print(plain('one'))
