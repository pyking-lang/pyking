def id(x:a) -> a:
    x
def first_shape(f:(a) -> b, lst:[a]) -> [b]:
    match lst:
        case [x, ..xs]:
            [f(x)] ++ first_shape(f, xs)
        case []:
            []
def second_shape(f:(a) -> b, lst:[a]) -> [b]:
    match lst:
        case [x, ..xs]:
            [f(x)] ++ second_shape(f, xs)
        case []:
            []
def double(n:Int) -> Int:
    n * 2
print(first_shape(id, [1, 2]))
print(first_shape(double, [3, 4]))
print(second_shape(double, [3, 4]))
print(second_shape(id, [1, 2]))
first_type: ((a) -> b, [a]) -> [b] = first_shape
second_type: ((a) -> b, [a]) -> [b] = second_shape
