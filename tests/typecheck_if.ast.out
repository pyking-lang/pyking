flag: Bool = 3 < 4
same: Bool = 2 == 2
never: Bool = false
if flag:
    a: Int = 1
else:
    b: String = 'two'
if same:
    c: Int = 3
best: Int = if flag:
    1
else:
    2
greeting: String = if never:
    'hello'
else:
    'goodbye'
grade: String = if 1 < 2:
    'a'
else if 2 < 3:
    'b'
else:
    'c'
nested: Int = if flag:
    if same:
        10
    else:
        20
else:
    30
if flag:
    d: String = 'inside the branch'
else:
    d: String = 'the other branch'
d: Int = 0
total: Int = if flag:
    step: Int = 6
    step * 7
else:
    0
print(flag, same, never)
print(best, greeting, grade, nested, d, total)
