def bar(a:Int, f:(Int, implicit my: Int) -> Int) -> Int:
    my: Int = 7
    f(a + 1, my)
def foo(x:Int, my:Int) -> Int:
    x + my
print(bar(7, foo))
def int__twice(x:Int) -> Int:
    x * 2
def string__twice(x:String) -> String:
    x ++ x
def applied(v:Int) -> Int:
    int__twice(v * 1)
print(applied(4))
my: Int = 10
def unannotated(a:Int, f:(Int) -> a) -> a:
    f(a + 1)
def adds(x:Int, my:Int) -> Int:
    x + my
print(unannotated(7, (__implicit__1:Int) => adds(__implicit__1, my)))
unit: Int = 10
def scaled(n:Int, unit:Int) -> Int:
    n * unit
def twice_scaled(n:Int) -> Int:
    scaled(n, unit) + scaled(n, unit)
print(twice_scaled(3))
