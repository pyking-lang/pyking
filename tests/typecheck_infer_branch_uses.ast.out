def identity(x):
    x
def use(f:((Int) -> Int) | ((String) -> String), first:Bool) -> ():
    if first:
        print(f(1))
    else:
        print(f('x'))
def label(f:((Int) -> Int) | ((String) -> String), first:Bool) -> String:
    if first then str(f(2)) else f('y')
use(identity, true)
print(label(identity, true), label(identity, false))
both: (((Int) -> Int) | ((String) -> String), Bool) -> () = use
labelled: (((Int) -> Int) | ((String) -> String), Bool) -> String = label
same: ((Int) -> Int) | ((String) -> String) = identity
