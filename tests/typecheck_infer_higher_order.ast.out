def apply_twice(f:(a) -> a, x:a) -> a:
    f(f(x))
def add_one(n:Int) -> Int:
    n + 1
def repeat(word:String) -> String:
    word ++ word
print(apply_twice(add_one, 5))
print(apply_twice(repeat, 'ab'))
def apply_once(f:(Int) -> Int, x:Int) -> Int:
    f(x)
print(apply_once(add_one, 10))
applied: ((a) -> a, a) -> a = apply_twice
