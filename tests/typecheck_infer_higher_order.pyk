# Functions passed to functions, with nothing written down.
#
# An unannotated function passed as an argument is not guessed at: it
# travels as the incomplete thing it is, and is worked out where it is
# finally *called*, inside the body that received it. So `apply_twice`
# below is checked once per shape of use, and `add_one` is checked when
# `f(f(x))` calls it -- not when it is handed over.

def apply_twice(f, x):
    f(f(x))

def add_one(n):
    n + 1

def repeat(word):
    word ++ word

print(apply_twice(add_one, 5))
print(apply_twice(repeat, 'ab'))

# A parameter whose function type *is* written down is a claim about
# what may be passed, and an unannotated function may still satisfy it:
# whatever both sides know is compared, and what neither knows is left
# to the call inside the body.
def apply_once(f:(Int) -> Int, x:Int) -> Int:
    f(x)

print(apply_once(add_one, 10))

# `apply_twice` was used two ways, and its type is both of them -- with
# each call's function, argument and result kept together.
applied = apply_twice
