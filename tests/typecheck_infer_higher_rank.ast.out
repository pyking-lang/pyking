def double(n:Int) -> Int:
    n * 2
def show(n:Int) -> String:
    str(n) + '!'
def apply_to_two(f):
    f(2)
print(apply_to_two(double), apply_to_two(show))
def id(x):
    x
def extract(packed):
    packed(id)
def pack_int(k:(Int) -> Int) -> Int:
    k(41)
def pack_string(k:(String) -> String) -> String:
    k('hello')
print(extract(pack_int), extract(pack_string))
identity: ((Int) -> Int) | ((String) -> String) = id
extracted: ((((Int) -> Int) -> Int) -> Int) | ((((String) -> String) -> String) -> String) = extract
packed_int: ((Int) -> Int) -> Int = pack_int
packed_string: ((String) -> String) -> String = pack_string
applied: (((Int) -> Int) -> Int) | (((Int) -> String) -> String) = apply_to_two
