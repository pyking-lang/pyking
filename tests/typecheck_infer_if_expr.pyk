# `if … then … else …` as an expression, checked and inferred.
#
# The expression form always yields a value -- its `else` is mandatory,
# unlike the statement's -- so its branches must agree on a type, and
# that type is the expression's. Everything else about it is ordinary:
# it is checked where any expression is, and a function written with one
# is inferred from its calls like any other.
#
# The recursive one-liner is the shape that made this necessary: the
# recursion sits in a *branch of an expression*, so the trace that
# cannot type it has to be abandoned there. A first version of the
# inference only knew how to do that in an `if` statement, and this
# program could not be checked at all.

def fact(n): if n <= 1 then 1 else fact(n - 1) * n

def sign(n): if n < 0 then 'negative' else 'not negative'

# Nested, and used as an ordinary subexpression.
def grade(n): if n > 89 then 'a' else if n > 79 then 'b' else 'c'

def announce(n): 'grade ' + grade(n) + (if n > 89 then '!' else '')

# In a binding, and in an argument.
flag = 3 < 4
picked = if flag then 10 else 20
doubled = fact(if flag then 3 else 4)

# An annotated function is checked where it is written, and the
# expression form is checked there like anything else.
def clamp(n:Int, hi:Int) -> Int: if n > hi then hi else n

print(fact(7), sign(0 - 2), sign(2))
print(grade(95), grade(85), grade(20))
print(announce(95), announce(60))
print(picked, doubled, clamp(9, 5), clamp(2, 5))
