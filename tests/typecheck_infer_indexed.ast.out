use mutation
def vec_add(v1:Array(Int), v2:Array(Int)) -> Array(Int):
    res: Array(Int) = fill::array(len(v1), 0)
    for i in range(len(v1)):
        res[i] := v1[i] + v2[i]
    return res
vec1: Array(Int) = list::array([2, 5, 7])
vec2: Array(Int) = list::array([3, 4, 2])
print(vec_add(vec1, vec2))
def first_of(xs:[a]) -> a:
    xs[0]
print(first_of([1, 2]), first_of(["a", "b"]))
def initial(s:String) -> Char:
    s[0]
print(initial("hello"), initial("world") == 'w')
def total(xs:DynArray(Int)) -> Int:
    var sum = 0
    for x in xs:
        sum := sum + x
    sum
print(total(list::dynarray([1, 2, 3])))
def zero_first(xs:Slice(Int)) -> ():
    xs[0] := 0
a: Array(Int) = list::array([5, 6, 7])
zero_first(view(a, 1, 3))
print(a)
def rest(xs:Array(a)) -> Array(a):
    xs[1:]
print(rest(list::array([1, 2, 3])))
def doubled(xs:Array(Int)) -> [Int]:
    [x * 2 for x in xs]
print(doubled(list::array([4, 5])))
def shift(xs:DynArray(a)) -> ():
    for i in range(len(xs) - 1):
        xs[i] := xs[i + 1]
d: DynArray(Int) = list::dynarray([1, 2, 3])
shift(d)
print(d)
def second(xs:Array(a)) -> a:
    xs[1]
take: (Array(a)) -> a = second
print(take(list::array([8, 9])))
def last_of(xs:[a]) -> a:
    xs[len(xs) - 1]
print(len([last_of]))
