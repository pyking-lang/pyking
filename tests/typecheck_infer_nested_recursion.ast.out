def f33(x:Int) -> Int:
    if x < 10:
        if x >= 10:
            if x < 10:
                f33(x + 1)
            else:
                f33(x + 1)
        else if x < 10:
            f33(x + 1)
        else:
            f33(x + 1)
    else if x < 10:
