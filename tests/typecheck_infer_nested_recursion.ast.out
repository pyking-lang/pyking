def f1(x:Int) -> Int:
    if x >= 10:
        1000 + x
    else:
        f1(x + 1)
print(f1(0))
def f2(x:Int) -> Int:
    if x < 10:
        f2(x + 1)
    else:
        2000 + x
print(f2(0))
def f11(x:Int) -> Int:
    if x >= 10:
        if x >= 10:
            1100 + x
        else:
            f11(x + 1)
    else if x < 5:
        f11(x + 1)
    else:
        f11(x + 1)
print(f11(0))
