def render(value:Int | String) -> String:
    str(value)
print(render(1), render('two'))
def announce(value:Int | String | Bool) -> String:
    'value: ' + str(value)
print(announce(true), announce(7))
first: Int = 41
second: String = 'forty-two'
print(first, second)
def given(value):
    render(value)
print(given(3), given('four'))
