def combine(x, y):
    x + y
def wrap(value):
    if value == value:
        value
    else:
        value
added: Int = combine(1, 3)
joined: String = combine('hi', 'now')
kept: Bool = wrap(true)
counted: Int = wrap(7)
print(added, joined, kept, counted)
both: ((Int, Int) -> Int) | ((String, String) -> String) = combine
either: ((Bool) -> Bool) | ((Int) -> Int) = wrap
tripled: String = combine('a', 'b')
again: Int = combine(2, 2)
