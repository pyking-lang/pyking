# One function, several types -- and each one kept whole.
#
# A `def` with no annotations is checked once per shape of call, so a
# function called with two Ints and then with two Strings has *two*
# types. What it is, therefore, is both of them:
#
#     ((Int, Int) -> Int) | ((String, String) -> String)
#
# and not `(Int | String, Int | String) -> Int | String`, which would be
# a different and much weaker claim -- it would say an Int and a String
# may be mixed in one call, which the checker refuses (see
# fail_typecheck_infer_mixed.pyk). Parameters and result belong
# together, per call.
#
# The alternatives are parenthesised because `->` reaches past `|` in
# Pyking's type grammar: without them the type would read as one
# function returning `Int | ((String, String) -> String)`.

def combine(x, y): x + y

def wrap(value):
    if value == value:
        value
    else:
        value

added = combine(1, 3)
joined = combine('hi', 'now')
kept = wrap(true)
counted = wrap(7)

print(added, joined, kept, counted)

# Binding a function is how its whole type gets printed -- a `def` with
# several types is printed as it was written, since the syntax has one
# slot per parameter and no way to say which result goes with which.
both = combine
either = wrap

# A third shape adds a third alternative, and calls already checked cost
# nothing: their answers were remembered.
tripled = combine('a', 'b')
again = combine(2, 2)
