def fact(n:Int) -> Int:
    if n < 1:
        1
    else:
        n * fact(n - 1)
def sum_to(n:Int) -> Int:
    if n < 1:
        return 0
    return sum_to(n - 1) + n
def repeat(word:String, times:Int) -> String:
    if times < 1:
        ''
    else:
        word + repeat(word, times - 1)
def countdown(n:Int) -> String:
    if n < 1:
        return 'liftoff'
    return countdown(n - 1)
print(fact(5), sum_to(4))
print(repeat('ab', 3))
print(countdown(3))
