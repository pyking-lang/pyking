def echo(x):
    x
def announce(value):
    'got ' ++ str(value)
number: Int = echo(1)
word: String = echo('two')
flag: Bool = echo(true)
print(number, word, flag)
print(announce(1), announce(true), announce('x'))
again: Int = echo(3)
print(again + number)
same: ((Int) -> Int) | ((String) -> String) | ((Bool) -> Bool) = echo
told: ((Int) -> String) | ((Bool) -> String) | ((String) -> String) = announce
