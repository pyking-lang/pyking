def echo(x:a) -> a:
    x
def announce(value:Int) -> String:
    "got " + string(value)
number: Int = echo(1)
word: String = echo("two")
flag: Bool = echo(true)
print(number, word, flag)
print(announce(1), announce(2))
again: Int = echo(3)
print(again + number)
same: (a) -> a = echo
told: (Int) -> String = announce
