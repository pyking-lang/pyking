def area(width:Int, height:Int) -> Int:
    width * height
def announce(message:String) -> ():
    print('note: ' + message)
def spaced(word:String) -> String:
    padded: String = ' ' + word
    padded + ' '
def describe(n:Int) -> String:
    if n < 0:
        'negative'
    else if n == 0:
        'zero'
    else:
        'positive'
def clamp(n:Int, hi:Int) -> Int:
    if n > hi:
        return hi
    n
announce('starting')
print(area(3, 4), spaced('x') + '|')
print(describe(0), describe(7))
print(clamp(9, 5), clamp(2, 5))
