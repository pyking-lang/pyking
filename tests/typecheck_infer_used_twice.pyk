# A function used at two types *in one call*.
#
# What a call makes of a function it was given is every shape it used it
# at while checking that one body -- both of them here, and not merely
# whichever one was new. `identity` is deliberately called on its own
# first, so that by the time `use` is checked one of the two shapes is
# already known: a report built from "what this call worked out that
# nobody knew before" would have missed it and claimed `use` only ever
# takes a `(Bool) -> Bool`.

def identity(x): x

def use(f):
    a = f(42)
    b = f(true)
    print(a, b)

# The shape that has to be counted even though it is already known.
first = identity(1)
print(first)

use(identity)

# Two calls, two shapes each, and each call reports its own: `use` went
# through Int and Bool, `describe` through String and Int.
def describe(f):
    print(f('x'), f(2))

describe(identity)

# Bound so the printed AST shows the types: `identity` is all three
# shapes, and each of the two functions that used it only the two it
# used.
applied = use
described = describe
same = identity
