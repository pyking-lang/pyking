inc: (Int) -> Int = (x:Int) => x + 1
print(inc(1))
def on_text(f:(String) -> String) -> String:
    f('ab')
print(on_text((x:String) => x ++ '!'))
half: (Int) -> Int = (n:Int) => n / 2
print(half(9))
pair: (Int) -> (Int) -> Int = (a:Int) => (b:Int) => a * b
print(pair(6)(7))
def apply_twice(f:(Int) -> Int, n:Int) -> Int:
    f(f(n))
print(apply_twice((x:Int) => x * 3, 2))
def make(k:Int) -> (Int) -> Int:
    (x:Int) => x + k
print(make(100)(5))
