# The types a lambda is given.
#
# A lambda is lambda-bound and so monomorphic, whatever it is bound to
# afterwards: a parameter with no annotation is decided by the body and
# the uses between them, and never generalised. `def` is how a
# polymorphic function is written (PYKING.md, "Lambdas").

# Decided by the body: `+ 1` is Int arithmetic.
inc = x => x + 1
print(inc(1))

# Decided by the use: nothing in the body says what `x` is.
def on_text(f: (String) -> String) -> String: f("ab")
print(on_text(x => x ++ "!"))

# An annotation on a parameter is checked like any other.
half = (n: Int) => n / 2
print(half(9))

# A lambda answering with a lambda.
pair = (a: Int) => (b: Int) => a * b
print(pair(6)(7))

# One written where a function type is wanted, and one returned from a
# `def` whose return type says what it is.
def apply_twice(f: (Int) -> Int, n: Int) -> Int: f(f(n))
print(apply_twice(x => x * 3, 2))

def make(k: Int) -> (Int) -> Int: x => x + k
print(make(100)(5))
