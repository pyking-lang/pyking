# Lexical capture as the type checker sees it: a body is checked against
# the bindings visible *where it is written*, so rebinding a name later
# cannot change what an earlier function was checked as.
#
# That agreement is the point. The checker reads names statically; the
# backends resolve them where the program said, so what is checked here
# is what runs (see tests/lexical_capture.pyk, which runs it).
#
# This file is never run. The harness compiles it with
# `--typecheck --ast`, so the `.out` beside it is the printed AST.

# `show` is checked where `x` is an Int, and stays an `() -> Int` even
# though `x` becomes a String on the next line.
x = 1

def show() -> Int:
    x

x = "two"

# So this is fine: the later `x` is a String, and `show` still returns
# Int.
label = x ++ "!"
count = show() + 1

# A forward reference: `f` names `g`, written below, and `g` reads the
# binding of `y` visible where `g` is -- the second one.
y = 1

def f() -> Int:
    g()

y = 2

def g() -> Int:
    y

# Three generations, three functions, three checks against three
# different bindings of one name.
gen = 1

def first_gen() -> Int:
    gen

gen = "second"

def second_gen() -> String:
    gen

gen = true

def third_gen() -> Bool:
    gen

one = first_gen()
two = second_gen()
three = third_gen()

# A nested `def` may shadow an enclosing binding; inside it, the name
# means the function.
outer = 7

def uses_nested() -> Int:
    def outer() -> Int:
        5
    outer()

five = uses_nested()


print(label, count, one, two, three, five)
