# Case 1 -- leaving a loop.
#
# `loop:` and `loop acc = ...:` have no ending of their own: a `break`
# is the only way out. It takes no operand, because there is nothing
# left to say -- the loop is worth the accumulator the turn it stops on
# started with, and worth unit where it carries none. A loop with no
# `break` at all never ends, which is allowed.

def count_to(limit:Int) -> Int:
    # The accumulator is both what the loop carries and what it is
    # worth, so this answers with the count it stopped on.
    return loop i = 0:
        if i >= limit:
            break
        else:
            i + 1


def name_of(limit:Int) -> String:
    # A loop carrying a String is worth a String. The counting is done
    # by a `var` beside it, since only one thing is carried here.
    var i = 0
    return loop said = "waiting":
        if i >= limit:
            break
        i := i + 1
        "enough"


def nothing(limit:Int) -> ():
    # A loop with no accumulator carries nothing and is worth unit,
    # whatever its body ends in.
    var i = 0
    loop:
        if i >= limit:
            break
        i := i + 1


def spin() -> Int:
    # No `break` at all: this never ends, so nothing ever asks what it
    # is worth.
    loop n = 0:
        n + 1


def carried() -> (Int, String):
    # A loop carrying a pair is worth the pair.
    return loop n, s = 0, "":
        if n > 2:
            break
        else:
            (n + 1, s ++ "x")


print(count_to(3), count_to(0))
print(name_of(2))
print(nothing(2))
print(carried())
