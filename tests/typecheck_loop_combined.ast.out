def total(xs:[Int]) -> Int:
    return loop acc: Int = 0 for x in xs:
        acc + x
def joined(words:[String], sep:String) -> String:
    return loop text: String = '' for w in words:
        if text == '':
            w
        else:
            text + sep + w
def countdown(from_:Int) -> Int:
    return loop i: Int = from_ while i > 0:
        i - 1
def looked_at(xs:[Int], limit:Int) -> Int:
    return loop seen: Int = 0 for x in xs:
        if x > limit:
            break
        else:
            seen + 1
def indexed(xs:[String]) -> [(Int, String)]:
    (count, acc): (Int, [(Int, String)]) = loop (i, acc): (Int, [(Int, String)]) = (0, []) for x in xs:
        (i + 1, [(i, x)] + acc)
    return acc
print(total([1, 2, 3, 4]), total([]))
print(joined(['a', 'b', 'c'], '-'), joined([], '-'))
print(countdown(3))
print(looked_at([1, 5, 9], 4), looked_at([1, 2], 4))
print(indexed(['a', 'b', 'c']))
