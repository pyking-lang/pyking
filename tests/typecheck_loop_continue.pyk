# Case 2 -- going round.
#
# A loop that carries an accumulator carries what its body ends in: the
# body's last statement is the next turn's accumulator, and recursively
# each branch of a trailing `if` or `match`. A `break` or a `return`
# ends a path without saying anything, since neither reaches the next
# turn.
#
# `continue` is the other way round: it starts the next turn at once,
# with the accumulator this turn began with, unchanged.

def total(xs:[Int]) -> Int:
    return loop acc = 0 for x in xs:
        acc + x


def branches(n:Int) -> Int:
    # Each branch of the trailing `if` is a path of its own.
    return loop acc = 0:
        if acc > n:
            break
        else:
            if acc == 3:
                acc + 10
            else:
                acc + 1


def over_match(xs:[String]) -> Int:
    # A `match` says it as well, one arm at a time.
    return loop acc = 0 for x in xs:
        match x:
            case "double":
                acc + 2
            case _:
                acc + 1


def early(xs:[Int]) -> Int:
    # A `return` ends a path as surely as ending in the next
    # accumulator does.
    loop acc = 0 for x in xs:
        if x < 0:
            return 0 - 1
        else:
            acc + x


def skipping(xs:[Int]) -> Int:
    # `continue` goes round with the accumulator unchanged, so a
    # negative element here adds nothing.
    return loop acc = 0 for x in xs:
        if x < 0:
            continue
        acc + x


def loose(xs:[Int]) -> String:
    # No accumulator: the body's last statement is not the next turn's
    # anything, so it may be any type.
    for x in xs:
        if x < 0:
            continue
        "this value goes nowhere"
    return "done"


print(total([1, 2, 3]), total([]))
print(branches(5), branches(0))
print(over_match(["double", "x", "double"]))
print(early([1, 2]), early([1, 0 - 1]))
print(skipping([1, 0 - 1, 2]))
print(loose([1, 0 - 1, 2]))
