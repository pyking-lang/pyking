# Case 2 -- going round.
#
# A loop that carries an accumulator says what the next turn carries,
# on every path, with `continue`. There is no implicit tail: the value a
# body happens to end in is not taken as the accumulator (see
# fail_typecheck_loop_no_continue.pyk). "Every path" means the last
# statement of the body, and recursively each branch of a trailing `if`
# or `match` -- a `break` or a `return` ends a path too.
#
# A loop with no accumulator carries unit, so its body may end in
# anything at all and `continue` takes no value.

def total(xs:[Int]) -> Int:
    return loop acc = 0 for x in xs result acc:
        continue acc + x


def branches(n:Int) -> Int:
    # Each branch of the trailing `if` ends a path of its own.
    return loop acc = 0:
        if acc > n:
            break acc
        else:
            if acc == 3:
                continue acc + 10
            else:
                continue acc + 1


def over_match(xs:[String]) -> Int:
    # A `match` counts too, when its cases cover.
    return loop acc = 0 for x in xs result acc:
        match x:
            case "double":
                continue acc + 2
            case _:
                continue acc + 1


def early(xs:[Int]) -> Int:
    # A `return` ends a path as surely as a `continue` does.
    loop acc = 0 for x in xs result acc:
        if x < 0:
            return 0 - 1
        else:
            continue acc + x


def loose(xs:[Int]) -> String:
    # No accumulator: the body's last statement is not the next turn's
    # anything, so it may be any type, and `continue` takes no value.
    for x in xs:
        if x < 0:
            continue
        "this value goes nowhere"
    return "done"


print(total([1, 2, 3]), total([]))
print(branches(5), branches(0))
print(over_match(["double", "x", "double"]))
print(early([1, 2]), early([1, 0 - 1]))
print(loose([1, 0 - 1, 2]))
