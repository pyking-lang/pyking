total: Int = loop row: Int = 0:
    if row > 3:
        break
    inner: Int = loop column: Int = 0:
        if column > row:
            break
        else:
            column + 1
    print(row, inner)
    row + 1
print(total)
def stepped(limit:Int) -> Int:
    loop n: Int = 0:
        if n >= limit:
            break
        step: Int = loop k: Int = 1:
            if k >= n:
                break
            else:
                k + k
        n + step + 1
print(stepped(10))
print(stepped(0))
