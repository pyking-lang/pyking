# `result` -- what a loop is worth when it ends without breaking.
#
# `break` and `result` answer the same question from the two sides: a
# `break` says what the loop is worth on the way out, `result` says it
# when the loop runs out of turns. So they must agree on one type, and a
# `break` skips the `result` expression entirely.
#
# `result` needs a `for` or a `while` to be about: a plain `loop:` can
# only end by breaking, so there is no "without breaking" for it to
# describe (see fail_typecheck_result_plain_loop.pyk).

def describe(xs:[Int]) -> String:
    return for x in xs result "all fine":
        if x < 0:
            break "negative"


def count_to(limit:Int) -> String:
    return loop i = 0 while i < limit result "reached " ++ str(i):
        continue i + 1


def first_word(words:[String]) -> String:
    # `result` where there is no accumulator at all: without it the loop
    # would be worth unit and the `break` would not typecheck.
    return for w in words result "none":
        break w


def total_or_zero(xs:[Int]) -> Int:
    # An accumulator says it instead, so no `result` is needed -- and a
    # `break` giving the same type is fine beside it.
    return loop acc = 0 for x in xs:
        if x < 0:
            break 0
        else:
            continue acc + x


def size_only(xs:[String]) -> Int:
    # `result` overriding an accumulator, and picking one part of it:
    # the loop carries a pair and is worth only the count.
    return loop i, seen = 0, "" for x in xs result i:
        continue i + 1, seen ++ x


print(describe([1, 2]), describe([1, 0 - 2]))
print(count_to(3), count_to(0))
print(first_word(["a", "b"]), first_word([]))
print(total_or_zero([1, 2, 3]), total_or_zero([1, 0 - 1]))
print(size_only(["a", "b", "c"]), size_only([]))
