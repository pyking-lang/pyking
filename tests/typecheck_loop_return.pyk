# `return` from inside a loop, and what each of the two keywords leaves.
#
# `break` leaves the loop, which is then worth the accumulator it
# stopped on. `return` leaves the whole function, loop and all -- so the
# two are not alternatives, and one body may use both.

def first_over(limit: Int) -> Int:
    loop n = 1:
        if n > limit:
            return n * 100
        else:
            n * 2


print(first_over(10))


# A loop as the last thing a function does, with the `return` written
# out rather than left to tail position.
def doubled_over(limit: Int) -> Int:
    return loop n = 1:
        if n > limit:
            break
        else:
            n * 2


print(doubled_over(50))


# The two ways out of one body: a `break` that stops the loop and a
# `return` that skips everything after it.
def capped(start: Int, cap: Int) -> Int:
    loop n = start:
        if n > 1000:
            return 0
        if n > cap:
            break
        n * 3


print(capped(1, 20))
print(capped(500, 20))
