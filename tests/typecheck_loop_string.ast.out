banner: String = loop text: String = '':
    if text == '*****':
        break text
    else:
        continue text ++ '*'
print(banner)
def grow(seed:String, target:String) -> String:
    loop text: String = seed:
        if text == target:
            break text
        else:
            continue text ++ 'ab'
print(grow('', 'abab'))
print(grow('x', 'x'))
