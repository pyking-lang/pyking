# `then:` -- what a loop is worth when it ends by running out of turns.
#
# `break` and `then:` answer the same question from the two sides: what
# the loop is worth. A `break` says so on the way out; `then:` says so
# when the loop ends on its own. If both are written they must agree on
# one type, since one value leaves the loop either way -- and a `break`
# skips `then:` entirely.
#
# `then:` runs however many turns there were, none included, which is
# what makes it an answer for a loop that never ran at all.

def describe(xs:[Int]) -> String:
    answer = for x in xs:
        if x < 0:
            break "negative"
        else:
            ""
    then:
        "all fine"
    return answer


def count_to(limit:Int) -> String:
    answer = loop i = 0 while i < limit:
        continue i + 1
    then:
        "reached " ++ str(i)
    return answer


def last_or(xs:[Int], fallback:Int) -> Int:
    # `then:` sees the accumulator, which is what the last turn left.
    return loop seen = fallback for x in xs:
        x
    then:
        seen


def empty_still_answers(xs:[Int]) -> String:
    # No turns at all, and the loop still has a value.
    answer = for x in xs:
        break "some"
    then:
        "none"
    return answer


print(describe([1, 2]), describe([1, 0 - 2]))
print(count_to(3), count_to(0))
print(last_or([1, 2, 3], 0), last_or([], 9))
print(empty_still_answers([]), empty_still_answers([1]))
