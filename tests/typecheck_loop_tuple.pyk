# A loop carrying more than one value.
#
# The accumulator is one value, so several names are one tuple: the
# header takes them apart on every turn, and what the body ends in has
# to give the whole tuple back. The loop's own value is that tuple,
# which is why the binding outside destructures it.
#
# The `.ast.out` pins both halves: `(Int, Bool)` on the header and on
# the binding.

foo, bar = loop x, y = 0, true:
    if x <= 10:
        (x + 1, y)
    else if y:
        (x + 100, false)
    else:
        break

print(foo, bar)


# A running sum and a count, carried together and printed as the tuple
# they are.
def summed(limit: Int) -> (Int, Int):
    loop acc = 0, 1:
        (total, k) = acc
        if k > limit:
            break
        else:
            (total + k, k + 1)


print(summed(10))
print(summed(0))
