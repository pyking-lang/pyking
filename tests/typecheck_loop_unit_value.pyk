# What a `loop:` carrying nothing is worth.
#
# A bare `loop:` writes no accumulator down, so it carries nothing from
# turn to turn and is worth unit -- however it stops, and whatever its
# body ends in. Two things follow, and this file pins both.
#
# `continue` and `break` take no operand: there is no accumulator for
# either of them to say anything about.

use mutation

answer = loop:
    if true:
        break
    7

print(answer)


# The same loop written with nothing after the `break` at all.
nothing = loop:
    break

print(nothing)


# The body's last statement may be of any type, since nothing carries
# it into the next turn.
var seen = 0

loop:
    if seen == 3:
        break
    seen := seen + 1
    "a String nobody wants"

print(seen)
