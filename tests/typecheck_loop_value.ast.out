use mutation
def capped(limit:Int) -> Int:
    loop acc: Int = 0:
        if acc > limit:
            break
        else:
            acc + 3
def counted(limit:Int) -> Int:
    loop n: Int = 0:
        if n == limit:
            break
        else if n > 10:
            break
        else:
            n + 1
def marked(width:Int) -> String:
    var made = 0
    loop text: String = "":
        if made == width:
            break
        made := made + 1
        text + "*"
print(capped(10), capped(0))
print(counted(3), counted(50))
print(marked(5), marked(0))
