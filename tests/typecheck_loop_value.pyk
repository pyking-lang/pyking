# What a loop is worth.
#
# One rule, the same for every loop: the accumulator it stopped with,
# or unit where it carries none. What the body ends in is what the next
# turn carries, so "what does this loop carry" and "what is it worth"
# have one answer rather than two.

use mutation

def capped(limit: Int) -> Int:
    # Climbs by threes and stops on the first turn past the limit, so
    # it is worth the value it stopped on.
    loop acc = 0:
        if acc > limit:
            break
        else:
            acc + 3


def counted(limit: Int) -> Int:
    # Two `break`s, both leaving with the accumulator: one value comes
    # out of a loop however many ways out it has.
    loop n = 0:
        if n == limit:
            break
        else if n > 10:
            break
        else:
            n + 1


def marked(width: Int) -> String:
    # Nothing about the rule is about numbers: a loop carrying a String
    # is worth a String.
    var made = 0
    loop text = "":
        if made == width:
            break
        made := made + 1
        text + "*"


print(capped(10), capped(0))
print(counted(3), counted(50))
print(marked(5), marked(0))
