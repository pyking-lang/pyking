doubled: Int = loop n: Int = 1:
    if n < 50:
        n * 2
    else:
        break
print(doubled)
def below(limit:Int) -> Int:
    return loop n: Int = 1:
        if n < limit:
            n * 2
        else:
            break
print(below(20))
def shrunk(start:Int) -> Int:
    loop n: Int = start:
        if n > 1:
            n - 10
        else:
            break
print(shrunk(64))
loop countdown: Int = 3:
    if countdown == 0:
        break
    else:
        print(countdown)
        countdown - 1
print("lift off")
