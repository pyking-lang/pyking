# Case 4 -- `result`, and what a loop is worth.
#
# One rule decides it. The loop is worth:
#
#   the `result` expression, if one is written;
#   else the accumulator, if one is written;
#   else unit.
#
# and every `break` has to give that. A plain `loop:` is the exception,
# and has to be: it ends only by breaking, so its `break`s say it and
# `result` is refused there (fail_typecheck_result_plain_loop.pyk).
#
# Only the accumulator is in scope in a `result` expression -- not the
# loop variable, and nothing the body bound.

def by_accumulator(xs:[Int]) -> Int:
    # No `result`: the accumulator is what the loop is worth.
    return loop acc = 0 for x in xs:
        continue acc + x


def by_result(xs:[Int]) -> String:
    # `result` overrides it, and may be a different type entirely: the
    # loop carries an Int and is worth a String.
    return loop acc = 0 for x in xs result "counted " ++ str(acc):
        continue acc + 1


def by_unit(xs:[Int]) -> String:
    # Neither: the loop is worth unit, and a bare `break` fits.
    nothing = for x in xs:
        break
    return "unit"


def part_of_it(xs:[String]) -> [String]:
    # `result` picking one slot out of a pair the loop carries.
    return loop n, seen = 0, [] for x in xs result seen:
        continue n + 1, [x] ++ seen


def agreeing(xs:[Int]) -> String:
    # `break` and `result` both say what the loop is worth, so they
    # agree on one type -- and the `break` skips the `result`.
    return for x in xs result "ran out":
        if x > 10:
            break "found one"


def no_result_needed(xs:[Int]) -> Int:
    # With an accumulator of the same type as the `break`, `result` is
    # not needed at all.
    return loop acc = 0 for x in xs:
        if x < 0:
            break 0 - 1
        else:
            continue acc + x


def while_result(n:Int) -> String:
    # `result` on a `while`, reading the accumulator it carries.
    return loop i = n while i > 0 result "down to " ++ str(i):
        continue i - 1


print(by_accumulator([1, 2, 3]), by_accumulator([]))
print(by_result([1, 2, 3]))
print(by_unit([1]))
print(part_of_it(["a", "b"]))
print(agreeing([1, 2]), agreeing([1, 20]))
print(no_result_needed([1, 2]), no_result_needed([1, 0 - 1]))
print(while_result(3), while_result(0))
