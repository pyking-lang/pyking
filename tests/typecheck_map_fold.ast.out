def map : ((a) -> b, [a]) -> [b]
def map(f, xs):
    match xs:
        case []:
            return []
        case [head, ..rest]:
            return [f(head)] + map(f, rest)
def fold_left : ((b, a) -> b, b, [a]) -> b
def fold_left(step, start, xs):
    loop (step, start, xs): ((b, a) -> b, b, [a]) = (step, start, xs):
        match xs:
            case []:
                return start
            case [head, ..rest]:
                (step, step(start, head), rest)
def filter : ((a) -> Bool, [a]) -> [a]
def filter(keep, xs):
    match xs:
        case []:
            return []
        case [head, ..rest]:
            rest_kept: [a] = filter(keep, rest)
            if keep(head):
                return [head] + rest_kept
            else:
                return rest_kept
def double : (Int) -> Int
def double(n):
    return n * 2
def show : (Int) -> String
def show(n):
    return string(n)
def add : (Int, Int) -> Int
def add(total, n):
    return total + n
def bigger : (Int, Int) -> Int
def bigger(best, n):
    return if n > best then n else best
def join : (String, String) -> String
def join(text, piece):
    return text + piece
def positive : (Int) -> Bool
def positive(n):
    return n > 0
numbers: [Int] = [1, 4, 2, 5]
print(map(double, numbers))
print(map(show, numbers))
print(fold_left(add, 0, numbers))
print(fold_left(bigger, 0, numbers))
print(fold_left(join, "", map(show, numbers)))
print(fold_left(add, 0, filter(positive, map(double, [0 - 1, 3, 0 - 2, 4]))))
print(map(show, filter(positive, numbers)))
def take_first : (Int, (Int, String)) -> Int
def take_first(total, pair):
    (n, s): (Int, String) = pair
    return total + n
print(fold_left(take_first, 0, [(1, "a"), (2, "b"), (3, "c")]))
