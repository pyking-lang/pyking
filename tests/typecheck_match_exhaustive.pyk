# When a `match` is total, and when the checker says it is not.
#
# A `match` that fits no arm does nothing (PYKING.md), so one whose
# value is *taken* has to be unable to fit nothing. `covers` in
# src/typesystem.py decides that, and it is deliberately syntactic --
# it asks about the patterns, not about which values exist. Three ways
# to satisfy it, all of them here.

# 1. An irrefutable arm: `case _`, or one that binds a name. A tuple of
#    irrefutable patterns counts too, since a tuple's shape is fixed by
#    its type.
def kind(n:Int) -> String:
    answer = match n:
        case 0: "zero"
        case 1: "one"
        case _: "other"
    return answer


def named(n:Int) -> String:
    answer = match n:
        case 0: "zero"
        case rest: "other"
    return answer


def corner(p:(Int, Int)) -> String:
    answer = match p:
        case (0, 0): "origin"
        case (x, y): "elsewhere"
    return answer


# 2. Both of a Bool's values. There are only two, so naming both leaves
#    nothing over -- and adding `case _` after them would be an arm that
#    can never run.
def spoken(b:Bool) -> String:
    answer = match b:
        case true: "yes"
        case false: "no"
    return answer


# 3. List patterns taking every length: exact lengths 0 up to k-1, and
#    one pattern with a rest marker that takes k or more. This is the
#    shape every recursion over a list is written in, which is why it is
#    worth recognising at all.
def size(xs:[Int]) -> String:
    answer = match xs:
        case []: "empty"
        case [_, ..rest]: "some"
    return answer


def few(xs:[Int]) -> String:
    answer = match xs:
        case []: "none"
        case [a]: "one"
        case [a, b]: "two"
        case [a, b, c, ..rest]: "many"
    return answer


# The subject may be a type the caller chose: a pattern is checked
# against whatever it matches, and `covers` never needed the type.
def first_or : ([a], a) -> a
def first_or(xs, fallback):
    answer = match xs:
        case []: fallback
        case [head, ..]: head
    return answer


# Patterns nest, and a nested one is refutable however irrefutable its
# parts are: `([_, x, y], _)` takes only a three-element list. Arms are
# tried in order, so an earlier one wins where both would fit, and the
# `case _` at the end is what makes the whole thing total.
def pick(z:([Int], Int)) -> [Int]:
    x = match z:
        case ([1, 2], 4): [1]
        case ([_, x, y], _): [x]
        case ([x, ..y], 4): y
        case _: [2]
    return x


print(kind(0), kind(1), kind(9))
print(named(0), named(4))
print(corner((0, 0)), corner((1, 2)))
print(spoken(true), spoken(false))
print(size([]), size([1]))
print(few([]), few([1]), few([1, 2]), few([1, 2, 3, 4]))
print(first_or([1, 2], 0), first_or(["a"], "z"), first_or([], true))
print(pick(([1, 4, 8, 10], 4)), pick(([1, 2], 4)), pick(([5, 6, 7], 9)))
print(pick(([], 0)), pick(([3], 4)))

# The statement form is held to none of this: it may match nothing, and
# then it does nothing.
match 9:
    case 1:
        print("never")

print("done")
