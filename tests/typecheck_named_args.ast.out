def box__default__width() -> Int:
    1
def box__default__height() -> Int:
    2
def box__default__depth() -> Int:
    3
def box(width:Int, height:Int, depth:Int) -> Int:
    return width * 100 + height * 10 + depth
print(box(box__default__width(), 9, box__default__depth()))
print(box(box__default__width(), box__default__height(), 9))
print(box(9, box__default__height(), box__default__depth()))
print(box(4, box__default__height(), 6))
print(box(box__default__width(), 4, 6))
print(box(4, 5, 6))
print(box(7, box__default__height(), box__default__depth()))
print(box(7, box__default__height(), 8))
print(box(7, 8, 9))
def join(left:String, right:String) -> String:
    return left ++ '-' ++ right
print(join('a', 'b'))
print(join('a', 'c'))
def scale__default__factor() -> Int:
    2
def scale(base:Int, factor:Int) -> Int:
    return base * factor
print(scale(3, box(0, 0, 2)))
