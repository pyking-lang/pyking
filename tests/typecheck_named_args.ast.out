def box(width:Int, height:Int, depth:Int) -> Int:
    return width * 100 + height * 10 + depth
print(box(1, 9, 3))
print(box(1, 2, 9))
print(box(9, 2, 3))
print(box(4, 2, 6))
print(box(1, 4, 6))
print(box(4, 5, 6))
print(box(7, 2, 3))
print(box(7, 2, 8))
print(box(7, 8, 9))
def join(left:String, right:String) -> String:
    return left ++ '-' ++ right
print(join('a', 'b'))
print(join('a', 'c'))
def scale(base:Int, factor:Int) -> Int:
    return base * factor
print(scale(3, box(0, 0, 2)))
