# List pipeline, with every annotation taken off.
#
# The twin of tests/typecheck_list_pipeline.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

def map_pairs(xs):
    match xs:
        case []:
            return []
        case [(left, right), ..rest]:
            return [left] + map_pairs(rest)


def take(xs, n):
    answer = match xs:
        case []: []
        case [first, ..rest]:
            if n < 1:
                []
            else:
                [first] + take(rest, n - 1)
    return answer


def drop(xs, n):
    answer = match xs:
        case []: []
        case [first, ..rest]:
            if n < 1:
                xs
            else:
                drop(rest, n - 1)
    return answer


def join(parts, sep):
    answer = match parts:
        case []: ""
        case [only]: only
        case [first, ..rest]: first + sep + join(rest, sep)
    return answer


def sum_all(xs):
    match xs:
        case []:
            return 0
        case [x, ..rest]:
            return x + sum_all(rest)


scores = [(90, "ada"), (72, "bob"), (85, "cy"), (61, "dee")]

print(map_pairs(scores))
print(sum_all(map_pairs(scores)))
print(take(map_pairs(scores), 2), drop(map_pairs(scores), 2))

names = [name for (n, name) in scores if n > 70]
print(names)
print(join(names, ", "))
print(join(take(names, 2), " and "))

# The same `take` and `drop`, at three different element types.
print(take([1, 2, 3], 2))
print(take(["a", "b", "c"], 1))
print(drop([true, false, true], 1))
