counted: Int = loop x: Int = 5:
    if x <= 10:
        x + 1
    else:
        break
print(counted)
def multiple_over(start:Int, limit:Int) -> Int:
    loop n: Int = start:
        if n > limit:
            break
        else:
            n * 2
print(multiple_over(1, 100))
print(multiple_over(3, 3))
