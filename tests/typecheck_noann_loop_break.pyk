# Loop break, with every annotation taken off.
#
# The twin of tests/typecheck_loop_break.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

use mutation

def count_to(limit):
    # The accumulator is both what the loop carries and what it is
    # worth, so this answers with the count it stopped on.
    return loop i = 0:
        if i >= limit:
            break
        else:
            i + 1


def name_of(limit):
    # A loop carrying a String is worth a String. The counting is done
    # by a `var` beside it, since only one thing is carried here.
    var i = 0
    return loop said = "waiting":
        if i >= limit:
            break
        i := i + 1
        "enough"


def nothing(limit):
    # A loop with no accumulator carries nothing and is worth unit,
    # whatever its body ends in.
    var i = 0
    loop:
        if i >= limit:
            break
        i := i + 1


def spin():
    # No `break` at all: this never ends, so nothing ever asks what it
    # is worth.
    loop n = 0:
        n + 1


def carried() -> (Int, String):
    # A loop carrying a pair is worth the pair.
    return loop n, s = 0, "":
        if n > 2:
            break
        else:
            (n + 1, s + "x")


print(count_to(3), count_to(0))
print(name_of(2))
print(nothing(2))
print(carried())
