def count_up(limit):
    return loop n = 0:
        if n >= limit:
            break n * 2
        continue n + 1
def pick(flag, yes, no):
    return loop chosen = no:
        if flag:
            break yes
        break chosen
def step_pair(a, b, rounds):
    return loop (x, y, k) = (a, b, 0) while k < rounds:
        continue (y, x + y, k + 1)
print(count_up(5))
print(pick(true, "yes", "no"), pick(false, 1, 2))
print(step_pair(0, 1, 10))
