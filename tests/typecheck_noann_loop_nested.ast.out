total: Int = loop row: Int = 0:
    if row > 3:
        break row
    inner: Int = loop column: Int = 0:
        if column > row:
            break column
        else:
            continue column + 1
    print(row, inner)
    continue row + 1
print(total)
def stepped(limit:Int) -> Int:
    loop n: Int = 0:
        if n >= limit:
            break n
        step: Int = loop k: Int = 1:
            if k >= n:
                break k
            else:
                continue k + k
        continue n + step + 1
print(stepped(10))
print(stepped(0))
