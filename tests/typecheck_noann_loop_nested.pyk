# Loop nested, with every annotation taken off.
#
# The twin of tests/typecheck_loop_nested.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

total =
loop row = 0:
    if row > 3:
        break row
    inner = loop column = 0:
        if column > row:
            break column
        else:
            continue column + 1
    print(row, inner)
    continue row + 1

print(total)


# The same nesting inside a function, with the inner loop bound and
# then used to decide what the outer one carries.
def stepped(limit):
    loop n = 0:
        if n >= limit:
            break n
        step = loop k = 1:
            if k >= n:
                break k
            else:
                continue k + k
        continue n + step + 1


print(stepped(10))
print(stepped(0))
