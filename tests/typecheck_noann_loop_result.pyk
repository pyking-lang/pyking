# Loop result, with every annotation taken off.
#
# The twin of tests/typecheck_loop_result.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

def describe(xs):
    return for x in xs result "all fine":
        if x < 0:
            break "negative"


def count_to(limit):
    return loop i = 0 while i < limit result "reached " ++ str(i):
        continue i + 1


def first_word(words):
    # `result` where there is no accumulator at all: without it the loop
    # would be worth unit and the `break` would not typecheck.
    return for w in words result "none":
        break w


def total_or_zero(xs):
    # An accumulator says it instead, so no `result` is needed -- and a
    # `break` giving the same type is fine beside it.
    return loop acc = 0 for x in xs:
        if x < 0:
            break 0
        else:
            continue acc + x


def size_only(xs):
    # `result` overriding an accumulator, and picking one part of it:
    # the loop carries a pair and is worth only the count.
    return loop i, seen = 0, "" for x in xs result i:
        continue i + 1, seen ++ x


print(describe([1, 2]), describe([1, 0 - 2]))
print(count_to(3), count_to(0))
print(first_word(["a", "b"]), first_word([]))
print(total_or_zero([1, 2, 3]), total_or_zero([1, 0 - 1]))
print(size_only(["a", "b", "c"]), size_only([]))
