(foo, bar): (Int, Bool) = loop (x, y): (Int, Bool) = (0, true):
    if x <= 10:
        (x + 1, y)
    else if y:
        (x + 100, false)
    else:
        break
print(foo, bar)
def summed(limit:Int) -> (Int, Int):
    loop acc: (Int, Int) = (0, 1):
        (total, k): (Int, Int) = acc
        if k > limit:
            break
        else:
            (total + k, k + 1)
print(summed(10))
print(summed(0))
