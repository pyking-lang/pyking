# Map fold, with every annotation taken off.
#
# The twin of tests/typecheck_map_fold.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

def map(f, xs):
    match xs:
        case []:
            return []
        case [head, ..rest]:
            return [f(head)] ++ map(f, rest)


def fold_left(step, start, xs):
    match xs:
        case []:
            return start
        case [head, ..rest]:
            return fold_left(step, step(start, head), rest)


def filter(keep, xs):
    match xs:
        case []:
            return []
        case [head, ..rest]:
            rest_kept = filter(keep, rest)
            if keep(head):
                return [head] ++ rest_kept
            else:
                return rest_kept


def double(n):
    return n * 2


def show(n):
    return string(n)


def add(total, n):
    return total + n


def bigger(best, n):
    return if n > best then n else best


def join(text, piece):
    return text ++ piece


def positive(n):
    return n > 0


numbers = [1, 4, 2, 5]

# One `map`, at two different result types.
print(map(double, numbers))
print(map(show, numbers))

# One `fold_left`, at two different accumulator types -- Int and String.
print(fold_left(add, 0, numbers))
print(fold_left(bigger, 0, numbers))
print(fold_left(join, "", map(show, numbers)))

# The three composed, which is the point of their all being polymorphic.
print(fold_left(add, 0, filter(positive, map(double, [0 - 1, 3, 0 - 2, 4]))))
print(map(show, filter(positive, numbers)))

# `fold_left` over a list of tuples, accumulating an Int from a pair.
def take_first(total, pair):
    n, s = pair
    return total + n


print(fold_left(take_first, 0, [(1, "a"), (2, "b"), (3, "c")]))
