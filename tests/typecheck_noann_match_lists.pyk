# Match lists, with every annotation taken off.
#
# The twin of tests/typecheck_match_lists.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

def total(xs):
    match xs:
        case []:
            return 0
        case [x, ..rest]:
            return x + total(rest)


def length(xs):
    match xs:
        case []:
            return 0
        case [_, ..rest]:
            return 1 + length(rest)


def reverse(xs):
    match xs:
        case []:
            return []
        case [x, ..rest]:
            return reverse(rest) ++ [x]


def ends(xs):
    answer = match xs:
        case []: "empty"
        case [only]: "one"
        case [first, ..middle]: "many"
    return answer


print(total([1, 2, 3, 4]))
print(length([5, 5, 5]))
print(reverse([1, 2, 3]))
print(ends([]), ends([1]), ends([1, 2, 3]))
