# String recursion, with every annotation taken off.
#
# The twin of tests/typecheck_string_recursion.pyk: the same program, with no parameter
# type, no return type and no signature line anywhere in it. Its `.out`
# is that file's `.out`, unchanged -- an annotation says what a program
# means to a reader and to the checker, never what it does.
#
# What this file is really for is its `.ast.out`, which holds the types
# the checker worked out with nothing to go on but the calls. Read the
# two side by side: where they differ, inference found something more
# general than the annotation claimed.

def repeat(piece, times):
    if times <= 0:
        ""
    else:
        piece ++ repeat(piece, times - 1)

def bar(width):
    repeat("#", width)

# Numbers become text through `str`, and the separator is only written
# between elements -- which is why the last step is a special case rather
# than a trailing comma.
def countdown(from_):
    if from_ <= 1:
        "1"
    else:
        str(from_) ++ ", " ++ countdown(from_ - 1)

# Roman numerals: subtract the largest value that fits, name it, and ask
# the same question about what is left. Every branch is a step down, so
# this terminates for any positive number.
def roman(n):
    if n <= 0:
        ""
    else:
        if n >= 1000:
            "M" ++ roman(n - 1000)
        else:
            if n >= 900:
                "CM" ++ roman(n - 900)
            else:
                if n >= 500:
                    "D" ++ roman(n - 500)
                else:
                    if n >= 400:
                        "CD" ++ roman(n - 400)
                    else:
                        if n >= 100:
                            "C" ++ roman(n - 100)
                        else:
                            if n >= 90:
                                "XC" ++ roman(n - 90)
                            else:
                                if n >= 50:
                                    "L" ++ roman(n - 50)
                                else:
                                    if n >= 40:
                                        "XL" ++ roman(n - 40)
                                    else:
                                        if n >= 10:
                                            "X" ++ roman(n - 10)
                                        else:
                                            small_roman(n)

def small_roman(n):
    if n >= 9:
        "IX"
    else:
        if n >= 5:
            "V" ++ small_roman(n - 5)
        else:
            if n >= 4:
                "IV"
            else:
                if n >= 1:
                    "I" ++ small_roman(n - 1)
                else:
                    ""

# Mutual recursion producing text: two functions taking turns, each
# naming the other, so the alternation is in the call graph rather than
# in a condition.
def stripes(n):
    if n <= 0:
        ""
    else:
        "-" ++ gaps(n - 1)

def gaps(n):
    if n <= 0:
        ""
    else:
        "_" ++ stripes(n - 1)

# `len` is the other direction: text in, number out. A nested helper
# keeps the padding rule to itself.
def pad_to(text, width):
    def spaces(count):
        repeat(".", count)
    text ++ spaces(width - len(text))

def longer(left, right):
    if len(left) >= len(right):
        left
    else:
        right

# A guard reads better than an `else` when one case is an exception
# rather than an alternative.
def label(count, thing):
    if count == 1:
        return "1 " ++ thing
    return str(count) ++ " " ++ thing ++ "s"

print(bar(5), repeat("ab", 3))
print(countdown(5))
print(roman(2024), roman(49), roman(3999), roman(4))
print(stripes(6), gaps(6))
print(pad_to("name", 10) ++ "|", pad_to("a longer name", 10) ++ "|")
print(longer("short", "much longer"), len(longer("short", "much longer")))
print(label(1, "file"), label(3, "file"), label(0, "file"))
