# Recursion over numbers, written the way a functional program is: no
# loop, no mutation, and every function a single expression whose value
# is either an answer or a smaller version of the same question.
#
# All of it lives inside the checked fragment -- `Int`, `Bool`, `+ - *`,
# comparisons and calls -- which is also, by construction, the subset the
# `ocaml` target compiles. There is no division: the checker does not
# cover it, so Euclid's algorithm is here in its subtractive form, which
# is the older one anyway.

# The base case is `n <= 1`, so the recursion is guaranteed to stop.
def factorial(n:Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

# Two calls per step, which is what makes this the textbook example of a
# function that is easy to write and slow to run.
def fibonacci(n:Int) -> Int:
    if n < 2:
        n
    else:
        fibonacci(n - 1) + fibonacci(n - 2)

# The same sequence again, with an accumulator: one call per step, and
# the recursive call is the whole of the branch -- a tail call, which
# neither grows the stack in OCaml nor needs to.
def fib_from(a:Int, b:Int, steps:Int) -> Int:
    if steps == 0:
        a
    else:
        fib_from(b, a + b, steps - 1)

def fib_fast(n:Int) -> Int:
    fib_from(0, 1, n)

# Euclid without division: subtract the smaller from the larger until
# they meet. Three branches, one of which returns and two of which
# recurse.
def gcd(a:Int, b:Int) -> Int:
    if a == b:
        a
    else:
        if a > b:
            gcd(a - b, b)
        else:
            gcd(a, b - a)

# Exponentiation by squaring needs halving, and halving needs division --
# so this is the plain version, one multiplication per step.
def power(base:Int, exponent:Int) -> Int:
    if exponent <= 0:
        1
    else:
        base * power(base, exponent - 1)

# Mutual recursion: neither function can be checked without assuming the
# other, which is exactly what the checker's hoisting of `def` names is
# for. In OCaml the pair becomes one `let rec ... and ...`.
def is_even(n:Int) -> Bool:
    if n == 0:
        true
    else:
        is_odd(n - 1)

def is_odd(n:Int) -> Bool:
    if n == 0:
        false
    else:
        is_even(n - 1)

# A guard, then the general case: the shape most recursive functions are
# written in, and the one early `return` that has an OCaml spelling.
def triangular(n:Int) -> Int:
    if n <= 0:
        return 0
    return n + triangular(n - 1)

# A helper written below its use, and only reachable from it.
def collatz_length(n:Int) -> Int:
    def step(current:Int, count:Int) -> Int:
        if current <= 1:
            count
        else:
            if is_even(current):
                step(halve(current), count + 1)
            else:
                step(3 * current + 1, count + 1)
    def halve(m:Int) -> Int:
        if m < 2:
            0
        else:
            1 + halve(m - 2)
    step(n, 0)

print(factorial(5), factorial(10))
print(fibonacci(10), fib_fast(10), fib_fast(30))
print(gcd(48, 18), gcd(17, 5), gcd(9, 9))
print(power(2, 10), power(3, 4))
print(is_even(10), is_odd(10), is_even(7))
print(triangular(10), triangular(0))
print(collatz_length(6), collatz_length(7), collatz_length(9))
