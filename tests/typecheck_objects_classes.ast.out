use objects
use mutation
class Vec(x: Float, y: Float):
    def length2(self) -> Float:
        self.x * self.x + self.y * self.y
    def plus(self, other:Vec) -> Vec:
        Vec(x = self.x + other.x, y = self.y + other.y)
    def scaled(self, k:Float = 2.0) -> Vec:
        Vec(x = self.x * k, y = self.y * k)
    def eq(self, other:Vec) -> Bool:
        self.x == other.x and self.y == other.y
class Counter(var count: Int):
    var history: [Int] = []
    steps: Int = 1
    def tick(self, by:Int = 1):
        field__owner: Counter = self
        field__owner.count += by * self.steps
        self.history := self.history + [self.count]
    def ticked(self, times:Int) -> Int:
        if times == 0 then self.count else self.once(times)
    private def once(self, times:Int) -> Int:
        self.tick(1)
        self.ticked(times - 1)
class Money(cents: Int, currency: String):
    def show(self) -> String:
        string(self.cents / 100) + "," + string(self.cents % 100) + " " + self.currency
class Tag(name: String)
class Empty()
v: Vec = Vec(x = 3.0, y = 4.0)
print(v, v.length2(), Vec(x = 1.0, y = 0.0))
print(v.plus(Vec(x = 1.0, y = 1.0)), v.scaled(2.0), v.scaled(0.5))
grow: (Float) -> Vec = let method__self: Vec = v in lam (method__arg1:Float). method__self.scaled(method__arg1)
print(grow(10.0))
print(Vec(x = 1.0, y = 2.0).eq(Vec(x = 1.0, y = 2.0)), not Vec(x = 1.0, y = 0.0).eq(Vec(x = 1.0, y = 0.0)), Vec(x = 1.0, y = 0.0).eq(Vec(x = 2.0, y = 0.0)))
print(same(v, v), same(v, Vec(x = 3.0, y = 4.0)))
c: Counter = Counter(count = 0)
c.tick(1)
c.tick(2)
print(c.ticked(3), c.count, c.history, c)
d: Counter = c
d.count := 100
print(c.count)
print(Money(cents = 250, currency = "SEK"), [Money(cents = 5, currency = "EUR"), Money(cents = 1999, currency = "SEK")])
print(Tag(name = "x"), Empty, Tag(name = "y").name)
