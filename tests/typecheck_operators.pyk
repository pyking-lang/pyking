# What `-t pyking` prints for the operators of design/steps.md, step 2:
# each spelling back as written, `and`/`or`/`not` on Ints included, with
# the parentheses the precedences need and no others.

logic = true and not false || !true && false
bits = 12 and 10 or 3
negated = not 7
mixed = 1 << 2 | 3 & 4 xor 5
masked = (6 and 4) == 4
power = 2 ^ 3 ^ 2 + (2 ^ 3) ^ 2 - -2 ^ 2
remainder = 7 % 3 * 2
compared = 1 != 2 and "a" != "b"
indexed = [[1, 2], [3]][0][1]
joined = "a" + "b"
listed = [1] + [2]
inc = lam x. x + 1
pair = lam (a: Int, b: Int). a * b
thunk = lam (). 0
curried = lam a. lam b. a - b

print(logic, bits, negated, mixed, masked, power, remainder, compared)
print(indexed, joined, listed, inc(1), pair(2, 3), thunk(), curried(5)(2))
