empty = []
bare = []
print(empty, bare, len(empty))
def keep(xs:[Int]) -> [Int]:
    return xs
print(keep([]))
single: (Int,) = (1,)
(only,): (Int,) = single
print(single, only)
def unwrap(p:(Int,)) -> Int:
    (n,): (Int,) = p
    return n
print(unwrap((7,)), unwrap(single))
def total(xs:[Int], acc:Int) -> Int:
    loop (xs, acc): ([Int], Int) = (xs, acc):
        match xs:
            case []:
                break acc
            case [x, ..rest]:
                continue (rest, acc + x)
print(total([1, 2, 3, 4, 5], 0))
def tail_group4(state:Int, xs:[Int], acc:[Int]) -> [Int]:
    loop (state, xs, acc): (Int, [Int], [Int]) = (state, xs, acc):
        if state == 0:
            match xs:
                case []:
                    break acc
                case [x, ..rest]:
                    continue (1, rest, acc ++ [x])
        else:
            match xs:
                case []:
                    break acc
                case [x, ..rest]:
                    continue (0, rest, acc)
def evens(xs:[Int], acc:[Int]) -> [Int]:
    tail_group4(0, xs, acc)
def odds(xs:[Int], acc:[Int]) -> [Int]:
    tail_group4(1, xs, acc)
print(evens([1, 2, 3, 4, 5], []))
def counted(xs, acc):
    loop (xs, acc): ([Int] | [String], Int) = (xs, acc):
        match xs:
            case []:
                break acc
            case [x, ..rest]:
                continue (rest, acc + 1)
print(counted([1, 2, 3], 0), counted(['a'], 0))
def announce(n:Int) -> ():
    match n:
        case 0:
            print('zero')
        case 1:
            print('one')
announce(0)
announce(1)
announce(7)
