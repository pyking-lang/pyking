def scale : (Int, Int) -> Int
def scale(n, factor):
    return n * factor
def greet : (String) -> String
def greet(name):
    'hello ' ++ name
def apply : ((Int) -> Int, Int) -> Int
def apply(f, x):
    f(x)
def inc : (Int) -> Int
def inc(n):
    n + 1
def nothing : () -> ()
def nothing():
    ()
print(scale(6, 7))
print(greet('world'))
print(apply(inc, 41))
nothing()
