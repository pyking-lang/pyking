one: (Int,) = (1,)
two: (Int, Bool) = (1, true)
none: () = ()
nested: ((Int,),) = ((1,),)
listed: [(Int,)] = [(1,), (2,)]
print(one, two, none, nested, listed)
a: (Int,) = (1,)
b: (String,) = ('x',)
c: (Bool,) = (true,)
d: (Int, Bool) = (1, true)
e: () = ()
f: ((Int,),) = ((1,),)
g: (Int, (Bool,)) = (1, (true,))
h: [(Int,)] = [(1,), (2,)]
i: ([Int],) = ([1, 2],)
print(a, b, c, d, e)
print(f, g, h, i)
p: Int = 1
q: Int = 2
r: String = 'deep'
s: [Int] = [1, 2]
t: (Int, Bool) = (1, true)
print(p, q, r, s, t)
def unwrap(v:(Int,)) -> Int:
    (n,): (Int,) = v
    return n
def wrap(n:Int) -> (Int,):
    return (n,)
print(unwrap((7,)), wrap(7), unwrap(wrap(9)))
def only(v:(String,)) -> String:
    match v:
        case (word,):
            word
print(only(('hello',)))
def apply_plain(fn:(Int) -> Int, n:Int) -> Int:
    return fn(n)
def apply_comma(fn:(Int) -> Int, n:Int) -> Int:
    return fn(n)
def apply_tupled(fn:((Int,)) -> Int, v:(Int,)) -> Int:
    return fn(v)
def twice(n:Int) -> Int:
    return n * 2
print(apply_plain(twice, 4), apply_comma(twice, 5))
print(apply_tupled(unwrap, (6,)))
def pair_up(n:Int) -> ((Int,), (Int,)):
    return ((n,), (n + 1,))
print(pair_up(3))
held: ((Int) -> Int,) = (twice,)
def call_held(t:((Int) -> Int,), n:Int) -> Int:
    (fn,): ((Int) -> Int,) = t
    return fn(n)
print(call_held(held, 5))
def counted(limit:Int) -> (Int,):
    loop acc: (Int,) = (0,):
        if unwrap(acc) < limit:
            continue (unwrap(acc) + 1,)
        else:
            break acc
print(counted(0), counted(4))
