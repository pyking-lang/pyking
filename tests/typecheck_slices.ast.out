use mutation
name: String = "Ada Lovelace"
first: String = name[:3]
nums: [Int] = [3, 1, 4, 1, 5]
middle: [Int] = nums[1:4]
store: Array(Float) = list::array([0.5, 1.5, 2.5])
part: Slice(Float) = view(store, 0, 2)
element__array: Slice(Float) = part
element__index: Int = 1
element__array[element__index] *= 2.0
def total(xs:Slice(Float)) -> Float:
    var sum = 0.0
    for x in xs:
        sum += x
    sum
copy_into(store, part[1:])
print(first, middle, total(part), store, len(part))
