# Building strings by recursion, with the two things a Pyking program has
# for the purpose: `+` on strings and `string` on numbers.
#
# There is no indexing, no slicing and no loop, so every function here
# builds its answer out of a smaller answer and one more piece -- which
# is how a string is assembled in a language with immutable values, and
# what the `ocaml` target turns into `^` and nothing else.
#
# Note what the checker is doing with `+` throughout: the same operator
# adds `Int`s and joins `String`s, and which one is meant is decided by
# the types of its operands. The OCaml backend reads that decision back
# out of the checker rather than making it again -- `+` and `^` are two
# different operators there.

def repeat(piece:String, times:Int) -> String:
    if times <= 0:
        ""
    else:
        piece ++ repeat(piece, times - 1)

def bar(width:Int) -> String:
    repeat("#", width)

# Numbers become text through `string`, and the separator is only written
# between elements -- which is why the last step is a special case rather
# than a trailing comma.
def countdown(from_:Int) -> String:
    if from_ <= 1:
        "1"
    else:
        string(from_) ++ ", " ++ countdown(from_ - 1)

# Roman numerals: subtract the largest value that fits, name it, and ask
# the same question about what is left. Every branch is a step down, so
# this terminates for any positive number.
def roman(n:Int) -> String:
    if n <= 0:
        ""
    else:
        if n >= 1000:
            "M" ++ roman(n - 1000)
        else:
            if n >= 900:
                "CM" ++ roman(n - 900)
            else:
                if n >= 500:
                    "D" ++ roman(n - 500)
                else:
                    if n >= 400:
                        "CD" ++ roman(n - 400)
                    else:
                        if n >= 100:
                            "C" ++ roman(n - 100)
                        else:
                            if n >= 90:
                                "XC" ++ roman(n - 90)
                            else:
                                if n >= 50:
                                    "L" ++ roman(n - 50)
                                else:
                                    if n >= 40:
                                        "XL" ++ roman(n - 40)
                                    else:
                                        if n >= 10:
                                            "X" ++ roman(n - 10)
                                        else:
                                            small_roman(n)

def small_roman(n:Int) -> String:
    if n >= 9:
        "IX"
    else:
        if n >= 5:
            "V" ++ small_roman(n - 5)
        else:
            if n >= 4:
                "IV"
            else:
                if n >= 1:
                    "I" ++ small_roman(n - 1)
                else:
                    ""

# Mutual recursion producing text: two functions taking turns, each
# naming the other, so the alternation is in the call graph rather than
# in a condition.
def stripes(n:Int) -> String:
    if n <= 0:
        ""
    else:
        "-" ++ gaps(n - 1)

def gaps(n:Int) -> String:
    if n <= 0:
        ""
    else:
        "_" ++ stripes(n - 1)

# `len` is the other direction: text in, number out. A nested helper
# keeps the padding rule to itself.
def pad_to(text:String, width:Int) -> String:
    def spaces(count:Int) -> String:
        repeat(".", count)
    text ++ spaces(width - len(text))

def longer(left:String, right:String) -> String:
    if len(left) >= len(right):
        left
    else:
        right

# A guard reads better than an `else` when one case is an exception
# rather than an alternative.
def label(count:Int, thing:String) -> String:
    if count == 1:
        return "1 " ++ thing
    return string(count) ++ " " ++ thing ++ "s"

print(bar(5), repeat("ab", 3))
print(countdown(5))
print(roman(2024), roman(49), roman(3999), roman(4))
print(stripes(6), gaps(6))
print(pad_to("name", 10) ++ "|", pad_to("a longer name", 10) ++ "|")
print(longer("short", "much longer"), len(longer("short", "much longer")))
print(label(1, "file"), label(3, "file"), label(0, "file"))
