# A file's own submodules: each dotted name is the plain name it compiles
# to, and is written with its whole path wherever it is used, a sibling
# in the same submodule included.

def geo.square(x: Int) -> Int: x * x

def geo.sum_of_squares(a: Int, b: Int) -> Int:
    geo.square(a) + geo.square(b)

geo.origin: (Int, Int) = (0, 0)

datatype geo.shape.Kind:
    Round
    Corner(n: Int)

def geo.shape.corners(k: geo.shape.Kind) -> Int:
    match k:
        case geo.shape.Round:
            0
        case geo.shape.Corner(n):
            n

print(geo.sum_of_squares(3, 4))
print(geo.origin)
print(geo.shape.corners(geo.shape.Corner(4)))
