def scale(x:Int, factor:Int) -> Int:
    if x * factor == 4:
        8
    else:
        9
def double(n:Int) -> Int:
    n * 2
def area(width:Int, height:Int) -> Int:
    scaled: Int = width * height
    scaled + 0
def describe(n:Int) -> String:
    if n < 0:
        "negative"
    else if n == 0:
        "zero"
    else:
        "positive"
def nested(n:Int, keep:Bool) -> Int:
    if keep:
        if n > 10:
            1
        else:
            2
    else:
        3
def mixed(n:Int) -> Int:
    if n > 0:
        return n
    else:
        0 - n
def clamp(n:Int, hi:Int) -> Int:
    if n > hi:
        return hi
    else:
        return n
def pick(keep:Bool) -> String:
    return if keep:
        "kept"
    else:
        "dropped"
four: Int = scale(2, 2)
nine: Int = scale(1, 1)
doubled: Int = double(21)
size: Int = area(3, 4)
kind: String = describe(0)
picked: String = pick(true)
inner: Int = nested(11, true)
folded: Int = mixed(0 - 5)
bounded: Int = clamp(99, 10)
print(four, nine, doubled, size)
print(kind, picked, inner, folded, bounded)
