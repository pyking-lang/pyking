def factorial(n:Int, acc:Int) -> Int:
    loop (n, acc): (Int, Int) = (n, acc):
        if n == 0:
            return acc
        else:
            (n - 1, n * acc)
print(factorial(10, 1))
print(factorial(0, 1))
def marked(n:Int, step:Int, marks:String) -> String:
    loop (n, step, marks): (Int, Int, String) = (n, step, marks):
        if n <= 0:
            return marks
        else:
            (n - step, step, marks + '*')
print(marked(9, 2, ''))
print(marked(0, 1, '|'))
