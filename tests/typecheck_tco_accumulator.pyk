# Tail recursion that carries an accumulator, which is the commonest
# shape there is -- and the one that decides how a loop is typed.
#
# The loop carries both parameters, as one accumulator of two values,
# and every way out of it is a `return` giving the running total -- the
# loop is the whole body of the function, so leaving the loop and
# leaving the function are one act (docs/optimization.md). Without that,
# an accumulator-passing function would have to answer with the tuple
# the loop carries.

def factorial(n: Int, acc: Int) -> Int:
    if n == 0:
        acc
    else:
        factorial(n - 1, n * acc)


print(factorial(10, 1))
print(factorial(0, 1))


# Three values carried at once, and a `return` of a different type
# again: the loop carries (Int, Int, String) and each of its exits
# returns a String.
def marked(n: Int, step: Int, marks: String) -> String:
    if n <= 0:
        marks
    else:
        marked(n - step, step, marks ++ "*")


print(marked(9, 2, ""))
print(marked(0, 1, "|"))
