def climb(x:Int) -> Int:
    loop x: Int = x:
        if x >= 300:
            return 1000 + x
        else:
            x + 1
print(climb(0))
def first_over(limit:Int) -> Int:
    loop limit: Int = limit:
        if limit == 0:
            return 0
        if limit > 100:
            return limit
        limit * 2 + 1
print(first_over(3))
print(first_over(0))
