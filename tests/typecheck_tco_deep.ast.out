def climb(x:Int) -> Int:
    loop x: Int = x:
        if x >= 20000:
            break 1000 + x
        else:
            x + 1
print(climb(0))
def tail_group2(state:Int, n:Int) -> Bool:
    loop (state, n): (Int, Int) = (state, n):
        if state == 0:
            if n == 0:
                break true
            else:
                (1, n - 1)
        else if n == 0:
            break false
        else:
            (0, n - 1)
def is_even(n:Int) -> Bool = tail_group2(0, n)
def is_odd(n:Int) -> Bool = tail_group2(1, n)
print(is_even(20000), is_odd(20001))
