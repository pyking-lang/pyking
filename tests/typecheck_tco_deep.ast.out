def climb(x:Int) -> Int:
    loop x: Int = x:
        if x >= 20000:
            break 1000 + x
        else:
            x + 1
print(climb(0))
def tail_group2(state:Int, n:Int) -> Bool:
    loop (state, n): (Int, Int) = (state, n):
        if state == 0:
            if n == 0:
                break true
            else:
                (1, n - 1)
        else if n == 0:
            break false
        else:
            (0, n - 1)
def is_even(n:Int) -> Bool:
    tail_group2(0, n)
def is_odd(n:Int) -> Bool:
    tail_group2(1, n)
print(is_even(20000), is_odd(20001))
def tail_group3(state:Int, n:Int, step:Int) -> Int:
    loop (state, n, step): (Int, Int, Int) = (state, n, step):
        if state == 0:
            if n == 0:
                break 0
            else:
                (1, n, 1)
        else if n == 0:
            break 1
        else:
            (0, n - step, step)
def count_down(n:Int) -> Int:
    tail_group3(0, n, 0)
def count_by(n:Int, step:Int) -> Int:
    tail_group3(1, n, step)
print(count_down(20000), count_by(20000, 1))
