def tail_group1(state:Int, n:Int) -> Bool:
    loop (state, n): (Int, Int) = (state, n):
        if state == 0:
            if n == 0:
                return true
            else:
                (1, n - 1)
        else if n == 0:
            return false
        else:
            (0, n - 1)
def is_even(n:Int) -> Bool:
    tail_group1(0, n)
def is_odd(n:Int) -> Bool:
    tail_group1(1, n)
print(is_even(10), is_odd(10))
print(is_even(101), is_odd(101))
def tail_group2(state:Int, n:Int) -> String:
    loop (state, n): (Int, Int) = (state, n):
        if state == 0:
            if n < 1:
                return 'done'
            else:
                (1, n - 1)
        else if state == 1:
            (2, n)
        else:
            (0, n)
def step_one(n:Int) -> String:
    tail_group2(0, n)
def step_two(n:Int) -> String:
    tail_group2(1, n)
def step_three(n:Int) -> String:
    tail_group2(2, n)
print(step_one(4))
print(step_two(2))
