# Mutual recursion, and the one loop it becomes.
#
# Neither function calls itself, so neither can be a loop on its own --
# but between them they go round, and every call is a tail call. The
# pass merges the group into one worker carrying a `state` saying whose
# body is running, and leaves each original as a one-line wrapper that
# starts the worker in its own state. The `.notail.ast.out` beside this
# file is the program as written.

def is_even(n: Int) -> Bool:
    if n == 0:
        true
    else:
        is_odd(n - 1)


def is_odd(n: Int) -> Bool:
    if n == 0:
        false
    else:
        is_even(n - 1)


print(is_even(10), is_odd(10))
print(is_even(101), is_odd(101))


# A three-way cycle, which needs nothing new: the state simply has three
# values. `step_two` passes its argument along untouched, so it also
# shows a body that is nothing but a tail call.
def step_one(n: Int) -> String:
    if n < 1:
        "done"
    else:
        step_two(n - 1)


def step_two(n: Int) -> String:
    step_three(n)


def step_three(n: Int) -> String:
    step_one(n)


print(step_one(4))
print(step_two(2))
