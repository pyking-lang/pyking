def factorial(n:Int) -> Int:
    if n < 2:
        1
    else:
        n * factorial(n - 1)
print(factorial(6))
def gcd(a:Int, b:Int) -> Int:
    loop (a, b): (Int, Int) = (a, b):
        if b == 0:
            break a
        else if a > b:
            (a - b, b)
        else:
            (a, b - a)
print(gcd(12, 18))
print(gcd(7, 1))
def countdown(n:Int) -> Int:
    loop n: Int = n:
        if n == 0:
            break 0
        else:
            n - 1
print(countdown(500))
def outer(n:Int) -> Int:
    def inner(k:Int) -> Int:
        loop k: Int = k:
            if k > 20:
                break k
            else:
                k + k + 1
    inner(n) + 1
print(outer(1))
def only_two(a:Int, b:Int) -> Int:
    loop (a, b): (Int, Int) = (a, b):
        if a == 0:
            break b
        else:
            (a - 1, b + a)
print(only_two(4, 0))
