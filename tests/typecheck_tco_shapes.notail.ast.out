def factorial(n:Int) -> Int:
    if n < 2:
        1
    else:
        n * factorial(n - 1)
print(factorial(6))
def gcd(a:Int, b:Int) -> Int:
    if b == 0:
        a
    else if a > b:
        gcd(a - b, b)
    else:
        gcd(a, b - a)
print(gcd(12, 18))
print(gcd(7, 1))
def countdown(n:Int) -> Int:
    if n == 0 then 0 else countdown(n - 1)
print(countdown(500))
def outer(n:Int) -> Int:
    def inner(k:Int) -> Int:
        if k > 20:
            k
        else:
            inner(k + k + 1)
    inner(n) + 1
print(outer(1))
def only_two(a:Int, b:Int) -> Int:
    if a == 0:
        b
    else:
        only_two(a - 1, b + a)
print(only_two(4, 0))
