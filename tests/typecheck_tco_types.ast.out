def spell(n:Int) -> String:
    loop n: Int = n:
        if n <= 0:
            return 'zero'
        else if n == 1:
            return 'one'
        else:
            n - 2
print(spell(9))
print(spell(8))
def all_marked(n:Int, marks:String) -> Bool:
    loop (n, marks): (Int, String) = (n, marks):
        if n == 0:
            return marks == ''
        else:
            (n - 1, marks + '*')
print(all_marked(0, ''))
print(all_marked(3, ''))
def counts_down(n:Int, seen:String) -> Bool:
    loop (n, seen): (Int, String) = (n, seen):
        if n == 0:
            return seen == ''
        (n - 1, seen + '*')
print(counts_down(0, ''))
print(counts_down(4, ''))
