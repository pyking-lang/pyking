def spell(n:Int) -> String:
    if n <= 0:
        "zero"
    else if n == 1:
        "one"
    else:
        spell(n - 2)
print(spell(9))
print(spell(8))
def all_marked(n:Int, marks:String) -> Bool:
    if n == 0:
        marks == ""
    else:
        all_marked(n - 1, marks + "*")
print(all_marked(0, ""))
print(all_marked(3, ""))
def counts_down(n:Int, seen:String) -> Bool:
    if n == 0:
        return seen == ""
    return counts_down(n - 1, seen + "*")
print(counts_down(0, ""))
print(counts_down(4, ""))
