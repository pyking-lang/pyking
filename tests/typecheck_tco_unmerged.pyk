# A mutually recursive group the pass leaves exactly as it found it.
#
# Merging a group means giving its functions one accumulator between
# them, and that only works when they agree on how many values they
# take. These two do not -- `ping` takes one argument and `pong` takes
# two -- so there is no one loop to build, and the pass leaves the
# recursion alone rather than rewriting it into something else.
#
# The `.ast.out` and `.notail.ast.out` beside this file are therefore
# the same program twice, which is exactly what is being pinned.

def ping(n: Int) -> Int:
    if n == 0:
        0
    else:
        pong(n - 1, 2)


def pong(n: Int, step: Int) -> Int:
    if n == 0:
        1
    else:
        ping(n - step)


print(ping(6), ping(0))
print(pong(6, 3), pong(0, 1))
