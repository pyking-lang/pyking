use mutation
var a = 1
var b = 2
(a__new, b__new): (Int, Int) = (b, a)
a := a__new
b := b__new
print(a, b)
var x = 0
var y = 0
var z = 0
(x__new, (y__new, z__new)): (Int, (Int, Int)) = (10, (20, 30))
x := x__new
y := y__new
z := z__new
print(x, y, z)
def divmod(n:Int, d:Int) -> (Int, Int):
    (n / d, n % d)
var q = 0
var r = 0
(q__new, r__new): (Int, Int) = divmod(17, 5)
q := q__new
r := r__new
print(q, r)
def fib(n:Int) -> Int:
    var p = 0
    var s = 1
    var i = 0
    while i < n:
        (p__new, s__new): (Int, Int) = (s, p + s)
        p := p__new
        s := s__new
        i += 1
    p
print(fib(10), fib(20))
def noisy(v:Int) -> Int:
    print("evaluating", v)
    v
(x__new, y__new): (Int, Int) = (noisy(x + 1), noisy(x + 2))
x := x__new
y := y__new
print(x, y)
(a__new, b__new): (Int, Int) = (b, a)
a := a__new
b := b__new
(a__new, b__new): (Int, Int) = (a * 10, b * 10)
a := a__new
b := b__new
print(a, b)
