# A 'var' whose starting list is empty says what it holds by the type
# written on it, rather than by a binding made first to start from.
use mutation

var best: [Int] = []
for k in [3, 1, 4, 1, 5]:
    if k > 2:
        best := best + [k]
var names: [String] := []
names := ["a", "b"]
print(best, names, len(best))
