# Mutable structs under the type checker. A `var struct` is a type of its
# own whose fields `:=` and the compound operators write, with a value of
# the field's type; a generic one is one type, fixed by its first use;
# `same` asks whether two are one. The `.ast.out` pins the types worked
# out, and the printed program declares it `var struct` again.

use mutation

var struct Account(owner: String, balance: Int = 0)
var struct Cell(value: a)

acct = Account("ada")
acct.balance += 100
acct.owner := acct.owner + " l."


def deposit(a: Account, amount: Int) -> Int:
    a.balance += amount
    a.balance


cell = Cell(1.5)
cell.value *= 2.0
names = Cell([])
names.value := ["x"]
print(acct, deposit(acct, 5), cell, names, same(acct, acct))
