def classify(n:Int) -> String:
    match n:
        case 0: "zero"
        case _: "nonzero"


def make_pairs(xs:[Int]) -> [(Int, Int)]:
    return loop out = [] for x in xs:
        out ++ [(x, x * 10)]


def summarize(matrix:[[Int]], label:String) -> (String, Int):
    var total = 0
    for row in matrix:
        for x in row:
            total := total + x
    return label, total


def report(data:(String, [Int], Bool)) -> String:
    (name, numbers, flag) = data
    return "ok: " ++ name ++ " " ++ string(numbers) ++ " " ++ string(flag)


print(classify(0))
print(classify(5))
print(make_pairs([1, 2, 3]))
print(summarize([[1, 2], [3, 4]], "grid"))
print(report(("done", [1, 2], true)))
