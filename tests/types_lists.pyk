def sum_list(xs:[Int]) -> Int:
    var total = 0
    for x in xs:
        total := total + x
    return total


def join_all(words:[String]) -> String:
    return loop text = "" for w in words:
        continue text ++ w


def flatten(rows:[[Int]]) -> [Int]:
    return loop out = [] for row in rows:
        added =
        loop inner = out for x in row:
            continue inner ++ [x]
        continue added


print(sum_list([1, 2, 3, 4]))
print(join_all(["py", "king"]))
print(flatten([[1, 2], [3], [4, 5, 6]]))
