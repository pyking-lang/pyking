# Every shape of tuple type -- 0, 1, 2 and 4 elements, and one nested
# inside another -- written as an annotation, passed a value of that
# shape, and destructured.
#
# A one-element tuple type `(Int)` is a genuine one-tuple, not `Int`
# with brackets round it: the type grammar has no parenthesization for
# grouping, and `(1,)` is a value that needs a type to be written for
# it. That is also what the `pyking` target prints for such a value, so
# reading `(Int)` any other way would leave that output unparsable.

def describe_pair(p:(Int, Bool)) -> String:
    a, b = p
    return "pair " ++ str(a) ++ " " ++ str(b)


def describe_single(p:(Int)) -> String:
    (a,) = p
    return "single " ++ str(a)


def describe_wide(w:(Int, String, Int, (Bool, Bool))) -> String:
    a, b, c, d = w
    e, f = d
    return "wide " ++ str(a) ++ b ++ str(c) ++ str(e) ++ str(f)


def announce(label:String) -> ():
    print(label)


def make_report() -> (String, Int):
    return "ok", 3


print(describe_pair((1, true)))
print(describe_single((1,)))
announce("unit")
print(describe_wide((1, "x", 2, (true, false))))
print(make_report())
