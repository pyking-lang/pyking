# Every shape of tuple type -- 0, 1, 2 and 4 elements, and one nested
# inside another -- written as an annotation, passed a value of that
# shape, and destructured.
#
# A one-element tuple type is written `(Int,)`, with the comma the
# singleton value `(1,)` is written with -- one spelling per shape, and
# the same rule in both places. `(Int)` is grouping, as `(1)` is among
# values. types_singleton_tuple.pyk is the file that pins the pair of
# them against each other.

def describe_pair(p:(Int, Bool)) -> String:
    a, b = p
    return "pair " ++ string(a) ++ " " ++ string(b)


def describe_single(p:(Int,)) -> String:
    (a,) = p
    return "single " ++ string(a)


def describe_wide(w:(Int, String, Int, (Bool, Bool))) -> String:
    a, b, c, d = w
    e, f = d
    return "wide " ++ string(a) ++ b ++ string(c) ++ string(e) ++ string(f)


def announce(label:String) -> ():
    print(label)


def make_report() -> (String, Int):
    return "ok", 3


print(describe_pair((1, true)))
print(describe_single((1,)))
announce("unit")
print(describe_wide((1, "x", 2, (true, false))))
print(make_report())
