# Unit, `()`, reached every way a program can reach it. Every backend
# prints it the same: `()`, never the host language's own name for
# "no value" (Python's None, JavaScript's undefined).

# The literal.
u = ()
print(u)
print(())

# A function whose tail is a `print`: `print` yields unit, so the
# function does too.
def announce(n):
    print("n =", n)


print(announce(1))

# A function whose tail is a loop -- a loop produces no value.
def sum_to(n):
    var total = 0
    for i in range(n):
        total := total + i


print(sum_to(4))

# A function whose tail is a binding, likewise.
def just_binds(n):
    doubled = n * 2


print(just_binds(3))

# An `if` with no `else` supplies unit whatever its one branch ends in:
# a path runs no branch at all, so there is no value the statement can
# be counted on for (PYKING.md, "Type checking").
def only_when_positive(n):
    if n > 0:
        "positive"


print(only_when_positive(1), only_when_positive(-1))

# Unit flows through a binding like any other value.
nothing = announce(2)
print(nothing)

# `print` itself yields unit, so a `print` call is a value like any
# other -- not merely a statement. A host whose own print answers
# something else (Python's None) has to be made to agree here.
straight = print("bound")
print(straight)
print(print("nested"))

# And inside a structure, where the host's answer would show up beside
# ordinary values rather than on its own.
print((print("in a tuple"), 1))
print([print("in a list")])

# Unit inside a data structure keeps its own spelling.
print([(), ()])
print((1, ()))

# A function that *does* return on every path gets no unit anywhere.
def sign(n):
    if n < 0:
        "negative"
    else:
        "not negative"


print(sign(-1), sign(1))
