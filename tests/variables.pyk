x = "test"

# A second `=` binds a fresh name that shadows the first. Both are
# immutable, and nothing forces the two to have the same type -- a
# binding is not an update.
x = 4

# Changing a name from inside a loop body *is* an update, so the name is
# declared mutable and updated with `:=`. An `=` there would bind a new
# name local to the body, leaving this one untouched.
var greeting = "start"
for i in range(1):
    greeting := "hi"

print(x, greeting)
