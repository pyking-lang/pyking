x = "test"

# A second `=` binds a fresh name that shadows the first. Both are
# immutable, and nothing forces the two to have the same type -- a
# binding is not an update.
x = 4

# Changing a name from inside a block *is* an update, so the name is
# declared mutable and updated with `:=`. An `=` there would bind a new
# name local to the block, leaving this one untouched.
var greeting = "start"
var done = false
while done == false:
    greeting := "hi"
    done := true

print(x, greeting)
