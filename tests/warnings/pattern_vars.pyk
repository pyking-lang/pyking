# pyk: -Wunused-pattern-var
# -Wunused-pattern-var reports a name a `case` pattern binds that its arm
# never uses -- in a tuple, a list, a constructor, behind `as` -- unless
# it starts with `_`.

datatype Shape:
    Circle(r: Int)
    Rect(w: Int, h: Int)

def describe(s: Shape) -> String:
    match s:
        case Circle(r):
            return "circle"
        case Rect(w, h) as whole:
            return "rect " + string(w)

def head(xs: [Int]) -> Int:
    match xs:
        case [x, ..rest]:
            return x
        case []:
            return 0

def swap(p: (Int, Int)) -> Int:
    match p:
        case (_a, b):
            return b

print(describe(Circle(1)), describe(Rect(2, 3)), head([4, 5]), swap((6, 7)))
