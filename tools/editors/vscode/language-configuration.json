{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[^#]*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*[^#]*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*|-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?"
}
