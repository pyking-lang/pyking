{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pyking",
  "scopeName": "source.pyking",
  "fileTypes": ["pyk"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-double" },
    { "include": "#char" },
    { "include": "#definition" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#builtin" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.pyking",
      "match": "#.*$"
    },
    "string-double": {
      "name": "string.quoted.double.pyking",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [{ "include": "#escape" }]
    },
    "char": {
      "patterns": [
        {
          "name": "constant.character.pyking",
          "match": "'(?:\\\\[ntr0\\\\'\"]|[^'\\\\])'"
        },
        {
          "name": "invalid.illegal.char.pyking",
          "match": "'[^']*'?"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.pyking",
          "match": "\\\\[ntr0\\\\'\"]"
        },
        {
          "name": "invalid.illegal.escape.pyking",
          "match": "\\\\."
        }
      ]
    },
    "definition": {
      "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.pyking" },
        "2": { "name": "entity.name.function.pyking" }
      }
    },
    "keyword": {
      "name": "keyword.control.pyking",
      "match": "\\b(for|in|if|while|loop|break|continue|then|let|else|var|def|return|match|case|public|implicit|import|from|as|datatype|struct|use|lam|and|or|not|xor|class|interface|extends|self|super)\\b"
    },
    "type": {
      "name": "support.type.pyking",
      "match": "\\b(Int|Float|String|Char|Bool)\\b"
    },
    "constant": {
      "name": "constant.language.pyking",
      "match": "\\b(true|false)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.pyking",
      "match": "(?<![.:])\\b(print|debug|range|string|len|int|float|bool|char)\\b(?=\\s*\\()"
    },
    "number": {
      "name": "constant.numeric.pyking",
      "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.pyking",
          "match": ":=|=(?![=>])"
        },
        {
          "name": "keyword.operator.pyking",
          "match": "->|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||[-+*/%^&|~!<>]"
        }
      ]
    }
  }
}
