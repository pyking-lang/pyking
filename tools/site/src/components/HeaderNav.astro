---
// The header's menu: the site's five sections, beside the logo
// (Header.astro).
import { SECTIONS } from "../sections.mjs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname;
---
<nav class="pyking-nav" aria-label="Sections">
  {SECTIONS.map(({ label, path, prefix }) => (
    <a href={base + path} aria-current={here.startsWith(base + prefix) ? "page" : undefined}>{label}</a>
  ))}
</nav>
